// pour ça que chacun a ses propres coches désormais.
//=====================================================================
gSD = "8. Supply / Demand (indépendant)"
showDemand = input.bool(false, "Afficher les zones DEMAND", group=gSD)
showSupply = input.bool(false, "Afficher les zones SUPPLY", group=gSD)
maxZones   = input.int(3, "Zones max par type", minval=1, maxval=10, group=gSD)

//=====================================================================
