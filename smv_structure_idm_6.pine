//=====================================================================
// Filtre de signal — structure robuste + confluence
//
// Les réglages sont ici, avec le reste du moteur d'entrée ; le calcul
// lui-même reste dans le module 15, plus bas, là où les zones qu'il
// compte existent déjà.
//=====================================================================
gCf = "07. Filtre de signal — structure + confluence"
smvUseFilter = input.bool(true, "Filtrer les entrées (structure + confluence)", group=gCf,
     tooltip="Décoché, les deux moteurs d'entrée redeviennent exactement ce qu'ils étaient. Coché (recommandé), une entrée doit respecter la structure ET réunir assez de confluence.")
smvMinConf = input.int(1, "Éléments SMV minimum sur le point d'entrée", minval=0, maxval=7, group=gCf,
     tooltip="Combien d'éléments de la méthode doivent être présents là où le prix entre : Order Block, imbalance, zone Supply/Demand, phase Wyckoff (SPRING/STB à l'achat, UTAD/UT à la vente), 0.5 du mouvement validé, IDM 3, et LA SIGNATURE. 1 (défaut) = l'entrée doit avoir AU MOINS UNE raison concrète — un seul élément suffit. 2 ou 3 = tu attends que plusieurs se retrouvent au même endroit, plus rare mais plus solide. 0 = aucune exigence, seule la structure filtre.")
smvPhaseBars = input.int(20, "Fraîcheur d'une phase Wyckoff (bougies)", minval=1, maxval=200, group=gCf,
     tooltip="Un SPRING, STB, UTAD ou UT ne compte comme confluence que s'il s'est formé il y a moins de N bougies.")

//=====================================================================
// 3. Sniper Zone — LE reteste précis, rattachée UNIQUEMENT à l'IDM.
// Préparée dès la formation de l'IDM, affinée sur la bougie exacte de
// récupération ("chandelier qui prend l'argent"), supprimée dès que le
// prix part pour de bon.
//=====================================================================
gSn = "08. Sniper Zone (liée à l'IDM)"
showSniperZone = input.bool(true, "Afficher la Sniper Zone", group=gSn,
     tooltip="Bande fine préparée à l'IDM — visible seulement en attente, supprimée dès que le prix part pour le vrai mouvement.")
sniperSize = input.float(0.12, "Épaisseur avant liquidation (x ATR)", minval=0.02, maxval=0.5, step=0.02, group=gSn,
     tooltip="Bande fine autour de l'IDM, préparée dès sa formation.")
sniperCol  = input.color(#ffd54f, "Couleur Sniper Zone", group=gSn)
showSniperRefine = input.bool(true, "Afficher LA SIGNATURE (mèche de la bougie qui prend l'argent)", group=gSn,
     tooltip="Dès que l'IDM est balayé, la zone n'est plus une bande ATR calculée : elle est posée sur la MÈCHE RÉELLE de la bougie qui est allée chercher la liquidité au-delà de l'IDM. C'est la vraie zone de Demand (achat) / Supply (vente) — plus précise qu'un Order Block. Concept BIS respecté : la zone d'achat reste sous l'IDBL, la zone de vente au-dessus de l'IDBR.")
refineCol = input.color(#26c6da, "Couleur de la Signature", group=gSn)

//=====================================================================
// 4. Phases — repères Wyckoff SC/STB/SPRING/BC/UT/UTAD, purement
