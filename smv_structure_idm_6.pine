//@version=6
indicator("SMV STRUCTURE — Moteur fractal (BOS/CHoCH/IDM)", "SMV Engine", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

//=====================================================================
// MOTEUR DE CALCUL vs AFFICHAGE
//
// Le calcul (structure, BOS, CHoCH, mouvement, 0.5, IDM, récupération,
// phases) tourne TOUJOURS, quel que soit l'état des réglages
// d'affichage. Chaque module d'affichage (BOS/CHoCH, IDM, Zone à
// retester, Sniper Zone, Supply/Demand, FVG, Phases, Sessions,
// Dashboard) ne fait que LIRE cet état pour dessiner — désactiver un
// module n'affecte jamais le calcul d'un autre, ni même son propre
// calcul interne.
//
// L'IDM reste TOUJOURS l'élément central de l'indicateur — tout le
// reste n'est qu'une lecture de son état. La Sniper Zone (Module 4
// SMV, "chandelier qui prend l'argent") est rattachée UNIQUEMENT à
// l'IDM, jamais à Supply/Demand qui reste un module 100% indépendant.
// Elle est préparée dès la formation de l'IDM, visible seulement le
// temps qu'elle est en attente, et supprimée immédiatement dès que le
// prix la liquide pour lancer le vrai mouvement — jamais affichée
// après coup.
//
// Logique fractale : tout repose sur un zigzag structurel auto-calibré
// sur l'ATR (voir section PIVOTS), sans aucune référence à une unité de
// temps fixe ni le moindre réglage de sensibilité — la même mécanique
// s'applique identiquement en 1m comme en Monthly, le seuil de
// confirmation s'adapte tout seul à la volatilité du moment.
//
// BOS = extremum courant, pas juste le dernier pivot : tant que la
// structure est haussière, bosHigh reste ancré sur le plus haut HH
// rencontré (ne redescend jamais) ; tant qu'elle est baissière, bosLow
// reste ancré sur le plus bas LL (ne remonte jamais). Le CHoCH reste
// basé sur le dernier pivot opposé — dès qu'il casse, le biais change
// et l'ancrage repart sur la nouvelle structure.
//
// Fenêtre d'analyse par timeframe (inLookback, voir plus bas) : chaque
// timeframe n'analyse que sa propre fenêtre récente (Monthly 4 ans,
// Weekly 2 ans, Daily 6 mois, 4H 25 jours, 1H 8 jours, M15/M5 12h) —
// jamais de contamination d'un timeframe par un autre.
//=====================================================================

//=====================================================================
// 1. Structure
//=====================================================================
gS = "1. Structure"
showStruct   = input.bool(true, "Afficher HH / HL / LH / LL", group=gS,
     tooltip="C'est le seul marquage qui apparaît dès qu'un swing structurel est confirmé, sans attendre de BOS/CHoCH ni de phase — la façon la plus rapide de voir un HL/LH se former. Aucun réglage de sensibilité : la détection des swings est 100% automatique (zigzag calibré sur l'ATR, voir plus bas).")
bullCol      = input.color(#26a69a, "Couleur haussière", group=gS)
bearCol      = input.color(#ef5350, "Couleur baissière", group=gS)
rangeCol     = input.color(#9e9e9e, "Couleur consolidation", group=gS)

//=====================================================================
// 2. BOS / CHoCH — chaque type de cassure a sa propre coche
//=====================================================================
gB = "2. BOS / CHoCH"
showBOSBull   = input.bool(true, "Afficher les BOS haussiers", group=gB)
showBOSBear   = input.bool(true, "Afficher les BOS baissiers", group=gB)
showCHoCHBull = input.bool(true, "Afficher les CHoCH haussiers", group=gB)
showCHoCHBear = input.bool(true, "Afficher les CHoCH baissiers", group=gB)
bosBullCol    = input.color(#26a69a, "Couleur BOS haussier", group=gB)
bosBearCol    = input.color(#ef5350, "Couleur BOS baissier", group=gB)
chochCol      = input.color(#ffeb3b, "Couleur CHoCH", group=gB)
maxBosHistory = input.int(150, "Nombre max de BOS/CHoCH historiques", minval=20, maxval=400, group=gB)

//=====================================================================
// 3. IDM (Inducement) — lignes/étiquettes d'attente séparées du
// signal d'entrée : tu peux garder l'un sans l'autre.
//=====================================================================
gI = "3. IDM (Inducement) — LE plus important"
showIdmLines  = input.bool(true, "Afficher les 2 IDM actifs (lignes + étiquettes)", group=gI,
     tooltip="Les deux IDM les plus récents — ceux qui comptent vraiment pour trader. Toujours prioritaires sur tout le reste de l'indicateur.")
showFsHistory = input.bool(false, "Afficher l'historique FS (anciens IDM figés)", group=gI,
     tooltip="Décoché par défaut pour garder le graphique lisible. Une fois décoché, les anciens IDM (devenus FS) sont simplement supprimés dès qu'ils sortent du top 2, au lieu de rester affichés en grisé.")
showIdmEntry  = input.bool(false, "Afficher l'étiquette ENTRÉE ACHAT/VENTE (récupération IDM)", group=gI,
     tooltip="Décoché par défaut. Le signal reste calculé et déclenche toujours les alertes — seule l'étiquette texte sur le graphique est masquée.")
idmActiveCol = input.color(#ab47bc, "IDM #1 — le plus récent (vrai signal à venir)", group=gI)
idmWaitCol   = input.color(#ff9800, "IDM #2 — juste avant", group=gI)
fsCol        = input.color(#9e9e9e, "FS (historique, plus ancien)", group=gI)
idmDoneCol   = input.color(#26c6da, "Marqueur \"retesté\"", group=gI)
entryBuyCol  = input.color(#00e676, "Couleur entrée ACHAT", group=gI)
entrySellCol = input.color(#ff1744, "Couleur entrée VENTE", group=gI)
maxHistory   = input.int(100, "Nombre max d'IDM historiques", minval=10, maxval=200, group=gI)

//=====================================================================
// 4. Zone à retester (entrée) — large, autour de l'IDM
//=====================================================================
gZ = "4. Zone à retester"
showIdmZone = input.bool(true, "Afficher les zones à retester", group=gZ,
     tooltip="Haussier -> zone EN DESSOUS de l'IDM (IDBL). Baissier -> zone AU-DESSUS (IDBR). Une zone par IDM.")
idmZoneSize = input.float(0.5, "Épaisseur de la zone (x ATR)", minval=0.1, maxval=3.0, step=0.1, group=gZ)
idmZoneExt  = input.int(15, "Prolongement de la zone (bougies)", minval=3, maxval=60, group=gZ)

//=====================================================================
// 5. Sniper Zone — dissociée de la Zone à retester ET de Supply/Demand
//
// Rattachée UNIQUEMENT à l'IDM (au lieu d'une zone de "signature"
// séparée), comme demandé : c'est à/après l'IDM que se trouve
// l'entrée de précision, pas ailleurs. Préparée dès la formation de
// l'IDM (avant même que le prix y revienne) pour les 2 IDM actifs, et
// SUPPRIMÉE IMMÉDIATEMENT dès que le prix la liquide pour de bon —
// visible uniquement au moment adéquat, jamais après.
//=====================================================================
gSn = "5. Sniper Zone (liée à l'IDM)"
showSniperZone = input.bool(true, "Afficher la Sniper Zone", group=gSn,
     tooltip="Bande fine préparée à l'IDM, bien plus précise que la Zone à retester — visible seulement en attente, supprimée dès que le prix part pour le vrai mouvement.")
sniperSize = input.float(0.12, "Épaisseur avant liquidation (x ATR)", minval=0.02, maxval=0.5, step=0.02, group=gSn,
     tooltip="Bande fine autour de l'IDM, préparée dès sa formation — bien plus étroite que la Zone à retester.")
sniperCol  = input.color(#ffd54f, "Couleur Sniper Zone", group=gSn)

//=====================================================================
// 6. Premium / Discount (0.5)
//=====================================================================
gPd = "6. Premium / Discount (0.5)"
showPd = input.bool(true, "Afficher le niveau 0.5 du mouvement", group=gPd)
pdCol  = input.color(#90a4ae, "Couleur du 0.5", group=gPd)

//=====================================================================
// 7. FVG (Fair Value Gap)
//=====================================================================
gF = "7. FVG"
showFvgBull = input.bool(false, "Afficher les FVG haussiers", group=gF)
showFvgBear = input.bool(false, "Afficher les FVG baissiers", group=gF)
fvgBullCol  = input.color(#26a69a, "Couleur FVG haussier", group=gF)
fvgBearCol  = input.color(#ef5350, "Couleur FVG baissier", group=gF)
maxFvg      = input.int(50, "FVG max affichés", minval=5, maxval=100, group=gF)

//=====================================================================
// 8. Supply / Demand — module indépendant, dissocié de la Sniper Zone
//
// Détection simple, autonome : la dernière bougie opposée après un
// BOS. Aucun lien avec l'IDM ni avec la Sniper Zone — c'est exactement
// pour ça que chacun a ses propres coches désormais.
//=====================================================================
gSD = "8. Supply / Demand (indépendant)"
showDemand = input.bool(false, "Afficher les zones DEMAND", group=gSD)
showSupply = input.bool(false, "Afficher les zones SUPPLY", group=gSD)
maxZones   = input.int(3, "Zones max par type", minval=1, maxval=10, group=gSD)

//=====================================================================
// 9. Phases — 4 commandes indépendantes : le rectangle, les repères
// SC/STB/SPRING/BC/UT/UTAD (regroupés sous une seule coche), la zone
// d'intervention et le signal d'entrée. Décoche ce que tu ne veux pas
// voir, chaque brique reste indépendante des autres.
//=====================================================================
gPh = "9. Phases"
showPhaseBox     = input.bool(true, "Afficher le rectangle Accumulation/Distribution", group=gPh)
showPhaseMarkers = input.bool(true, "Afficher SC / STB / SPRING / BC / UT / UTAD", group=gPh)
showPhaseZone    = input.bool(true, "Afficher la zone d'intervention de la phase", group=gPh)
showPhaseEntry   = input.bool(false, "Afficher l'étiquette ENTRÉE ACHAT/VENTE (phase)", group=gPh)
phaseCol         = input.color(#ffa726, "Couleur manipulations (STB/SPRING/UT/UTAD)", group=gPh)

//=====================================================================
// 10. Dashboard
//=====================================================================
gD = "10. Dashboard"
showDash     = input.bool(true, "Afficher le tableau de bord", group=gD)
dashLabelCol = input.color(#b0bec5, "Couleur des libellés", group=gD)
dashValueCol = input.color(#ffffff, "Couleur des valeurs neutres", group=gD)
dashBgCol    = input.color(color.new(#101418, 15), "Fond des cellules", group=gD)
dashTitleBg  = input.color(#0d47a1, "Fond du titre", group=gD)

//=====================================================================
// 11. Heures de Tirs (Sessions) — purement visuel, n'affecte aucun
// calcul. Horaires enseignés dans le Module 7 (heure de Paris).
//=====================================================================
gSess = "11. Heures de Tirs (Sessions)"
showSessions = input.bool(true, "Afficher les sessions (Asian / NYC)", group=gSess,
     tooltip="Surligne les heures de tirs SMV : Asian 1h-3h, Asian 8h-10h et NYC 13h-16h (heure de Paris). N'affecte jamais le moteur de calcul.")
asianCol = input.color(color.new(#42a5f5, 85), "Couleur session Asian", group=gSess)
nyCol    = input.color(color.new(#ffa726, 85), "Couleur session NYC", group=gSess)

//=====================================================================
// 12. Zones de Liquidité (Intact) — le High/Low le plus récent PAS
// ENCORE balayé par le prix (Module 2 SMV : Intact Buyers/Sellers).
// C'est la liquidité que l'algo doit aller chercher avant de pouvoir
// relancer un mouvement. Simple lecture de bosHigh/bosLow (déjà
// calculés par le moteur), aucune influence dessus.
//=====================================================================
gIL = "12. Zones de Liquidité (Intact)"
showIntact = input.bool(true, "Afficher les niveaux Intact (High/Low en attente)", group=gIL,
     tooltip="Intact Sellers (High) et Intact Buyers (Low) : le dernier sommet/creux pas encore balayé par le prix. Purement informatif, n'affecte jamais le moteur ni l'IDM.")
intactBuyCol  = input.color(#4fc3f7, "Couleur Intact Buyers (Low)", group=gIL)
intactSellCol = input.color(#ff8a65, "Couleur Intact Sellers (High)", group=gIL)


//=====================================================================
// FENÊTRE D'ANALYSE — dépend UNIQUEMENT du timeframe courant du
// graphique (jamais d'un autre timeframe, l'analyse reste strictement
// indépendante d'une unité de temps à l'autre) :
//   Monthly -> 4 dernières années        4H  -> 25 derniers jours
//   Weekly  -> 2 dernières années        1H  -> 8 derniers jours
//   Daily   -> 6 derniers mois           M15 -> 12 dernières heures
//                                        M5  -> 12 dernières heures
// Tout ce qui est avant cette fenêtre est purement ignoré par le
// moteur (pivots, structure, BOS/CHoCH, IDM) — l'analyse démarre pour
// de vrai au premier pivot rencontré à l'intérieur de la fenêtre.
//=====================================================================
f_lookbackMs() =>
    string tf = timeframe.period
    float oneDay = 24.0 * 60 * 60 * 1000
    float result =
         tf == "M"   ? 4 * 365 * oneDay :
         tf == "W"   ? 2 * 365 * oneDay :
         tf == "D"   ? 182 * oneDay :
         tf == "240" ? 25 * oneDay :
         tf == "60"  ? 8 * oneDay :
         tf == "15"  ? 0.5 * oneDay :
         tf == "5"   ? 0.5 * oneDay :
         timeframe.ismonthly ? 4 * 365 * oneDay :
         timeframe.isweekly  ? 2 * 365 * oneDay :
         timeframe.isdaily   ? 182 * oneDay :
         timeframe.isminutes and timeframe.multiplier >= 180 ? 25 * oneDay :
         timeframe.isminutes and timeframe.multiplier >= 45  ? 8 * oneDay :
         0.5 * oneDay
    result

bool inLookback = time >= (timenow - f_lookbackMs())


//=====================================================================
// PIVOTS — ZIGZAG STRUCTUREL AUTO-CALIBRÉ (moteur — toujours actif,
// dans la fenêtre d'analyse)
//
// Remplace ta.pivothigh/pivotlow à fenêtre fixe (un nombre de bougies
// à régler) par un zigzag : un nouveau swing haut n'est confirmé que
// lorsque le prix redescend d'au moins zigzagMult x ATR(14) sous
// l'extrême en formation, et symétriquement pour un swing bas. Le
// seuil s'auto-calibre à la volatilité de l'instrument et du
// timeframe — AUCUN réglage de sensibilité à toucher. Comme tout
// zigzag, un swing déjà confirmé ne change plus jamais de valeur ;
// seule l'extrémité en cours de formation reste provisoire jusqu'à son
// propre renversement.
//=====================================================================
atrZone   = ta.atr(14) * idmZoneSize
atrSniper = ta.atr(14) * sniperSize

zigzagMult = 1.5
float zigzagThresh = ta.atr(14) * zigzagMult

var int   zzDir        = 1
var float zzExtreme    = na
var int   zzExtremeBar = na

float ph = na
float pl = na
var int phBar = na
var int plBar = na

if na(zzExtreme)
    zzExtreme := high
    zzExtremeBar := bar_index

if not na(zigzagThresh)
    if zzDir == 1
        if high > zzExtreme
            zzExtreme := high
            zzExtremeBar := bar_index
        if low <= zzExtreme - zigzagThresh
            ph := zzExtreme
            phBar := zzExtremeBar
            zzDir := -1
            zzExtreme := low
            zzExtremeBar := bar_index
    else
        if low < zzExtreme
            zzExtreme := low
            zzExtremeBar := bar_index
        if high >= zzExtreme + zigzagThresh
            pl := zzExtreme
            plBar := zzExtremeBar
            zzDir := 1
            zzExtreme := high
            zzExtremeBar := bar_index

var float lastPH = na
var float prevPH = na
var int lastPHBar = na

var float lastPL = na
var float prevPL = na
var int lastPLBar = na

if not na(ph) and inLookback
    prevPH := lastPH
    lastPH := ph
    lastPHBar := phBar

    if showStruct
        string txt = na(prevPH) ? "H" : ph > prevPH ? "HH" : "LH"
        color col = na(prevPH) ? rangeCol : ph > prevPH ? bullCol : bearCol
        label.new(phBar, ph, txt,
             style=label.style_label_down,
             color=color.new(col, 80),
             textcolor=col,
             size=size.small)

if not na(pl) and inLookback
    prevPL := lastPL
    lastPL := pl
    lastPLBar := plBar

    if showStruct
        string txt = na(prevPL) ? "L" : pl > prevPL ? "HL" : "LL"
        color col = na(prevPL) ? rangeCol : pl > prevPL ? bullCol : bearCol
        label.new(plBar, pl, txt,
             style=label.style_label_up,
             color=color.new(col, 80),
             textcolor=col,
             size=size.small)


//=====================================================================
// STRUCTURE — 3 ÉTATS (moteur — toujours actif)
//   1  = BULLISH        (HH + HL)
//  -1  = BEARISH        (LH + LL)
//   0  = CONSOLIDATION  (ni l'un ni l'autre : pause du marché)
//=====================================================================
bullStruct =
     not na(lastPH) and not na(prevPH) and
     not na(lastPL) and not na(prevPL) and
     lastPH > prevPH and lastPL > prevPL

bearStruct =
     not na(lastPH) and not na(prevPH) and
     not na(lastPL) and not na(prevPL) and
     lastPH < prevPH and lastPL < prevPL

allPiv = not na(lastPH) and not na(prevPH) and not na(lastPL) and not na(prevPL)

var int bias = 0

if bullStruct
    bias := 1
else if bearStruct
    bias := -1
else if allPiv
    bias := 0


//=====================================================================
// CASSURES DE STRUCTURE — BOS / CHoCH (moteur — toujours actif)
//
//   Cassure DANS le sens de la structure   -> BOS   (continuation)
//   Cassure CONTRE le sens de la structure -> CHoCH (changement de biais)
//   Cassure en consolidation               -> BOS   (sortie de range)
//
// Le biais est recalculé à CHAQUE cassure sur la base de la structure
// à cet instant précis (pas d'un compteur qui bascule à chaque coup) —
// donc après un CHoCH, les BOS suivants sont jugés contre la NOUVELLE
// structure, et rien n'empêche une cassure valide de continuer à se
// tracer indéfiniment.
//=====================================================================
var float bosHigh = na
var int bosHighBar = na
var float bosLow = na
var int bosLowBar = na
var float brokenHigh    = na
var int   brokenHighBar = na
var float brokenLow     = na
var int   brokenLowBar  = na

// ORDRE CRITIQUE : on juge D'ABORD la cassure contre la référence
// TELLE QU'ELLE ÉTAIT AVANT cette bougie (celle de la bougie
// précédente). La référence n'est mise à jour avec le nouveau pivot
// qu'APRÈS, plus bas — jamais avant. Sinon, un pivot fraîchement
// confirmé sur cette même bougie fait "sauter" la référence en avant
// avant même que le test de cassure n'ait lieu, et avale la cassure
// qu'il était censé détecter : c'est ce qui produisait des traits
// incohérents.
bool breakUp =
     not na(bosHigh) and
     close > bosHigh and
     (na(brokenHigh) or bosHigh != brokenHigh)

bool breakDown =
     not na(bosLow) and
     close < bosLow and
     (na(brokenLow) or bosLow != brokenLow)

bool bosBull   = false
bool bosBear   = false
bool chochBull = false
bool chochBear = false

if breakUp
    if bias == -1
        chochBull := true
    else
        bosBull := true
    // On capture la valeur ET la bougie d'origine du niveau cassé
    // MAINTENANT — avant que la mise à jour plus bas ne fasse évoluer
    // bosHigh/bosHighBar vers la prochaine référence.
    brokenHigh := bosHigh
    brokenHighBar := bosHighBar

if breakDown
    if bias == 1
        chochBear := true
    else
        bosBear := true
    brokenLow := bosLow
    brokenLowBar := bosLowBar

// Le CHoCH EST la confirmation du nouveau sens : le biais bascule
// immédiatement, pour que toute cassure suivante soit jugée contre la
// structure réellement en cours.
if chochBull
    bias := 1

if chochBear
    bias := -1

// TENDANCE CONFIRMÉE — calculée ICI, AVANT la mise à jour de bosHigh/
// bosLow plus bas, car c'est elle (et non le bias brut) qui doit
// décider si on garde le plus haut HH / plus bas LL en mémoire.
// Contrairement à `bias`, qui se recalcule à chaque bougie à partir des
// 2 derniers pivots et peut retomber à 0 (consolidation) sur un simple
// pullback interne, `confirmedTrend` ne change JAMAIS sur un BOS de
// continuation ni sur une lecture de consolidation — seul un vrai CHoCH
// peut le faire basculer. C'est exactement la règle : "c'est le CHoCH
// qui confirme le changement de structure". Le tout premier BOS (avant
// tout CHoCH) établit la direction de départ. Ne touche à aucune
// variable du moteur IDM (moveDir, idmLevel, idmDir, idmDone…).
var int confirmedTrend = 0

if chochBull
    confirmedTrend := 1
if chochBear
    confirmedTrend := -1
if confirmedTrend == 0
    if bosBull
        confirmedTrend := 1
    if bosBear
        confirmedTrend := -1

// Maintenant, et SEULEMENT maintenant, on met à jour la référence pour
// la PROCHAINE bougie. Le trait du BOS part TOUJOURS du plus haut HH
// précédent tant que la TENDANCE CONFIRMÉE reste haussière — bosHigh
// est un extremum qui ne redescend JAMAIS pendant cette phase, même si
// un nouveau pivot haut plus bas se forme entre-temps (ce nouveau pivot
// est purement ignoré comme référence de BOS), et même si un pullback
// interne fait momentanément retomber `bias` à 0 : c'est exactement le
// bug corrigé ici — avant, un simple pullback faisait perdre le vrai
// plus haut HH et repartir sur un pivot plus récent mais moins
// significatif. Hors tendance confirmée haussière, bosHigh suit
// simplement le dernier pivot haut formé — c'est la référence utilisée
// pour détecter un futur CHoCH de retour à la hausse.
if not na(ph) and inLookback
    bool keepHigherRef = confirmedTrend == 1 and not na(bosHigh) and ph <= bosHigh
    if not keepHigherRef
        bosHigh := ph
        bosHighBar := phBar

// Symétrique en baissier : le trait du BOS part TOUJOURS du LL le plus
// bas tant que la tendance confirmée reste baissière — bosLow ne
// remonte JAMAIS pendant cette phase, même sur un pullback interne qui
// ferait retomber `bias` à 0. Hors tendance confirmée baissière, bosLow
// suit simplement le dernier pivot bas formé (référence de CHoCH pour
// un retour à la baisse).
if not na(pl) and inLookback
    bool keepLowerRef = confirmedTrend == -1 and not na(bosLow) and pl >= bosLow
    if not keepLowerRef
        bosLow := pl
        bosLowBar := plBar

var string lastBOS   = "-"
var string lastCHoCH = "-"

if bosBull
    lastBOS := "BOS ↑ @ " + str.tostring(brokenHigh, format.mintick)
if bosBear
    lastBOS := "BOS ↓ @ " + str.tostring(brokenLow, format.mintick)
if chochBull
    lastCHoCH := "CHoCH ↑ @ " + str.tostring(brokenHigh, format.mintick)
if chochBear
    lastCHoCH := "CHoCH ↓ @ " + str.tostring(brokenLow, format.mintick)


//=====================================================================
// AFFICHAGE — BOS / CHoCH (indépendant : ne touche à aucune variable
// de calcul, ne fait que lire bosBull/bosBear/chochBull/chochBear)
//
// Le trait part du pivot qui vient d'être cassé — brokenHigh/brokenLow
// (capturés au moment exact de la cassure, PAS bosHigh/bosLow qui ont
// déjà été remis à jour vers la prochaine référence à ce stade du
// script). Il se PROLONGE ensuite bougie après bougie tant qu'aucune
// bougie ne revient toucher ce niveau. Dès qu'une bougie touche/
// traverse le niveau, elle bloque le trait net à cet endroit — jamais
// plus loin. Pur dessin, jamais d'étiquette supplémentaire ici (le
// label existant n'est pas modifié).
//=====================================================================
var line[]  bosLineArr     = array.new_line()
var label[] bosLblArr      = array.new_label()
var float[] bosLineLevel   = array.new_float()
var bool[]  bosLineBlocked = array.new_bool()

// Prolongation / blocage des traits déjà tracés — AVANT toute création
// d'un nouveau trait sur cette bougie, pour ne jamais bloquer un trait
// tout juste créé sur sa propre bougie de cassure.
if array.size(bosLineArr) > 0
    for i = 0 to array.size(bosLineArr) - 1
        if not array.get(bosLineBlocked, i)
            float lvlChk = array.get(bosLineLevel, i)
            line lnChk = array.get(bosLineArr, i)
            if low <= lvlChk and high >= lvlChk
                array.set(bosLineBlocked, i, true)
            else
                line.set_x2(lnChk, bar_index + 1)

if showBOSBull and bosBull
    array.push(bosLineArr, line.new(brokenHighBar, brokenHigh, bar_index, brokenHigh, color=bosBullCol, width=2))
    array.push(bosLineLevel, brokenHigh)
    array.push(bosLineBlocked, false)
    array.push(bosLblArr, label.new(bar_index, brokenHigh, "BOS ↑",
         style=label.style_label_down, color=color.new(bosBullCol, 70), textcolor=bosBullCol, size=size.small))

if showBOSBear and bosBear
    array.push(bosLineArr, line.new(brokenLowBar, brokenLow, bar_index, brokenLow, color=bosBearCol, width=2))
    array.push(bosLineLevel, brokenLow)
    array.push(bosLineBlocked, false)
    array.push(bosLblArr, label.new(bar_index, brokenLow, "BOS ↓",
         style=label.style_label_up, color=color.new(bosBearCol, 70), textcolor=bosBearCol, size=size.small))

if showCHoCHBull and chochBull
    array.push(bosLineArr, line.new(brokenHighBar, brokenHigh, bar_index, brokenHigh, color=chochCol, width=2, style=line.style_dashed))
    array.push(bosLineLevel, brokenHigh)
    array.push(bosLineBlocked, false)
    array.push(bosLblArr, label.new(bar_index, brokenHigh, "CHoCH ↑",
         style=label.style_label_down, color=color.new(chochCol, 60), textcolor=color.black, size=size.small))

if showCHoCHBear and chochBear
    array.push(bosLineArr, line.new(brokenLowBar, brokenLow, bar_index, brokenLow, color=chochCol, width=2, style=line.style_dashed))
    array.push(bosLineLevel, brokenLow)
    array.push(bosLineBlocked, false)
    array.push(bosLblArr, label.new(bar_index, brokenLow, "CHoCH ↓",
         style=label.style_label_up, color=color.new(chochCol, 60), textcolor=color.black, size=size.small))

if array.size(bosLineArr) > maxBosHistory
    line.delete(array.shift(bosLineArr))
    label.delete(array.shift(bosLblArr))
    array.shift(bosLineLevel)
    array.shift(bosLineBlocked)


//=====================================================================
// AFFICHAGE — Zones de Liquidité (Intact), indépendant, lecture seule
// de bosHigh/bosLow (déjà calculés par le moteur CASSURES ci-dessus —
// aucune influence dessus). Intact Sellers = dernier High pas encore
// balayé ; Intact Buyers = dernier Low pas encore balayé. Un seul
// trait par côté, repositionné en direct bougie après bougie tant que
// le niveau ne change pas (nouvelle référence ou cassure).
//=====================================================================
var line  intactHighLine = na
var label intactHighLbl  = na
var line  intactLowLine  = na
var label intactLowLbl   = na

if showIntact
    if not na(bosHigh)
        if na(intactHighLine)
            intactHighLine := line.new(bosHighBar, bosHigh, bar_index + 1, bosHigh,
                 color=intactSellCol, style=line.style_dashed, width=1)
            intactHighLbl := label.new(bar_index + 1, bosHigh, "Intact Sellers",
                 style=label.style_label_left, color=color.new(intactSellCol, 80),
                 textcolor=intactSellCol, size=size.small)
        else
            line.set_xy1(intactHighLine, bosHighBar, bosHigh)
            line.set_xy2(intactHighLine, bar_index + 1, bosHigh)
            label.set_xy(intactHighLbl, bar_index + 1, bosHigh)
    if not na(bosLow)
        if na(intactLowLine)
            intactLowLine := line.new(bosLowBar, bosLow, bar_index + 1, bosLow,
                 color=intactBuyCol, style=line.style_dashed, width=1)
            intactLowLbl := label.new(bar_index + 1, bosLow, "Intact Buyers",
                 style=label.style_label_left, color=color.new(intactBuyCol, 80),
                 textcolor=intactBuyCol, size=size.small)
        else
            line.set_xy1(intactLowLine, bosLowBar, bosLow)
            line.set_xy2(intactLowLine, bar_index + 1, bosLow)
            label.set_xy(intactLowLbl, bar_index + 1, bosLow)
else
    if not na(intactHighLine)
        line.delete(intactHighLine)
        label.delete(intactHighLbl)
        intactHighLine := na
        intactHighLbl := na
    if not na(intactLowLine)
        line.delete(intactLowLine)
        label.delete(intactLowLbl)
        intactLowLine := na
        intactLowLbl := na


//=====================================================================
// MOTEUR DE MOUVEMENT (moteur — toujours actif)
//
// Une cassure (BOS ou CHoCH) lance un mouvement. Le moteur suit son
// origine et son extrême pour calculer le niveau 0.5 — c'est ce 0.5
// qui juge la validité du retracement, et c'est moveDir (jamais le
// biais brut) qui pilote la direction de l'IDM.
//=====================================================================
bool newMoveUp   = bosBull or chochBull
bool newMoveDown = bosBear or chochBear

var int moveDir = 0
var float moveOrigin = na
var int moveOriginBar = na
var float moveExtreme = na
var int moveExtremeBar = na
var float moveFib50 = na

// true uniquement sur les bougies qui viennent d'étendre l'extrême du
// mouvement (bougie de cassure incluse) — ce ne sont PAS des bougies
// de retracement, donc on ne doit jamais les tester contre le 0.5.
bool extremeUpdated = false

if newMoveUp
    moveDir := 1
    // brokenHigh/brokenHighBar (pas bosHigh/bosHighBar, déjà remis à
    // jour vers la prochaine référence à ce stade du script) : l'origine
    // du mouvement est bien le niveau qui vient d'être cassé.
    moveOrigin := brokenHigh
    moveOriginBar := brokenHighBar
    moveExtreme := high
    moveExtremeBar := bar_index
    moveFib50 := (moveOrigin + moveExtreme) / 2.0
    extremeUpdated := true

if newMoveDown
    moveDir := -1
    moveOrigin := brokenLow
    moveOriginBar := brokenLowBar
    moveExtreme := low
    moveExtremeBar := bar_index
    moveFib50 := (moveOrigin + moveExtreme) / 2.0
    extremeUpdated := true

if moveDir == 1 and not newMoveUp and high > moveExtreme
    moveExtreme := high
    moveExtremeBar := bar_index
    moveFib50 := (moveOrigin + moveExtreme) / 2.0
    extremeUpdated := true

if moveDir == -1 and not newMoveDown and low < moveExtreme
    moveExtreme := low
    moveExtremeBar := bar_index
    moveFib50 := (moveOrigin + moveExtreme) / 2.0
    extremeUpdated := true


//=====================================================================
// AFFICHAGE — Premium / Discount (0.5), indépendant
//=====================================================================
var line fib50Line = na

if showPd and moveDir != 0 and not na(moveFib50)
    if na(fib50Line)
        fib50Line := line.new(moveOriginBar, moveFib50, bar_index + 5, moveFib50,
             color=color.new(pdCol, 40), style=line.style_dotted)
    else
        line.set_xy1(fib50Line, moveOriginBar, moveFib50)
        line.set_xy2(fib50Line, bar_index + 5, moveFib50)


//=====================================================================
// LE 0.5 JUGE LE RETRACEMENT (moteur — toujours actif)
//
// validTest = le prix a déjà atteint le 0.5 dans le bon sens pendant
// ce mouvement (Discount en haussier, Premium en baissier). C'est
// cette valeur qui décide, dans le dashboard, si le dernier
// retracement est "valide" ou "raté" — et candidateRetracementValid
// (plus bas) décide, pivot par pivot, si CE pivot précis se situe déjà
// dans la bonne zone au moment où il devient IDM.
//=====================================================================
var bool validTest = false

if newMoveUp or newMoveDown
    validTest := false

// On ne teste le 0.5 QUE sur les bougies qui ne sont pas en train
// d'étendre l'extrême — sinon la mèche de la bougie de cassure
// elle-même validerait le test à tort, avant tout vrai retracement.
if not extremeUpdated
    if moveDir == 1 and not na(moveFib50) and low <= moveFib50
        validTest := true

    if moveDir == -1 and not na(moveFib50) and high >= moveFib50
        validTest := true


// Règle des 80/20 (Module 1) : l'impulsion représente 80% de la
// continuation, le retracement 20%. On mesure ici le point le plus
// profond atteint par le retracement en cours, purement informatif —
// n'influence ni validTest, ni l'IDM, ni aucun signal existant.
var float moveRetraceExtreme = na

if newMoveUp or newMoveDown
    moveRetraceExtreme := na

if not extremeUpdated
    if moveDir == 1
        moveRetraceExtreme := na(moveRetraceExtreme) ? low : math.min(moveRetraceExtreme, low)
    if moveDir == -1
        moveRetraceExtreme := na(moveRetraceExtreme) ? high : math.max(moveRetraceExtreme, high)


//=====================================================================
// IDM — MOTEUR (toujours actif, indépendant de l'affichage)
//
//   Structure haussière -> IDM (IDBL) = dernier pivot BAS,
//                           obligatoirement SOUS moveExtreme (sous le
//                           prix / sous la jambe haussière)
//   Structure baissière -> IDM (IDBR) = dernier pivot HAUT,
//                           obligatoirement AU-DESSUS de moveExtreme
//
// Chaque pivot opposé au mouvement CONFIRMÉ (moveDir, pas le biais
// brut) est un candidat IDM, sans exception, petit ou grand — le
// biais peut déjà pencher vers un nouveau sens avant qu'une cassure ne
// le confirme, ce qui produirait un IDM (donc un futur signal) dans le
// mauvais sens si on s'y fiait.
//
// Tant que l'IDM actif n'est pas récupéré, tout nouveau candidat le
// REMPLACE : l'ancien devient une FS historique, figée, jamais
// supprimée. Ce remplacement peut se répéter indéfiniment.
//=====================================================================
var float[]  idmLevel = array.new_float()
var int[]    idmDir   = array.new_int()
var bool[]   idmDone  = array.new_bool()
var string[] idmKind  = array.new_string()   // "IDM" ou "FS"
var line[]   idmLine  = array.new_line()     // peut contenir na si showIdmLines=false
var label[]  idmLbl   = array.new_label()    // peut contenir na si showIdmLines=false
var box[]    idmZoneA = array.new_box()      // peut contenir na si showIdmZone=false

// Sniper Zone — tableau STRICTEMENT parallèle à idmZoneA (mêmes
// indices, même cycle de vie : création, promotion en 2e position,
// gel/suppression en FS, prolongation, purge). Totalement dissociée de
// Supply/Demand (module 8, indépendant) : la Sniper Zone n'existe qu'à
// travers l'IDM, jamais via une détection de bougie séparée.
var box[] sniperZoneA = array.new_box()      // peut contenir na si showSniperZone=false

float idmCandidate    = na
int   idmCandidateBar = na

// Garde-fou explicite : IDM haussier toujours < moveExtreme (sous le
// prix), IDM baissier toujours > moveExtreme (au-dessus du prix).
if moveDir == 1 and not na(pl) and pl < moveExtreme
    idmCandidate := pl
    idmCandidateBar := plBar

if moveDir == -1 and not na(ph) and ph > moveExtreme
    idmCandidate := ph
    idmCandidateBar := phBar

int nPrev = array.size(idmLevel)
float prevTopLevel = nPrev > 0 ? array.get(idmLevel, nPrev - 1) : na
int   prevTopDir   = nPrev > 0 ? array.get(idmDir, nPrev - 1) : 0
bool  prevTopDone  = nPrev > 0 ? array.get(idmDone, nPrev - 1) : true

bool newIDM =
     not na(idmCandidate) and
     (nPrev == 0 or idmCandidate != prevTopLevel or prevTopDir != moveDir)

bool isFS = newIDM and nPrev > 0 and not prevTopDone and prevTopDir == moveDir

// Le 0.5 décide, pour CE candidat précis, s'il se situe déjà dans la
// zone de retracement valide (Discount haussier / Premium baissier).
bool candidateRetracementValid =
     moveDir == 1 ? idmCandidate <= moveFib50 :
     moveDir == -1 ? idmCandidate >= moveFib50 : false

if newIDM

    array.push(idmLevel, idmCandidate)
    array.push(idmDir, moveDir)
    array.push(idmDone, false)
    array.push(idmKind, "IDM")

    line ln = na
    label lb = na
    if showIdmLines
        string idmTxt0 = candidateRetracementValid ? "IDM •0.5" : "IDM"
        ln := line.new(idmCandidateBar, idmCandidate, bar_index + 1, idmCandidate,
             color=idmActiveCol, style=line.style_dotted, width=3)
        lb := label.new(bar_index + 1, idmCandidate, idmTxt0,
             style=label.style_label_left,
             color=color.new(idmActiveCol, 75),
             textcolor=idmActiveCol,
             size=size.small)
    array.push(idmLine, ln)
    array.push(idmLbl, lb)

    // Règle 80/20 : tendance confirmée haussière -> uniquement des
    // achats, confirmée baissière -> uniquement des ventes. Basé sur
    // confirmedTrend (ne change que sur un vrai CHoCH), PAS sur bias
    // brut qui peut retomber à 0 sur un simple pullback. N'affecte que
    // le DESSIN de la zone, jamais idmLevel/idmDir/idmDone ni la
    // détection de récupération — la logique IDM reste strictement
    // identique.
    bool dirAllowed = confirmedTrend == 0 or confirmedTrend == moveDir

    box zn = na
    if showIdmZone and dirAllowed
        float zTop = moveDir == 1 ? idmCandidate : idmCandidate + atrZone
        float zBot = moveDir == 1 ? idmCandidate - atrZone : idmCandidate
        zn := box.new(idmCandidateBar, zTop, bar_index + idmZoneExt, zBot,
             border_color=idmActiveCol,
             border_width=2,
             border_style=line.style_dashed,
             bgcolor=color.new(idmActiveCol, 78),
             text="Zone à retester",
             text_color=idmActiveCol,
             text_size=size.tiny,
             text_halign=text.align_left)
    array.push(idmZoneA, zn)

    // Sniper Zone — préparée MAINTENANT, dès la formation de l'IDM, pas
    // seulement une fois le prix revenu. Bande fine centrée sur l'IDM
    // (bien plus étroite que la Zone à retester) : c'est ici, et
    // uniquement ici, que se prépare l'entrée de précision.
    box sn = na
    if showSniperZone and dirAllowed
        sn := box.new(idmCandidateBar, idmCandidate + atrSniper, bar_index + idmZoneExt, idmCandidate - atrSniper,
             border_color=sniperCol,
             border_width=2,
             bgcolor=color.new(sniperCol, 85),
             text="Sniper Zone",
             text_color=sniperCol,
             text_size=size.tiny,
             text_halign=text.align_left)
    array.push(sniperZoneA, sn)

    int n = array.size(idmLevel)

    // L'ancien "le plus récent" passe en 2e position : reste "IDM",
    // couleur secondaire, continue d'être surveillé et prolongé.
    if n >= 2 and not array.get(idmDone, n - 2)
        line ln2 = array.get(idmLine, n - 2)
        if not na(ln2)
            line.set_color(ln2, idmWaitCol)
            line.set_width(ln2, 2)
        label lb2 = array.get(idmLbl, n - 2)
        if not na(lb2)
            label.set_color(lb2, color.new(idmWaitCol, 75))
            label.set_textcolor(lb2, idmWaitCol)
        box bz2 = array.get(idmZoneA, n - 2)
        if not na(bz2)
            box.set_border_color(bz2, idmWaitCol)
            box.set_border_width(bz2, 2)
            box.set_bgcolor(bz2, color.new(idmWaitCol, 78))
        box sz2 = array.get(sniperZoneA, n - 2)
        if not na(sz2)
            box.set_border_width(sz2, 1)

    // Celui qui sort du top 2 devient une FS. Si showFsHistory est
    // actif, on la fige en gris comme avant (jamais supprimée). Sinon
    // (par défaut), on la supprime directement pour garder le
    // graphique lisible — c'est le comportement demandé par défaut.
    if n >= 3 and not array.get(idmDone, n - 3)
        array.set(idmKind, n - 3, "FS")
        line ln3 = array.get(idmLine, n - 3)
        label lb3 = array.get(idmLbl, n - 3)
        box bz3 = array.get(idmZoneA, n - 3)
        box sz3 = array.get(sniperZoneA, n - 3)
        if showFsHistory
            if not na(ln3)
                line.set_x2(ln3, idmCandidateBar)
                line.set_color(ln3, color.new(fsCol, 55))
                line.set_width(ln3, 1)
            if not na(lb3)
                label.set_text(lb3, "FS")
                label.set_xy(lb3, idmCandidateBar, array.get(idmLevel, n - 3))
                label.set_color(lb3, color.new(fsCol, 80))
                label.set_textcolor(lb3, fsCol)
            if not na(bz3)
                box.set_right(bz3, idmCandidateBar)
                box.set_border_color(bz3, color.new(fsCol, 60))
                box.set_bgcolor(bz3, color.new(fsCol, 94))
                box.set_text(bz3, "")
            if not na(sz3)
                box.set_right(sz3, idmCandidateBar)
                box.set_border_color(sz3, color.new(fsCol, 60))
                box.set_bgcolor(sz3, color.new(fsCol, 94))
                box.set_text(sz3, "")
        else
            if not na(ln3)
                line.delete(ln3)
            if not na(lb3)
                label.delete(lb3)
            if not na(bz3)
                box.delete(bz3)
            if not na(sz3)
                box.delete(sz3)


// Prolongation des DEUX plus récents tant qu'ils ne sont pas recouverts.
int nNow = array.size(idmLevel)

if nNow > 0
    int topIdx = nNow - 1
    if not array.get(idmDone, topIdx)
        line lnTop = array.get(idmLine, topIdx)
        if not na(lnTop)
            line.set_x2(lnTop, bar_index + 1)
        label lbTop = array.get(idmLbl, topIdx)
        if not na(lbTop)
            label.set_xy(lbTop, bar_index + 1, array.get(idmLevel, topIdx))
        box bzTop = array.get(idmZoneA, topIdx)
        if not na(bzTop)
            box.set_right(bzTop, bar_index + idmZoneExt)
        box szTop = array.get(sniperZoneA, topIdx)
        if not na(szTop)
            box.set_right(szTop, bar_index + idmZoneExt)

if nNow > 1
    int secIdx = nNow - 2
    if not array.get(idmDone, secIdx)
        line lnSec = array.get(idmLine, secIdx)
        if not na(lnSec)
            line.set_x2(lnSec, bar_index + 1)
        label lbSec = array.get(idmLbl, secIdx)
        if not na(lbSec)
            label.set_xy(lbSec, bar_index + 1, array.get(idmLevel, secIdx))
        box bzSec = array.get(idmZoneA, secIdx)
        if not na(bzSec)
            box.set_right(bzSec, bar_index + idmZoneExt)
        box szSec = array.get(sniperZoneA, secIdx)
        if not na(szSec)
            box.set_right(szSec, bar_index + idmZoneExt)


//=====================================================================
// RÉCUPÉRATION DE L'IDM (moteur — toujours actif)
//
// Vérifiée pour TOUS les IDM encore actifs, même les anciens FS. Les
// DEUX plus récents (position 1 et 2 — les deux encore étiquetés
// "IDM", pas encore tombés en FS) déclenchent le vrai signal d'entrée
// dès que le prix revient les chercher. Un ancien FS (position 3+)
// retesté plus tard ne déclenche jamais de signal, juste un marquage
// "✓" informatif.
//
// Point critique : si l'IDM est repris MAIS que, sur la même bougie,
// le prix casse réellement la structure dans le sens opposé (close
// au-delà du niveau structurel, qui est numériquement le même niveau
// que l'IDM), alors ce n'est PAS une continuation — c'est un CHoCH.
// Aucun signal d'entrée n'est émis dans ce cas.
//=====================================================================
bool entrySignalBuy   = false
bool entrySignalSell  = false
bool signalBlockedByChoch = false

if array.size(idmLevel) > 0
    for i = array.size(idmLevel) - 1 to 0
        if not array.get(idmDone, i)
            float lvl = array.get(idmLevel, i)
            int   dir = array.get(idmDir, i)
            bool recovered = (dir == 1 and low <= lvl) or (dir == -1 and high >= lvl)

            if recovered
                array.set(idmDone, i, true)

                // Sniper Zone : dès que le prix part RÉELLEMENT pour le
                // mouvement (l'IDM vient d'être liquidé), on la supprime
                // immédiatement — elle ne doit être visible qu'au moment
                // adéquat, pas après. S'applique à tout IDM recouvré,
                // top-2 ou FS historique.
                box szr = array.get(sniperZoneA, i)
                if not na(szr)
                    box.delete(szr)

                // Position 1 (le plus récent) OU position 2 : les deux
                // comptent comme "actuels" et déclenchent un signal.
                bool isTopTwo       = i >= array.size(idmLevel) - 2
                bool blockedByChoch = (dir == 1 and chochBear) or (dir == -1 and chochBull)

                line lnr = array.get(idmLine, i)
                label lbr = array.get(idmLbl, i)
                box bzr = array.get(idmZoneA, i)

                if isTopTwo and not blockedByChoch
                    // LE signal d'entrée — le seul qui compte pour trader.
                    color entryCol = dir == 1 ? entryBuyCol : entrySellCol
                    string entryTxt = dir == 1 ? "ENTRÉE ACHAT" : "ENTRÉE VENTE"

                    if not na(lnr)
                        line.delete(lnr)
                    if not na(lbr)
                        label.delete(lbr)
                    if showIdmEntry
                        label.new(bar_index, lvl, entryTxt,
                             style = dir == 1 ? label.style_label_up : label.style_label_down,
                             color=color.new(entryCol, 10),
                             textcolor=color.white,
                             size=size.normal)

                    if not na(bzr)
                        box.set_right(bzr, bar_index)
                        box.set_border_color(bzr, entryCol)
                        box.set_border_width(bzr, 3)
                        box.set_border_style(bzr, line.style_solid)
                        box.set_bgcolor(bzr, color.new(entryCol, 70))
                        if showIdmEntry
                            box.set_text(bzr, entryTxt)
                            box.set_text_color(bzr, color.white)

                    if dir == 1
                        entrySignalBuy := true
                    else
                        entrySignalSell := true
                else
                    // Soit un ancien FS retesté (position 3+, jamais de
                    // signal), soit un des deux IDM actuels repris MAIS
                    // invalidé par un CHoCH sur la même bougie.
                    if isTopTwo and blockedByChoch
                        signalBlockedByChoch := true
                    string doneTxt = isTopTwo and blockedByChoch ?
                         array.get(idmKind, i) + " ✓ (CHoCH)" :
                         array.get(idmKind, i) + " ✓"

                    if not na(lnr)
                        line.set_x2(lnr, bar_index)
                        line.set_color(lnr, color.new(idmDoneCol, 40))
                    if not na(lbr)
                        label.set_text(lbr, doneTxt)
                        label.set_xy(lbr, bar_index, lvl)
                        label.set_color(lbr, color.new(idmDoneCol, 75))
                        label.set_textcolor(lbr, idmDoneCol)
                    if not na(bzr)
                        box.set_right(bzr, bar_index)
                        box.set_border_color(bzr, color.new(idmDoneCol, 40))
                        box.set_bgcolor(bzr, color.new(idmDoneCol, 90))
                        box.set_text(bzr, "")


// limitation historique — 8 tableaux liés (dont sniperZoneA), on garde
// tout synchronisé
if array.size(idmLevel) > maxHistory
    line oldLn = array.shift(idmLine)
    if not na(oldLn)
        line.delete(oldLn)
    label oldLb = array.shift(idmLbl)
    if not na(oldLb)
        label.delete(oldLb)
    box oldBz = array.shift(idmZoneA)
    if not na(oldBz)
        box.delete(oldBz)
    box oldSz = array.shift(sniperZoneA)
    if not na(oldSz)
        box.delete(oldSz)
    array.shift(idmLevel)
    array.shift(idmDir)
    array.shift(idmDone)
    array.shift(idmKind)


//=====================================================================
// ÉTAT DE CONTINUATION (moteur — toujours actif)
//
// Après une récupération d'IDM : soit un nouveau BOS dans le même sens
// confirme la continuation, soit un CHoCH dans le sens opposé
// invalide le mouvement.
//=====================================================================
var bool awaitingContinuationConfirm = false
var int  awaitingDir = 0
var string continuationMsg = "-"

bool justConfirmedContinuation = false
bool justInvalidated = false

if awaitingContinuationConfirm
    if (awaitingDir == 1 and bosBull) or (awaitingDir == -1 and bosBear)
        justConfirmedContinuation := true
        awaitingContinuationConfirm := false
    else if (awaitingDir == 1 and chochBear) or (awaitingDir == -1 and chochBull)
        justInvalidated := true
        awaitingContinuationConfirm := false

if entrySignalBuy
    awaitingContinuationConfirm := true
    awaitingDir := 1
if entrySignalSell
    awaitingContinuationConfirm := true
    awaitingDir := -1

if justConfirmedContinuation
    continuationMsg := "Continuation confirmée ✓"
if justInvalidated
    continuationMsg := "Invalidée — CHoCH"
if entrySignalBuy or entrySignalSell
    continuationMsg := "Retest en cours — ENTRÉE"
if signalBlockedByChoch
    continuationMsg := "IDM repris mais CHoCH — pas d'entrée"


//=====================================================================
// PHASES — Accumulation / Réaccumulation, Distribution / Redistribution
// (moteur toujours actif ; seul le dessin est gated par showPhaseBox /
// showPhaseMarkers / showPhaseZone / showPhaseEntry, chacune indépendante)
//
// Wyckoff : la consolidation est la CAUSE, le mouvement qui suit est
// l'EFFET. Réaccumulation = même pause mais en cours de tendance déjà
// haussière (continuation) ; Redistribution = pareil en tendance déjà
// baissière.
//=====================================================================
var string lastPhase = "-"

var bool  accActive = false
var float accSC = na
var int   accSCBar = na
var float accLow = na
var float accTop = na
var int   accSTBBar = na
var float accSTBVal = na
var int   accSpringBar = na
var float accSpringVal = na
var int   accAge = 0
var int   accStartBias = 0

var bool  disActive = false
var float disBC = na
var int   disBCBar = na
var float disHigh = na
var float disBottom = na
var int   disUTBar = na
var float disUTVal = na
var int   disUTADBar = na
var float disUTADVal = na
var int   disAge = 0
var int   disStartBias = 0

bool phaseAccConfirmed = false
bool phaseDisConfirmed = false
bool phaseEntryBuy     = false
bool phaseEntrySell    = false

if accActive
    accAge += 1
    accTop := math.max(accTop, high)
    if low < accLow
        if na(accSTBBar)
            accSTBBar := bar_index
            accSTBVal := low
            // Réactif : le repère apparaît dès qu'il se forme, pas
            // seulement une fois toute la phase confirmée plus tard.
            if showPhaseMarkers
                label.new(accSTBBar, accSTBVal, "STB", style=label.style_label_up, color=color.new(phaseCol, 70), textcolor=phaseCol, size=size.small)
        else
            accSpringBar := bar_index
            accSpringVal := low
            if showPhaseMarkers
                label.new(accSpringBar, accSpringVal, "SPRING", style=label.style_label_up, color=color.new(phaseCol, 55), textcolor=phaseCol, size=size.small)
        accLow := low
    if newMoveDown
        accActive := false
    if accAge > 500
        accActive := false

if disActive
    disAge += 1
    disBottom := math.min(disBottom, low)
    if high > disHigh
        if na(disUTBar)
            disUTBar := bar_index
            disUTVal := high
            if showPhaseMarkers
                label.new(disUTBar, disUTVal, "UT", style=label.style_label_down, color=color.new(phaseCol, 70), textcolor=phaseCol, size=size.small)
        else
            disUTADBar := bar_index
            disUTADVal := high
            if showPhaseMarkers
                label.new(disUTADBar, disUTADVal, "UTAD", style=label.style_label_down, color=color.new(phaseCol, 55), textcolor=phaseCol, size=size.small)
        disHigh := high
    if newMoveUp
        disActive := false
    if disAge > 500
        disActive := false

if accActive and newMoveUp and not na(accSCBar)
    float topA = math.max(accTop, high)
    string phTxt = accStartBias == 1 ? "RÉACCUMULATION" : "ACCUMULATION"
    lastPhase := phTxt
    accActive := false
    phaseAccConfirmed := true
    // SC / STB / SPRING confirmés par un vrai BOS haussier = toutes les
    // conditions réunies -> signal d'entrée ACHAT, au même titre que l'IDM.
    phaseEntryBuy := true
    if showPhaseBox
        box.new(accSCBar, topA, bar_index, accLow, border_color=color.new(bullCol, 30), bgcolor=color.new(bullCol, 92))
        label.new(accSCBar, topA, phTxt, style=label.style_label_down, color=color.new(bullCol, 55), textcolor=bullCol, size=size.small)
    // SC/STB/SPRING sont déjà posés en direct (voir plus haut, dès leur
    // formation) — pas de redoublon ici, seul le rectangle est nouveau.
    // Zone d'intervention de la phase — comme pour l'IDM, prolongée
    // vers l'avant. Règle 80/20 : jamais de zone ACHAT tant que la
    // tendance confirmée (CHoCH) est baissière.
    if showPhaseZone and confirmedTrend != -1
        box.new(accSCBar, topA, bar_index + idmZoneExt, accLow,
             border_color=entryBuyCol, border_width=2, border_style=line.style_solid,
             bgcolor=color.new(entryBuyCol, 75), text="ZONE ACHAT — " + phTxt,
             text_color=color.white, text_size=size.tiny, text_halign=text.align_left)
    // Signal visuel "ENTRÉE ACHAT" — indépendant du rectangle/repères/zone.
    if showPhaseEntry
        label.new(bar_index, low, "ENTRÉE ACHAT (" + phTxt + ")",
             style=label.style_label_up, color=color.new(entryBuyCol, 10), textcolor=color.white, size=size.normal)

if disActive and newMoveDown and not na(disBCBar)
    float botD = math.min(disBottom, low)
    string phTxt = disStartBias == -1 ? "REDISTRIBUTION" : "DISTRIBUTION"
    lastPhase := phTxt
    disActive := false
    phaseDisConfirmed := true
    // BC / UT / UTAD confirmés par un vrai BOS baissier = toutes les
    // conditions réunies -> signal d'entrée VENTE, au même titre que l'IDM.
    phaseEntrySell := true
    if showPhaseBox
        box.new(disBCBar, disHigh, bar_index, botD, border_color=color.new(bearCol, 30), bgcolor=color.new(bearCol, 92))
        label.new(disBCBar, botD, phTxt, style=label.style_label_up, color=color.new(bearCol, 55), textcolor=bearCol, size=size.small)
    // BC/UT/UTAD sont déjà posés en direct (voir plus haut, dès leur
    // formation) — pas de redoublon ici, seul le rectangle est nouveau.
    // Zone d'intervention de la phase — comme pour l'IDM, prolongée
    // vers l'avant. Règle 80/20 : jamais de zone VENTE tant que la
    // tendance confirmée (CHoCH) est haussière.
    if showPhaseZone and confirmedTrend != 1
        box.new(disBCBar, disHigh, bar_index + idmZoneExt, botD,
             border_color=entrySellCol, border_width=2, border_style=line.style_solid,
             bgcolor=color.new(entrySellCol, 75), text="ZONE VENTE — " + phTxt,
             text_color=color.white, text_size=size.tiny, text_halign=text.align_left)
    // Signal visuel "ENTRÉE VENTE" — indépendant du rectangle/repères/zone.
    if showPhaseEntry
        label.new(bar_index, high, "ENTRÉE VENTE (" + phTxt + ")",
             style=label.style_label_down, color=color.new(entrySellCol, 10), textcolor=color.white, size=size.normal)

if not accActive and not na(pl)
    accActive := true
    accSC := pl
    accSCBar := plBar
    accLow := pl
    accTop := na(lastPH) ? high : math.max(lastPH, high)
    accSTBBar := na
    accSTBVal := na
    accSpringBar := na
    accSpringVal := na
    accAge := 0
    accStartBias := bias
    // Réactif : SC posé dès sa formation, pas après-coup à la confirmation.
    if showPhaseMarkers
        label.new(accSCBar, accSC, "SC", style=label.style_label_up, color=color.new(bullCol, 70), textcolor=bullCol, size=size.small)

if not disActive and not na(ph)
    disActive := true
    disBC := ph
    disBCBar := phBar
    disHigh := ph
    disBottom := na(lastPL) ? low : math.min(lastPL, low)
    disUTBar := na
    disUTVal := na
    disUTADBar := na
    disUTADVal := na
    disAge := 0
    disStartBias := bias
    // Réactif : BC posé dès sa formation, pas après-coup à la confirmation.
    if showPhaseMarkers
        label.new(disBCBar, disBC, "BC", style=label.style_label_down, color=color.new(bearCol, 70), textcolor=bearCol, size=size.small)


//=====================================================================
// AFFICHAGE — FVG (indépendant, lecture seule des prix)
//=====================================================================
var box[] fvgBoxes = array.new_box()

if bar_index >= 2
    if showFvgBull and low > high[2]
        array.push(fvgBoxes, box.new(bar_index[2], low, bar_index, high[2],
             border_color=color.new(fvgBullCol, 60), bgcolor=color.new(fvgBullCol, 88)))
    if showFvgBear and high < low[2]
        array.push(fvgBoxes, box.new(bar_index[2], low[2], bar_index, high,
             border_color=color.new(fvgBearCol, 60), bgcolor=color.new(fvgBearCol, 88)))
    if array.size(fvgBoxes) > maxFvg
        box.delete(array.shift(fvgBoxes))


//=====================================================================
// AFFICHAGE — Supply / Demand (module 8, totalement indépendant de
// l'IDM et de la Sniper Zone — lit seulement bosBull/bosBear, ne les
// modifie pas). Volontairement séparé pour ne jamais se confondre
// avec la Sniper Zone, qui reste toujours liée à l'IDM. Règle 80/20 :
// jamais de DEMAND tant que la tendance confirmée (CHoCH) est
// baissière, jamais de SUPPLY tant qu'elle est haussière.
//=====================================================================
var box[] demBx = array.new_box()
var box[] supBx = array.new_box()

if showDemand and bosBull and confirmedTrend != -1
    float demZt = high
    float demZb = low
    int demZi = bar_index
    for i = 1 to 30
        if close[i] < open[i]
            demZt := high[i]
            demZb := low[i]
            demZi := bar_index[i]
            break
    array.push(demBx, box.new(demZi, demZt, bar_index + 12, demZb,
         border_color=bullCol, bgcolor=color.new(bullCol, 82), text="DEMAND", text_color=bullCol, text_size=size.small))
    if array.size(demBx) > maxZones
        box.delete(array.shift(demBx))

if showSupply and bosBear and confirmedTrend != 1
    float supZt = high
    float supZb = low
    int supZi = bar_index
    for i = 1 to 30
        if close[i] > open[i]
            supZt := high[i]
            supZb := low[i]
            supZi := bar_index[i]
            break
    array.push(supBx, box.new(supZi, supZt, bar_index + 12, supZb,
         border_color=bearCol, bgcolor=color.new(bearCol, 82), text="SUPPLY", text_color=bearCol, text_size=size.small))
    if array.size(supBx) > maxZones
        box.delete(array.shift(supBx))


//=====================================================================
// AFFICHAGE — Heures de Tirs (Sessions), indépendant, purement visuel
//=====================================================================
bool inAsian1 = not na(time(timeframe.period, "0100-0300", "Europe/Paris"))
bool inAsian2 = not na(time(timeframe.period, "0800-1000", "Europe/Paris"))
bool inNY     = not na(time(timeframe.period, "1300-1600", "Europe/Paris"))

bgcolor(showSessions and inAsian1 ? asianCol : na, title="Asian Session (1h-3h)")
bgcolor(showSessions and inAsian2 ? asianCol : na, title="Asian Session (8h-10h)")
bgcolor(showSessions and inNY ? nyCol : na, title="NYC Session (13h-16h)")


//=====================================================================
// DASHBOARD — lit uniquement l'état du moteur, fonctionne même si
// tous les autres modules d'affichage sont désactivés
//=====================================================================
var table dash = table.new(position.top_right, 2, 14,
     border_width=1, frame_width=1, frame_color=color.gray)

if showDash and barstate.islast

    string structTxt =
         bias == 1 ? "BULLISH" :
         bias == -1 ? "BEARISH" :
         "CONSOLIDATION"

    color structColor =
         bias == 1 ? bullCol :
         bias == -1 ? bearCol :
         rangeCol

    // Les DEUX IDM actifs — c'est ce qui compte vraiment. Affichés
    // explicitement pour que le biais + les deux niveaux à surveiller
    // soient visibles d'un coup d'œil, sur n'importe quel timeframe.
    int nIdm = array.size(idmLevel)
    bool topDone = nIdm > 0 and array.get(idmDone, nIdm - 1)
    int topDir   = nIdm > 0 ? array.get(idmDir, nIdm - 1) : 0
    float topLvl = nIdm > 0 ? array.get(idmLevel, nIdm - 1) : na

    bool prevDone = nIdm > 1 and array.get(idmDone, nIdm - 2)
    int  prevDir  = nIdm > 1 ? array.get(idmDir, nIdm - 2) : 0
    float prevLvl = nIdm > 1 ? array.get(idmLevel, nIdm - 2) : na

    string idm1Txt = nIdm == 0 ? "-" :
         (topDir == 1 ? "IDBL " : "IDBR ") + str.tostring(topLvl, format.mintick) + (topDone ? " ✓" : " (attente)")
    color idm1Col = nIdm == 0 ? rangeCol : topDone ? idmDoneCol : idmActiveCol

    string idm2Txt = nIdm < 2 ? "-" :
         (prevDir == 1 ? "IDBL " : "IDBR ") + str.tostring(prevLvl, format.mintick) + (prevDone ? " ✓" : " (attente)")
    color idm2Col = nIdm < 2 ? rangeCol : prevDone ? idmDoneCol : idmWaitCol

    int fsCount = 0
    if array.size(idmKind) > 0
        for i = 0 to array.size(idmKind) - 1
            if array.get(idmKind, i) == "FS"
                fsCount += 1

    string retracementTxt =
         moveDir == 0 ? "-" :
         validTest ? "Normal (0.5 atteint)" :
         "Superficiel (0.5 non atteint)"

    color retracementCol =
         moveDir == 0 ? rangeCol :
         validTest ? idmDoneCol : idmWaitCol

    string pdTxt =
         moveDir == 0 or na(moveFib50) ? "-" :
         close < moveFib50 ? "Discount" :
         close > moveFib50 ? "Premium" : "Équilibre"

    color pdColCell =
         moveDir == 0 or na(moveFib50) ? rangeCol :
         pdTxt == "Discount" ? bullCol :
         pdTxt == "Premium" ? bearCol : rangeCol

    string phaseTxt =
         accActive ? "Accumulation (cause) en cours" :
         disActive ? "Distribution (cause) en cours" :
         lastPhase

    color phaseCellCol =
         accActive ? bullCol :
         disActive ? bearCol :
         dashValueCol

    string contTxt = nIdm > 0 and not topDone ? "IDM en attente" : continuationMsg
    color contCol =
         contTxt == "Continuation confirmée ✓" ? bullCol :
         contTxt == "Invalidée — CHoCH" ? bearCol :
         contTxt == "Retest en cours — ENTRÉE" ? (awaitingDir == 1 ? entryBuyCol : entrySellCol) :
         dashValueCol

    string actionTxt = "-"
    color actionCol = rangeCol

    if entrySignalBuy
        actionTxt := "ENTRER ACHAT MAINTENANT"
        actionCol := entryBuyCol
    else if entrySignalSell
        actionTxt := "ENTRER VENTE MAINTENANT"
        actionCol := entrySellCol
    else if phaseEntryBuy
        actionTxt := "ENTRER ACHAT MAINTENANT (Accumulation)"
        actionCol := entryBuyCol
    else if phaseEntrySell
        actionTxt := "ENTRER VENTE MAINTENANT (Distribution)"
        actionCol := entrySellCol
    else if nIdm > 0 and not topDone
        actionTxt := (topDir == 1 ? "Préparer ACHAT — retest " : "Préparer VENTE — retest ") + str.tostring(topLvl, format.mintick)
        actionCol := idmActiveCol
    else if nIdm > 0
        actionTxt := "Attendre le prochain IDM"
        actionCol := rangeCol

    // Règle des 80/20 — profondeur du retracement en cours par rapport
    // à l'impulsion qui l'a précédé (lecture seule, Module 1).
    float retracePct = na
    if moveDir == 1 and not na(moveRetraceExtreme) and moveExtreme != moveOrigin
        retracePct := (moveExtreme - moveRetraceExtreme) / (moveExtreme - moveOrigin) * 100
    if moveDir == -1 and not na(moveRetraceExtreme) and moveExtreme != moveOrigin
        retracePct := (moveRetraceExtreme - moveExtreme) / (moveOrigin - moveExtreme) * 100

    string retrace8020Txt = na(retracePct) ? "-" :
         str.tostring(retracePct, "#.#") + "%" +
         (retracePct <= 20 ? " (sain)" : retracePct <= 50 ? " (normal)" : " (profond ⚠)")
    color retrace8020Col = na(retracePct) ? rangeCol :
         retracePct <= 20 ? entryBuyCol : retracePct <= 50 ? idmWaitCol : bearCol

    // Statut Sniper Zone — celle du dernier IDM actif (donc TOUJOURS
    // liée à l'IDM, jamais à Supply/Demand). "Peut ne pas être atteinte"
    // : on affiche l'état réel, jamais une certitude.
    string sniperTxt = "-"
    color sniperStatusCol = rangeCol
    if nIdm > 0
        box lastSnip = array.get(sniperZoneA, nIdm - 1)
        if not na(lastSnip)
            float snTop = box.get_top(lastSnip)
            float snBot = box.get_bottom(lastSnip)
            bool inSnip = close <= snTop and close >= snBot
            sniperTxt := inSnip ? "Prix DANS la Sniper Zone ✓" : topDone ? "Déjà testée" : "En attente du retour du prix"
            sniperStatusCol := inSnip ? (topDir == 1 ? entryBuyCol : entrySellCol) : topDone ? idmDoneCol : idmActiveCol

    table.cell(dash, 0, 0, "SMV — MOTEUR", text_color=color.white, bgcolor=dashTitleBg, text_size=size.small)
    table.merge_cells(dash, 0, 0, 1, 0)

    table.cell(dash, 0, 1, "Structure", text_color=dashLabelCol, text_size=size.small, bgcolor=dashBgCol)
    table.cell(dash, 1, 1, structTxt, text_color=structColor, text_size=size.small, bgcolor=dashBgCol)

    table.cell(dash, 0, 2, "Dernier BOS", text_color=dashLabelCol, text_size=size.small, bgcolor=dashBgCol)
    table.cell(dash, 1, 2, lastBOS, text_color=dashValueCol, text_size=size.small, bgcolor=dashBgCol)

    table.cell(dash, 0, 3, "Dernier CHoCH", text_color=dashLabelCol, text_size=size.small, bgcolor=dashBgCol)
    table.cell(dash, 1, 3, lastCHoCH, text_color=#ffeb3b, text_size=size.small, bgcolor=dashBgCol)

    table.cell(dash, 0, 4, "IDM #1 (récent)", text_color=dashLabelCol, text_size=size.small, bgcolor=dashBgCol)
    table.cell(dash, 1, 4, idm1Txt, text_color=idm1Col, text_size=size.small, bgcolor=dashBgCol)

    table.cell(dash, 0, 5, "IDM #2 (précédent)", text_color=dashLabelCol, text_size=size.small, bgcolor=dashBgCol)
    table.cell(dash, 1, 5, idm2Txt, text_color=idm2Col, text_size=size.small, bgcolor=dashBgCol)

    table.cell(dash, 0, 6, "FS", text_color=dashLabelCol, text_size=size.small, bgcolor=dashBgCol)
    table.cell(dash, 1, 6, str.tostring(fsCount) + " historique(s)", text_color=fsCol, text_size=size.small, bgcolor=dashBgCol)

    table.cell(dash, 0, 7, "Retracement", text_color=dashLabelCol, text_size=size.small, bgcolor=dashBgCol)
    table.cell(dash, 1, 7, retracementTxt, text_color=retracementCol, text_size=size.small, bgcolor=dashBgCol)

    table.cell(dash, 0, 8, "Premium/Discount", text_color=dashLabelCol, text_size=size.small, bgcolor=dashBgCol)
    table.cell(dash, 1, 8, pdTxt, text_color=pdColCell, text_size=size.small, bgcolor=dashBgCol)

    table.cell(dash, 0, 9, "Phase", text_color=dashLabelCol, text_size=size.small, bgcolor=dashBgCol)
    table.cell(dash, 1, 9, phaseTxt, text_color=phaseCellCol, text_size=size.small, bgcolor=dashBgCol)

    table.cell(dash, 0, 10, "Continuation", text_color=dashLabelCol, text_size=size.small, bgcolor=dashBgCol)
    table.cell(dash, 1, 10, contTxt, text_color=contCol, text_size=size.small, bgcolor=dashBgCol)

    table.cell(dash, 0, 11, "Action", text_color=dashLabelCol, text_size=size.small, bgcolor=dashBgCol)
    table.cell(dash, 1, 11, actionTxt, text_color=actionCol, text_size=size.small, bgcolor=dashBgCol)

    table.cell(dash, 0, 12, "Retracement 80/20", text_color=dashLabelCol, text_size=size.small, bgcolor=dashBgCol)
    table.cell(dash, 1, 12, retrace8020Txt, text_color=retrace8020Col, text_size=size.small, bgcolor=dashBgCol)

    table.cell(dash, 0, 13, "Sniper Zone", text_color=dashLabelCol, text_size=size.small, bgcolor=dashBgCol)
    table.cell(dash, 1, 13, sniperTxt, text_color=sniperStatusCol, text_size=size.small, bgcolor=dashBgCol)


//=====================================================================
// ALERTES
//=====================================================================
alertcondition(bosBull, "BOS Bullish", "SMV : BOS haussier — continuation")
alertcondition(bosBear, "BOS Bearish", "SMV : BOS baissier — continuation")
alertcondition(chochBull, "CHoCH Bullish", "SMV : CHoCH haussier — changement de biais")
alertcondition(chochBear, "CHoCH Bearish", "SMV : CHoCH baissier — changement de biais")
alertcondition(isFS, "IDM déplacé (FS)", "SMV : retracement raté — l'IDM se déplace")
alertcondition(entrySignalBuy, "Entrée ACHAT", "SMV : IDM récupéré — entrée ACHAT")
alertcondition(entrySignalSell, "Entrée VENTE", "SMV : IDM récupéré — entrée VENTE")
alertcondition(signalBlockedByChoch, "IDM repris → CHoCH", "SMV : IDM repris mais structure cassée en sens opposé — CHoCH, pas d'entrée")
alertcondition(phaseAccConfirmed, "Fin d'accumulation", "SMV : accumulation/réaccumulation confirmée (SC/STB/SPRING)")
alertcondition(phaseDisConfirmed, "Fin de distribution", "SMV : distribution/redistribution confirmée (BC/UT/UTAD)")
alertcondition(phaseEntryBuy, "Entrée ACHAT (Accumulation)", "SMV : SC/STB/SPRING confirmés par un BOS haussier — entrée ACHAT")
alertcondition(phaseEntrySell, "Entrée VENTE (Distribution)", "SMV : BC/UT/UTAD confirmés par un BOS baissier — entrée VENTE")
