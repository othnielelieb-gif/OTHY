alertcondition(trTp1Hit, "TP1 atteint", "SMV : TP1 atteint — pense à sécuriser une partie de la position")
alertcondition(trTp3Hit, "TP3 atteint", "SMV : TP3 atteint — objectif final touché, le trade est clôturé")
alertcondition(trStopHit, "Stop touché", "SMV : le stop vient d'être touché — le setup est invalidé")
alertcondition(trBackT2, "Retour sur le TP2 — trade clôturé", "SMV : le prix était parti au-delà du TP2 puis y est revenu — le trade est clôturé, place à la prochaine opportunité")
alertcondition(trigArmed, "Setup ARMÉ — IDM balayé, on attend la preuve", "SMV : le prix a balayé l'IDM. Le setup est armé mais PAS ouvert : il attend le franchissement du 0.5 et une bougie de rejet.")
