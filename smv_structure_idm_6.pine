minSampl = input.int(10, "Griser en dessous de N trades", minval=1, maxval=100, group=gSc,
     tooltip="Un pourcentage calculé sur 3 trades ne veut rien dire. En dessous de ce seuil, les chiffres restent affichés mais grisés pour te rappeler qu'ils ne sont pas encore exploitables.")

//=====================================================================
// FENÊTRE D'ANALYSE — dépend UNIQUEMENT du timeframe courant du
// graphique (jamais d'un autre timeframe) :
//   Monthly -> 4 dernières années        4H  -> 25 derniers jours
//   Weekly  -> 2 dernières années        1H  -> 8 derniers jours
//   Daily   -> 6 derniers mois           M15 -> 12 dernières heures
//                                        M5  -> 12 dernières heures
//=====================================================================
f_lookbackMs() =>
    string tf = timeframe.period
    float oneDay = 24.0 * 60 * 60 * 1000
    float result =
         tf == "M"   ? 4 * 365 * oneDay :
         tf == "W"   ? 2 * 365 * oneDay :
         tf == "D"   ? 182 * oneDay :
         tf == "240" ? 25 * oneDay :
         tf == "60"  ? 8 * oneDay :
         tf == "15"  ? 0.5 * oneDay :
         tf == "5"   ? 0.5 * oneDay :
         timeframe.ismonthly ? 4 * 365 * oneDay :
         timeframe.isweekly  ? 2 * 365 * oneDay :
         timeframe.isdaily   ? 182 * oneDay :
         timeframe.isminutes and timeframe.multiplier >= 180 ? 25 * oneDay :
         timeframe.isminutes and timeframe.multiplier >= 45  ? 8 * oneDay :
         0.5 * oneDay
    result

bool inLookback = time >= (timenow - f_lookbackMs())

// Les Order Blocks, zones Supply/Demand et imbalances n'ont PAS besoin
// d'une fenêtre de récupération : ils ne naissent que sur une vraie
// cassure de structure (isStructHighBroken / isStructLowBroken), qui
// elle-même se déclenche uniquement sur l'action du prix, sans aucune
// dépendance au temps réel ni à bar_index. Chaque module a déjà sa
// propre limite (40 OB, N zones Supply/Demand par côté, N imbalances
// par côté) : aucune fenêtre externe n'est nécessaire.
//
// Une version précédente gatait leur création par `inLookback` (basé
// sur `timenow`, l'heure réelle serveur) : en arrivant tard sur un
// graphique, ou le week-end, la fenêtre glissante ne couvrait plus les
// bougies récentes et rien ne pouvait naître. Un correctif suivant a
// tenté un filtre par `last_bar_index` (en bougies) — mais en mode
// Replay, `last_bar_index` reste bloqué sur la VRAIE dernière bougie du
// graphique (aujourd'hui), pas sur le curseur du replay : dès qu'on
// rejoue une période un peu ancienne, l'écart dépasse la fenêtre et plus
// aucune zone ne se dessine, alors que les IDM (gérés via
// `barstate.islast`, qui lui suit correctement le replay) continuent de
// s'afficher normalement. D'où l'incohérence observée. La suppression
// pure et simple de toute fenêtre externe règle les deux cas à la fois.


//=====================================================================
// PIVOTS — ZIGZAG STRUCTUREL AUTO-CALIBRÉ (Auto) ou ta.pivothigh/
// pivotlow classique (Manuel) — moteur, toujours actif.
//=====================================================================
atrSniper = ta.atr(14) * sniperSize

bool  isFastTF   = timeframe.period == "5" or timeframe.period == "15"
float atrFast    = ta.atr(14)
// Declaré ICI et pas plus bas : plusieurs modules antérieurs au module
// Supply/Demand s'en servent (la Signature, notamment), et Pine exige
// qu'un identifiant existe avant sa première utilisation.
bool  atrReady   = not na(atrFast) and atrFast > 0

//=====================================================================
// OUTILS ANTI-ENCOMBREMENT — utilisés par TOUS les modules de zones.
//
//  f_zoneFar()  : la zone est-elle trop loin du prix pour être utile ?
//  f_zoneFade() : atténue la couleur en fonction de la distance au prix
//                 (net tout près, estompé au loin) — c'est ce qui permet
//                 à l'œil de trouver instantanément ce qui compte.
//
// La distance est mesurée depuis le BORD le plus proche de la zone, pas
// depuis son centre : une zone large que le prix effleure reste nette.
//=====================================================================
f_zoneDist(float zTop, float zBot) =>
    close > zTop ? close - zTop : close < zBot ? zBot - close : 0.0

f_zoneFar(float zTop, float zBot) =>
    bool res = false
    if useProxFilter and not na(atrFast) and atrFast > 0
        res := f_zoneDist(zTop, zBot) > atrFast * zoneMaxDist
    res

f_zoneFade(color c, float zTop, float zBot) =>
    color outCol = c
    if useHierarchy and not na(atrFast) and atrFast > 0
        float span  = atrFast * zoneMaxDist
        float ratio = math.min(f_zoneDist(zTop, zBot) / span, 1.0)
        int   baseT = int(color.t(c))
        outCol := color.new(c, math.min(baseT + int(ratio * (97 - baseT)), 97))
    outCol

float atrSlow    = ta.sma(atrFast, 100)
float volRatio   = atrSlow > 0 ? atrFast / atrSlow : 1.0
int   sensLevel  = volRatio >= 1.25 ? 3 : volRatio <= 0.85 ? 1 : 2
float zigzagMult = isFastTF ? (sensLevel == 1 ? 0.7 : sensLevel == 2 ? 1.0 : 1.5) : 1.5
float zigzagThresh = ta.atr(14) * zigzagMult

//---------------------------------------------------------------------
// ZIGZAG FIN — dédié UNIQUEMENT à l'IDM. Même mécanique que le zigzag
// structurel mais avec un seuil réduit : il capte les petits swings que
// la structure ignore, ce qui permet à l'IDM de se déplacer à CHAQUE
// cassure sans polluer la détection des vrais BOS/BMS.
//---------------------------------------------------------------------
float zzFineThresh = zigzagThresh * idmFineRatio

var int   zzfDir        = 1
var float zzfExtreme    = na
var int   zzfExtremeBar = na

float phFine = na
float plFine = na
var int phFineBar = na
var int plFineBar = na

if na(zzfExtreme)
    zzfExtreme := high
    zzfExtremeBar := bar_index

if not na(zzFineThresh) and zzFineThresh > 0
    if zzfDir == 1
        if high > zzfExtreme
            zzfExtreme := high
            zzfExtremeBar := bar_index
        if low <= zzfExtreme - zzFineThresh
            phFine := zzfExtreme
            phFineBar := zzfExtremeBar
            zzfDir := -1
            zzfExtreme := low
            zzfExtremeBar := bar_index
    else
        if low < zzfExtreme
            zzfExtreme := low
            zzfExtremeBar := bar_index
        if high >= zzfExtreme + zzFineThresh
            plFine := zzfExtreme
            plFineBar := zzfExtremeBar
            zzfDir := 1
            zzfExtreme := high
            zzfExtremeBar := bar_index

var int   zzDir        = 1
var float zzExtreme    = na
var int   zzExtremeBar = na

float phZig = na
float plZig = na
var int phZigBar = na
var int plZigBar = na

if na(zzExtreme)
    zzExtreme := high
    zzExtremeBar := bar_index

if not na(zigzagThresh)
    if zzDir == 1
        if high > zzExtreme
            zzExtreme := high
            zzExtremeBar := bar_index
        if low <= zzExtreme - zigzagThresh
            phZig := zzExtreme
            phZigBar := zzExtremeBar
            zzDir := -1
            zzExtreme := low
            zzExtremeBar := bar_index
    else
        if low < zzExtreme
            zzExtreme := low
            zzExtremeBar := bar_index
        if high >= zzExtreme + zigzagThresh
            plZig := zzExtreme
            plZigBar := zzExtremeBar
            zzDir := 1
            zzExtreme := high
            zzExtremeBar := bar_index

// Sensibilité MANUELLE : réglage classique par nombre de bougies,
// directement branché sur ta.pivothigh/pivotlow — appelées
// INCONDITIONNELLEMENT chaque bougie (obligatoire pour ces fonctions),
// seul le CHOIX entre ce résultat et le zigzag auto se fait juste
// après, selon pivMode.
float phManualRaw = ta.pivothigh(pivLenManual, pivLenManual)
float plManualRaw = ta.pivotlow(pivLenManual, pivLenManual)

float ph  = pivMode == "Manuel" ? phManualRaw : phZig
float pl  = pivMode == "Manuel" ? plManualRaw : plZig
int phBar = pivMode == "Manuel" ? (na(phManualRaw) ? na : bar_index[pivLenManual]) : phZigBar
int plBar = pivMode == "Manuel" ? (na(plManualRaw) ? na : bar_index[pivLenManual]) : plZigBar

// Pivots vus par l'IDM : les mêmes que la structure, SAUF si la
// détection fine est active (et hors mode Manuel, où tu règles déjà la
// sensibilité toi-même).
bool  idmUsesFine = idmFineDetect and pivMode != "Manuel"
float idmPh    = idmUsesFine ? phFine    : ph
float idmPl    = idmUsesFine ? plFine    : pl
int   idmPhBar = idmUsesFine ? phFineBar : phBar
int   idmPlBar = idmUsesFine ? plFineBar : plBar

var float lastPH = na
var float prevPH = na
var int lastPHBar = na

var float lastPL = na
var float prevPL = na
var int lastPLBar = na

// Liquidité Intact — les 4 derniers pivots hauts/bas CONFIRMÉS pas
// encore balayés, chacun de son côté (module 6). Un pivot est retiré
// dès qu'une bougie balaye son niveau (voir la purge plus bas) ; sinon,
// uniquement les 4 plus récents sont conservés par côté.
var float[] intactHighLevels = array.new_float()
var int[]   intactHighBars   = array.new_int()
var float[] intactLowLevels  = array.new_float()
var int[]   intactLowBars    = array.new_int()

//---------------------------------------------------------------------
// PLAFOND DES ÉTIQUETTES DE PIVOT (HH / HL / LH / LL)
//
// Ces étiquettes étaient créées à chaque pivot et JAMAIS supprimées. Sur
// un historique un peu long, ça fait des centaines d'étiquettes.
//
// Or TradingView plafonne à 500 étiquettes par script (max_labels_count,
// ligne 2) et, au-delà, supprime SILENCIEUSEMENT les plus anciennes. Les
// étiquettes "BOS" et "BMS" se faisaient donc évincer par TradingView
// avant même que le code ne les efface : d'où des cassures affichées
// sans leur nom, ou pas affichées du tout.
//
// On garde les 40 plus récentes, largement de quoi lire la structure à
// l'écran, et on rend les slots aux BOS/BMS.
//---------------------------------------------------------------------
var label[] pivotLbls = array.new_label()

f_capPivotLbl(label lb) =>
    array.push(pivotLbls, lb)
    // Plafond pilote par le reglage "Nombre de marquages conserves"
    // (groupe 01) : c'est lui qui evite que HH/HL/LH/LL saturent le
    // graphique ET la limite de 500 objets de TradingView.
    if array.size(pivotLbls) > maxPivotMarks
        label.delete(array.shift(pivotLbls))

if not na(ph) and inLookback
    prevPH := lastPH
    lastPH := ph
    lastPHBar := phBar

    array.push(intactHighLevels, ph)
    array.push(intactHighBars, phBar)
    if array.size(intactHighLevels) > 4
        array.shift(intactHighLevels)
        array.shift(intactHighBars)

    if showStruct and okStruct and lblAll
        string txt = na(prevPH) ? "H" : ph > prevPH ? "HH" : "LH"
        color col = na(prevPH) ? rangeCol : ph > prevPH ? bullCol : bearCol
        f_capPivotLbl(label.new(phBar, ph, txt,
             style=label.style_label_down,
             color=color.new(col, 80),
             textcolor=col,
             size=size.small))

if not na(pl) and inLookback
    prevPL := lastPL
    lastPL := pl
    lastPLBar := plBar

    array.push(intactLowLevels, pl)
    array.push(intactLowBars, plBar)
    if array.size(intactLowLevels) > 4
        array.shift(intactLowLevels)
        array.shift(intactLowBars)

    if showStruct and okStruct and lblAll
        string txt = na(prevPL) ? "L" : pl > prevPL ? "HL" : "LL"
        color col = na(prevPL) ? rangeCol : pl > prevPL ? bullCol : bearCol
        f_capPivotLbl(label.new(plBar, pl, txt,
             style=label.style_label_up,
             color=color.new(col, 80),
             textcolor=col,
             size=size.small))


//=====================================================================
// STRUCTURE + CASSURES BOS/BMS (moteur — toujours actif). Moteur fusionné
// depuis "SMC Structures and FVG" (LudoGH68) : bosHigh/bosLow suivis avec
// confirmation sur 3 bougies (ou clôture du corps si
// isStructBodyCandleBreak), extension automatique tant qu'aucune cassure
// n'a eu lieu. Un retournement (ex-CHoCH) est fast-track (pas d'attente
// des 3 bougies), une continuation (ex-BOS) attend la confirmation —
// exactement le moteur d'origine.
//   bias : 1 = haussier, -1 = baissier, 0 = pas encore de structure
//=====================================================================
var float bosHigh = na
var int   bosHighBar = na
var float bosLow = na
var int   bosLowBar = na
var float brokenHigh    = na
var int   brokenHighBar = na
var float brokenLow     = na
var int   brokenLowBar  = na
var int   bias = 0

var line[]  structLines       = array.new_line()
var label[] structLabels      = array.new_label()
var line    curStructHighLine = na
var line    curStructLowLine  = na

if bar_index == 0
    bosHighBar := bar_index
    bosLowBar  := bar_index
    bosHigh := high
    bosLow  := low

int structMaxBar = bar_index + f_structHighestBar(10)
int structMinBar = bar_index + f_structLowestBar(10)

float lowBreakPx  = isStructBodyCandleBreak ? close : low
float highBreakPx = isStructBodyCandleBreak ? close : high

bool isStructLowBroken =
     (lowBreakPx < bosLow and lowBreakPx[1] >= bosLow and lowBreakPx[2] >= bosLow and lowBreakPx[3] >= bosLow and
      bar_index[1] > bosLowBar and bar_index[2] > bosLowBar and bar_index[3] > bosLowBar) or
     (bias == 1 and lowBreakPx < bosLow)

bool isStructHighBroken =
     (highBreakPx > bosHigh and highBreakPx[1] <= bosHigh and highBreakPx[2] <= bosHigh and highBreakPx[3] <= bosHigh and
      bar_index[1] > bosHighBar and bar_index[2] > bosHighBar and bar_index[3] > bosHighBar) or
     (bias == -1 and highBreakPx > bosHigh)

bool bosBull   = false
bool bosBear   = false
bool chochBull = false
bool chochBear = false

if isStructLowBroken
    if array.size(structLines) >= structHistoryNbr
        line  oldSL = array.get(structLines, 0)
        label oldSB = array.get(structLabels, 0)
        if not na(oldSL)
            line.delete(oldSL)
        if not na(oldSB)
            label.delete(oldSB)
        array.remove(structLines, 0)
        array.remove(structLabels, 0)

    bool  isContinuation = bias == -1
    string evTxt = isContinuation ? "BMS" : "BOS"
    color  evCol = isContinuation ? bmsBearColor : bosBearColor

    line  evLnD = okBosLine ? line.new(bosLowBar, bosLow, bar_index, bosLow, xloc=xloc.bar_index, extend=extend.none,
         color=evCol, style=isContinuation ? bmsLineStyle : bosLineStyle, width=isContinuation ? bmsLineWidth : bosLineWidth) : na
    label evLbD = (okBosLine and lblEss) ? label.new(int(math.avg(bar_index, bosLowBar)), bosLow, text=evTxt, style=label.style_none, textcolor=evCol) : na
    array.push(structLines, evLnD)
    array.push(structLabels, evLbD)

    if isContinuation
        bosBear := true
    else
        chochBear := true

    brokenLow := bosLow
    brokenLowBar := bosLowBar

    bias := -1
    bosHighBar := structMaxBar
    bosLowBar  := bar_index
    bosHigh := high[bar_index - bosHighBar]
    bosLow  := low

else if isStructHighBroken
    if array.size(structLines) >= structHistoryNbr
        line  oldSL = array.get(structLines, 0)
        label oldSB = array.get(structLabels, 0)
        if not na(oldSL)
            line.delete(oldSL)
        if not na(oldSB)
            label.delete(oldSB)
        array.remove(structLines, 0)
        array.remove(structLabels, 0)

    bool  isContinuation = bias == 1
    string evTxt = isContinuation ? "BMS" : "BOS"
    color  evCol = isContinuation ? bmsBullColor : bosBullColor

    line  evLnU = okBosLine ? line.new(bosHighBar, bosHigh, bar_index, bosHigh, xloc=xloc.bar_index, extend=extend.none,
         color=evCol, style=isContinuation ? bmsLineStyle : bosLineStyle, width=isContinuation ? bmsLineWidth : bosLineWidth) : na
    label evLbU = (okBosLine and lblEss) ? label.new(int(math.avg(bar_index, bosHighBar)), bosHigh, text=evTxt, style=label.style_none, textcolor=evCol) : na
    array.push(structLines, evLnU)
    array.push(structLabels, evLbU)

    if isContinuation
        bosBull := true
    else
        chochBull := true

    brokenHigh := bosHigh
    brokenHighBar := bosHighBar

    bias := 1
    bosHighBar := bar_index
    bosLowBar  := structMinBar
    bosHigh := high
    bosLow  := low[bar_index - bosLowBar]

else
    if high > bosHigh and (bias == 0 or bias == 1)
        if not isStructBodyCandleBreak or not (bar_index[1] > bosHighBar and bar_index[2] > bosHighBar and bar_index[3] > bosHighBar)
            bosHigh := high
            bosHighBar := bar_index
    else if low < bosLow and (bias == 0 or bias == -1)
        if not isStructBodyCandleBreak or not (bar_index[1] > bosLowBar and bar_index[2] > bosLowBar and bar_index[3] > bosLowBar)
            bosLow := low
            bosLowBar := bar_index

// TENDANCE CONFIRMÉE — ne change JAMAIS sur un BMS de continuation ni sur
// une lecture de consolidation, seul un vrai BOS (retournement) la fait
// basculer. Pilote l'ancrage de bosHigh/bosLow, la Sniper Zone, la
// Liquidité Cible et la case "Acheteur/Vendeur maintenant".
var int confirmedTrend = 0

if chochBull
    confirmedTrend := 1
if chochBear
    confirmedTrend := -1

// Structure actuelle en cours (optionnel) — matérialise bosHigh/bosLow,
// les niveaux qui pilotent la Liquidité Cible et le repli du SL.
if showCurrentStruct and okCurStr
    if not na(curStructHighLine)
        line.delete(curStructHighLine)
    if not na(curStructLowLine)
        line.delete(curStructLowLine)
    curStructHighLine := line.new(bosHighBar, bosHigh, bar_index, bosHigh, xloc=xloc.bar_index,
         color=currentStructColor, style=currentStructLineStyle, width=currentStructLineWidth)
    curStructLowLine := line.new(bosLowBar, bosLow, bar_index, bosLow, xloc=xloc.bar_index,
         color=currentStructColor, style=currentStructLineStyle, width=currentStructLineWidth)

// STRUCTURE H1 — seule référence pour "Acheteur/Vendeur maintenant" et la
// Liquidité Cible : haussière -> acheteur (vise un Intact Seller),
// baissière -> vendeur (vise un Intact Buyer). Rien d'autre n'entre en
// compte, jamais le mélange avec la structure du chart courant.
// f_h1Bias() (sans dessin) au lieu de `bias` : `bias` est calculé dans le
// même bloc que les lignes BOS/BMS (line.new), ce que request.security
// refuse ou exécute mal — d'où le dashboard qui ne s'affichait plus.
int h1Bias = request.security(syminfo.tickerid, "60", f_h1Bias(), lookahead=barmerge.lookahead_off)


//=====================================================================
// LECTURE MULTI-TIMEFRAME pour l'IDM 3 — M5, M15 et H1.
//
// f_tfSwings() est une fonction PURE : aucun dessin (line.new / box.new)
// à l'intérieur. C'est obligatoire — request.security() refuse ou
// exécute mal une expression qui dépend d'objets de dessin.
//
// Elle renvoie, pour le timeframe demandé, le dernier creux et le
// dernier sommet de swing (même principe de zigzag ATR que le moteur du
// graphique courant, en version autonome).
//=====================================================================
f_tfSwings() =>
    float atrTf = ta.atr(14)
    float thTf  = atrTf * 1.5
    var int   dTf    = 1
    var float extTf  = na
    var float lastLo = na
    var float lastHi = na
    if na(extTf)
        extTf := high
    if not na(thTf) and thTf > 0
        if dTf == 1
            if high > extTf
                extTf := high
            if low <= extTf - thTf
                lastHi := extTf
                dTf    := -1
                extTf  := low
        else
            if low < extTf
                extTf := low
            if high >= extTf + thTf
                lastLo := extTf
                dTf    := 1
                extTf  := high
    [lastLo, lastHi]

[m5Lo,  m5Hi]  = request.security(syminfo.tickerid, "5",  f_tfSwings(), lookahead=barmerge.lookahead_off)
[m15Lo, m15Hi] = request.security(syminfo.tickerid, "15", f_tfSwings(), lookahead=barmerge.lookahead_off)
[h1Lo,  h1Hi]  = request.security(syminfo.tickerid, "60", f_tfSwings(), lookahead=barmerge.lookahead_off)


//=====================================================================
// AFFICHAGE — Zones de Liquidité (Intact), indépendant. Jusqu'à 4
// niveaux par côté, alimentés dans la section PIVOTS plus haut —
// aucune influence sur bosHigh/bosLow ni sur le moteur.
//=====================================================================
if array.size(intactHighLevels) > 0
    for idx = array.size(intactHighLevels) - 1 to 0
        if high >= array.get(intactHighLevels, idx)
            array.remove(intactHighLevels, idx)
            array.remove(intactHighBars, idx)

if array.size(intactLowLevels) > 0
    for idx = array.size(intactLowLevels) - 1 to 0
        if low <= array.get(intactLowLevels, idx)
            array.remove(intactLowLevels, idx)
            array.remove(intactLowBars, idx)

var line[]  intactHighLines = array.new_line()
var label[] intactHighLbls  = array.new_label()
var line[]  intactLowLines  = array.new_line()
var label[] intactLowLbls   = array.new_label()

if array.size(intactHighLines) > 0
    for idx = array.size(intactHighLines) - 1 to 0
        line.delete(array.get(intactHighLines, idx))
        label.delete(array.get(intactHighLbls, idx))
    array.clear(intactHighLines)
    array.clear(intactHighLbls)

if array.size(intactLowLines) > 0
    for idx = array.size(intactLowLines) - 1 to 0
        line.delete(array.get(intactLowLines, idx))
        label.delete(array.get(intactLowLbls, idx))
    array.clear(intactLowLines)
    array.clear(intactLowLbls)

if showIntact and okIntact
    if array.size(intactHighLevels) > 0
        for idx = 0 to array.size(intactHighLevels) - 1
            float lvlH = array.get(intactHighLevels, idx)
            int   barH = array.get(intactHighBars, idx)
            int   rankH = array.size(intactHighLevels) - idx
            string txtH = "Intact Sellers #" + str.tostring(rankH)
            if not f_zoneFar(lvlH, lvlH)
                array.push(intactHighLines, line.new(barH, lvlH, bar_index + zoneExt, lvlH,
                     color=f_zoneFade(intactSellCol, lvlH, lvlH), style=line.style_dashed, width=1))
            if lblAll
                array.push(intactHighLbls, label.new(bar_index + zoneExt, lvlH, txtH,
                     style=label.style_label_left, color=color.new(intactSellCol, 80),
                     textcolor=intactSellCol, size=size.small))

    if array.size(intactLowLevels) > 0
        for idx = 0 to array.size(intactLowLevels) - 1
            float lvlL = array.get(intactLowLevels, idx)
            int   barL = array.get(intactLowBars, idx)
            int   rankL = array.size(intactLowLevels) - idx
            string txtL = "Intact Buyers #" + str.tostring(rankL)
            if not f_zoneFar(lvlL, lvlL)
                array.push(intactLowLines, line.new(barL, lvlL, bar_index + zoneExt, lvlL,
                     color=f_zoneFade(intactBuyCol, lvlL, lvlL), style=line.style_dashed, width=1))
            if lblAll
                array.push(intactLowLbls, label.new(bar_index + zoneExt, lvlL, txtL,
                     style=label.style_label_left, color=color.new(intactBuyCol, 80),
                     textcolor=intactBuyCol, size=size.small))


//=====================================================================
// MOTEUR DE MOUVEMENT (moteur — toujours actif)
//
// Une cassure (BMS ou BOS) lance un mouvement. Le moteur suit son
// origine et son extrême pour calculer le niveau 0.5 — c'est ce 0.5 qui
// juge la validité du retracement, et c'est moveDir qui pilote l'IDM.
//=====================================================================
bool newMoveUp   = bosBull or chochBull
bool newMoveDown = bosBear or chochBear

var int moveDir = 0
var float moveOrigin = na
var int moveOriginBar = na
var float moveExtreme = na
var int moveExtremeBar = na
var float moveFib50 = na

bool extremeUpdated = false

if newMoveUp
    moveDir := 1
    moveOrigin := brokenHigh
    moveOriginBar := brokenHighBar
    moveExtreme := high
    moveExtremeBar := bar_index
    moveFib50 := (moveOrigin + moveExtreme) / 2.0
    extremeUpdated := true

if newMoveDown
    moveDir := -1
    moveOrigin := brokenLow
    moveOriginBar := brokenLowBar
    moveExtreme := low
    moveExtremeBar := bar_index
    moveFib50 := (moveOrigin + moveExtreme) / 2.0
    extremeUpdated := true

if moveDir == 1 and not newMoveUp and high > moveExtreme
    moveExtreme := high
    moveExtremeBar := bar_index
    moveFib50 := (moveOrigin + moveExtreme) / 2.0
    extremeUpdated := true

if moveDir == -1 and not newMoveDown and low < moveExtreme
    moveExtreme := low
    moveExtremeBar := bar_index
    moveFib50 := (moveOrigin + moveExtreme) / 2.0
    extremeUpdated := true


//=====================================================================
// LIQUIDITÉ CIBLE (lecture seule) — l'IDM n'est PAS la destination du
// prix, c'est l'étape où il se ravitaille avant de continuer sa route
// vers la vraie cible : la liquidité pas encore balayée. Réutilise
// bosHigh/bosLow (mêmes niveaux que les zones Intact) comme cible, mais
// la DIRECTION vient de h1Bias (structure H1) — TOUJOURS cohérente avec
// la case "Acheteur/Vendeur maintenant" : H1 haussier -> cible = Intact
// Seller (bosHigh), H1 baissier -> cible = Intact Buyer (bosLow).
// N'influence jamais idmLevel/idmDir/idmDone ni la Sniper Zone.
//=====================================================================
float targetLevel = na
bool  targetValid = false

if h1Bias == 1 and not na(bosHigh)
    targetLevel := bosHigh
    targetValid := true
if h1Bias == -1 and not na(bosLow)
    targetLevel := bosLow
    targetValid := true

float targetProgressPct = na
if targetValid and not na(moveOrigin) and targetLevel != moveOrigin
    targetProgressPct := (close - moveOrigin) / (targetLevel - moveOrigin) * 100
    targetProgressPct := math.max(0.0, math.min(100.0, targetProgressPct))

var line  targetLine = na
var label targetLbl  = na

if showLiquidityTarget and targetValid
    string targetTxt = "Cible liquidité " + str.tostring(targetLevel, format.mintick) +
         (na(targetProgressPct) ? "" : " (" + str.tostring(targetProgressPct, "#") + "% parcouru)")
    if na(targetLine)
        targetLine := line.new(bar_index, targetLevel, bar_index + zoneExt, targetLevel,
             color=targetCol, style=line.style_dashed, width=2)
        targetLbl := label.new(bar_index + zoneExt, targetLevel, targetTxt,
             style=label.style_label_left, color=color.new(targetCol, 80), textcolor=targetCol, size=size.small)
    else
        line.set_xy1(targetLine, bar_index, targetLevel)
        line.set_xy2(targetLine, bar_index + zoneExt, targetLevel)
        label.set_xy(targetLbl, bar_index + zoneExt, targetLevel)
        label.set_text(targetLbl, targetTxt)
else
    if not na(targetLine)
        line.delete(targetLine)
        targetLine := na
    if not na(targetLbl)
        label.delete(targetLbl)
        targetLbl := na

bool nearTargetNow  = targetValid and math.abs(close - targetLevel) <= ta.atr(14) * 0.15
bool enteredTargetZone = nearTargetNow and not nearTargetNow[1]


//=====================================================================
// LE 0.5 JUGE LE RETRACEMENT (moteur — toujours actif)
//
// validTest = le prix a déjà atteint le 0.5 dans le bon sens pendant ce
// mouvement — sert au dashboard et à candidateRetracementValid.
//=====================================================================
var bool validTest = false

if newMoveUp or newMoveDown
    validTest := false

if not extremeUpdated
    if moveDir == 1 and not na(moveFib50) and low <= moveFib50
        validTest := true
    if moveDir == -1 and not na(moveFib50) and high >= moveFib50
        validTest := true


//=====================================================================
// IDM — MOTEUR (toujours actif, indépendant de l'affichage)
//
//   Structure haussière -> IDM (IDBL) = dernier pivot BAS,
//                           obligatoirement SOUS moveExtreme
//   Structure baissière -> IDM (IDBR) = dernier pivot HAUT,
//                           obligatoirement AU-DESSUS de moveExtreme
//
// Chaque pivot opposé au mouvement CONFIRMÉ (moveDir) est un candidat
// IDM. Tant que l'IDM actif n'est pas récupéré, tout nouveau candidat
// le REMPLACE : l'ancien devient une FS historique. L'IDM se déplace,
// c'est normal — le dashboard suit toujours le plus récent aligné avec
// confirmedTrend (règle 80/20).
//=====================================================================
var float[]  idmLevel = array.new_float()
var int[]    idmDir   = array.new_int()
var bool[]   idmDone  = array.new_bool()
var string[] idmKind  = array.new_string()   // "IDM" ou "FS"
var line[]   idmLine  = array.new_line()     // peut contenir na si showIdmLines=false
var label[]  idmLbl   = array.new_label()    // peut contenir na si showIdmLines=false

// Sniper Zone — LE reteste précis, rattachée uniquement à l'IDM.
var box[] sniperZoneA = array.new_box()      // peut contenir na si showSniperZone=false

// LA SIGNATURE (module 17) — la mèche de la bougie qui prend l'argent.
// Pas strictement parallèle à idmLevel/sniperZoneA (une par récupération
// effective, pas une par IDM créé), donc gérée avec sa propre limite et
// ses propres tableaux d'accompagnement.
var box[]   sniperRefineBx = array.new_box()
var int[]   sigDirA = array.new_int()     // 1 = Demand, -1 = Supply
var int[]   sigBarA = array.new_int()     // bougie de la Signature

float idmCandidate    = na
int   idmCandidateBar = na

if moveDir == 1 and not na(idmPl) and idmPl < moveExtreme
    idmCandidate := idmPl
    idmCandidateBar := idmPlBar

if moveDir == -1 and not na(idmPh) and idmPh > moveExtreme
    idmCandidate := idmPh
    idmCandidateBar := idmPhBar

int nPrev = array.size(idmLevel)
float prevTopLevel = nPrev > 0 ? array.get(idmLevel, nPrev - 1) : na
int   prevTopDir   = nPrev > 0 ? array.get(idmDir, nPrev - 1) : 0
bool  prevTopDone  = nPrev > 0 ? array.get(idmDone, nPrev - 1) : true

//---------------------------------------------------------------------
// L'IDM NE SE FORME QUE SUR UNE FAUSSE STRUCTURE (< 0.5)
//
// Ta règle, mot pour mot : « le prix retrace ; s'il ne touche pas les
// 0.5 (Discount / Premium), ce n'est PAS un vrai retracement, c'est un
// piège — une Fausse Structure. L'IDM se place sur ce niveau, et à
// chaque nouvelle fausse structure il se déplace. »
//
// Donc :
//   • le creux du pullback est PLUS HAUT que le 0.5 (mouvement
//     haussier) -> le retracement a échoué -> FAUSSE STRUCTURE -> IDM ;
//   • le creux plonge SOUS le 0.5 -> c'est un vrai retracement, il n'y
//     a pas de piège à marquer -> AUCUN IDM n'est créé là.
//
// candidateRetracementValid vaut true quand le pullback A atteint le
// 0.5. La fausse structure, c'est exactement son contraire.
//
// Tant que le 0.5 n'est pas connu (moveFib50 na, tout début de
// mouvement), on n'a aucun moyen de juger : on laisse passer, sinon
// l'indicateur resterait muet au démarrage du graphique.
//---------------------------------------------------------------------
bool candidateRetracementValid =
     moveDir == 1 ? idmCandidate <= moveFib50 :
     moveDir == -1 ? idmCandidate >= moveFib50 : false

bool candidateIsFalseStructure =
     na(moveFib50) or na(idmCandidate) ? true : not candidateRetracementValid

bool newIDM =
     not na(idmCandidate) and
     candidateIsFalseStructure and
     (nPrev == 0 or idmCandidate != prevTopLevel or prevTopDir != moveDir)

bool isFS = newIDM and nPrev > 0 and not prevTopDone and prevTopDir == moveDir

//---------------------------------------------------------------------
// L'IDM QUI RESTE — celui qui se fige
//
// « L'IDM qui se forme en dernière position avant l'enclenchement du
// retracement reste figé sur son niveau et ne doit plus bouger jusqu'à
// ce que le prix vienne le récupérer. Entre-temps il peut continuer à
// afficher les autres IDM normalement, mais celui-là seul doit rester
// figé. »
//
// L'enclenchement du retracement, c'est le moment où le prix atteint
// enfin le 0.5 du mouvement : validTest bascule de false à true. À cet
// instant précis, l'IDM en tête de liste est le DERNIER piège posé
// avant le vrai retracement — c'est LUI qu'on gèle.
//
// Une fois gelé, son trait et son étiquette sortent des tableaux :
// plus aucun autre bloc ne peut les déplacer, les recolorer, les
// dégrader en FS ni les effacer. Le niveau lui-même reste dans
// idmLevel / idmDir / idmDone, donc il continue d'armer le déclencheur
// et de nourrir le dashboard exactement comme avant.
//
// Il n'est libéré que quand le prix vient RÉELLEMENT le récupérer :
// balayage, puis clôture qui reprend le niveau (au-dessus de l'IDBL,
// sous l'IDBR). Voir le bloc « LIBÉRATION DE L'IDM FIGÉ » plus bas.
//---------------------------------------------------------------------
var int   frozenIdx     = na
var line  frozenLn      = na
var label frozenLb      = na
var float frozenLvl     = na
var int   frozenDir     = 0
var int   frozenBar     = na
var int   frozenSweptBar = na

bool retraceEngaged = validTest and not validTest[1]

if retraceEngaged and na(frozenIdx) and nPrev > 0 and not prevTopDone
    frozenIdx  := nPrev - 1
    frozenLvl  := prevTopLevel
    frozenDir  := prevTopDir
    frozenBar  := bar_index
    frozenSweptBar := na

    // On PREND possession du trait et de l'étiquette : ils quittent les
    // tableaux (remplacés par na), donc plus rien d'autre ne les touche.
    frozenLn := array.get(idmLine, frozenIdx)
    frozenLb := array.get(idmLbl, frozenIdx)
    array.set(idmLine, frozenIdx, na)
    array.set(idmLbl, frozenIdx, na)

    // ATTENTION : on ne touche PAS à sa Sniper Zone. Elle reste dans
    // sniperZoneA, parce que c'est sa présence qui autorisera plus bas
    // la création de la SIGNATURE au moment du balayage (règle 80/20).
    // La lui retirer ici priverait de Signature l'IDM le plus important
    // de tous — précisément celui qu'on vient de geler.

    if not na(frozenLn)
        line.set_color(frozenLn, idmActiveCol)
        line.set_style(frozenLn, line.style_solid)
        line.set_width(frozenLn, idmWidthBoost)
    if not na(frozenLb)
        label.set_text(frozenLb, (frozenDir == 1 ? "▲" : "▼") + " IDM FIGÉ " +
             str.tostring(frozenLvl, format.mintick))
        label.set_color(frozenLb, color.new(idmActiveCol, 25))
        label.set_textcolor(frozenLb, color.white)

if newIDM

    array.push(idmLevel, idmCandidate)
    array.push(idmDir, moveDir)
    array.push(idmDone, false)
    array.push(idmKind, "IDM")

    line ln = na
    label lb = na
    if showIdmLines
        // Étiquette : direction + niveau exact, pour localiser l'IDM
        // instantanément. "•0.5" = retracement déjà validé.
        string idmArrow = moveDir == 1 ? "▲" : "▼"
        string idmTxt0 = idmEmphasis ?
             idmArrow + " IDM 1 " + str.tostring(idmCandidate, format.mintick) + (candidateRetracementValid ? " •0.5" : "") :
             (candidateRetracementValid ? "IDM 1 •0.5" : "IDM 1")
        ln := line.new(idmCandidateBar, idmCandidate, bar_index + 1, idmCandidate,
             color=idmActiveCol,
             style=idmEmphasis ? line.style_solid : line.style_dotted,
             width=idmEmphasis ? idmWidthBoost : 3)
        lb := lblNone ? na : label.new(bar_index + 1, idmCandidate, idmTxt0,
             style=label.style_label_left,
             color=color.new(idmActiveCol, idmEmphasis ? 40 : 75),
             textcolor=idmEmphasis ? color.white : idmActiveCol,
             size=idmEmphasis ? size.normal : size.small)
    array.push(idmLine, ln)
    array.push(idmLbl, lb)

    // Règle 80/20 : tendance confirmée haussière -> uniquement des
    // achats, confirmée baissière -> uniquement des ventes. N'affecte
    // que le DESSIN de la Sniper Zone, jamais idmLevel/idmDir/idmDone
    // ni la détection de récupération.
    bool dirAllowed = confirmedTrend == 0 or confirmedTrend == moveDir

    box sn = na
    if showSniperZone and dirAllowed
        sn := box.new(idmCandidateBar, idmCandidate + atrSniper, bar_index + zoneExt, idmCandidate - atrSniper,
             border_color=sniperCol,
             border_width=2,
             bgcolor=color.new(sniperCol, 85),
             text="Sniper Zone",
             text_color=sniperCol,
             text_size=size.tiny,
             text_halign=text.align_left)
    array.push(sniperZoneA, sn)

    int n = array.size(idmLevel)

    // AFFICHAGE DE L'IDM 2 : SUPPRIMÉ.
    //
    // Il ne s'agit pas d'une case à décocher — le code qui traçait
    // l'« IDM 2 » (recolorisation en orange, renommage de l'étiquette,
    // Sniper Zone secondaire) a été retiré. Dès qu'un IDM passe en 2e
    // position, son trait et son étiquette sont EFFACÉS.
    //
    // L'institutionnel vise la PREMIÈRE vraie poche de liquidité. Les
    // suivantes ne sont que du bruit sur le graphique. Le niveau, lui,
    // reste dans les tableaux : toujours surveillé, toujours
    // récupérable, toujours lisible dans le dashboard.
    //
    // Exception : l'IDM FIGÉ. Ses objets ont déjà quitté les tableaux
    // (remplacés par na), donc ce bloc ne peut pas les atteindre — il
    // reste affiché tant que le prix n'est pas venu le récupérer.
    if n >= 2 and not array.get(idmDone, n - 2)
        line lnD2 = array.get(idmLine, n - 2)
        if not na(lnD2)
            line.delete(lnD2)
            array.set(idmLine, n - 2, na)
        label lbD2 = array.get(idmLbl, n - 2)
        if not na(lbD2)
            label.delete(lbD2)
            array.set(idmLbl, n - 2, na)

    // Celui qui sort du top 2 devient une FS. Si showFsHistory est
    // actif, on la fige en gris (jamais supprimée). Sinon (par défaut),
    // on la supprime directement pour garder le graphique lisible.
    if n >= 3 and not array.get(idmDone, n - 3) and (na(frozenIdx) or frozenIdx != n - 3)
        array.set(idmKind, n - 3, "FS")
        line ln3 = array.get(idmLine, n - 3)
        label lb3 = array.get(idmLbl, n - 3)
        box sz3 = array.get(sniperZoneA, n - 3)
        if showFsHistory
            if not na(ln3)
                line.set_x2(ln3, idmCandidateBar)
                line.set_color(ln3, color.new(fsCol, 55))
                line.set_width(ln3, 1)
            if not na(lb3)
                label.set_text(lb3, "FS")
                label.set_xy(lb3, idmCandidateBar, array.get(idmLevel, n - 3))
                label.set_color(lb3, color.new(fsCol, 80))
                label.set_textcolor(lb3, fsCol)
            if not na(sz3)
                box.set_right(sz3, idmCandidateBar)
                box.set_border_color(sz3, color.new(fsCol, 60))
                box.set_bgcolor(sz3, color.new(fsCol, 94))
                box.set_text(sz3, "")
        else
            // Suppression + remise a na des trois slots : un identifiant
            // detruit laisse dans le tableau fait planter toute
            // relecture ulterieure.
            if not na(ln3)
                line.delete(ln3)
                array.set(idmLine, n - 3, na)
            if not na(lb3)
                label.delete(lb3)
                array.set(idmLbl, n - 3, na)
            if not na(sz3)
                box.delete(sz3)
                array.set(sniperZoneA, n - 3, na)


// Prolongation des DEUX plus récents tant qu'ils ne sont pas recouverts.
int nNow = array.size(idmLevel)

if nNow > 0
    int topIdx = nNow - 1
    if not array.get(idmDone, topIdx)
        line lnTop = array.get(idmLine, topIdx)
        if not na(lnTop)
            line.set_x2(lnTop, bar_index + 1)
        label lbTop = array.get(idmLbl, topIdx)
        if not na(lbTop)
            label.set_xy(lbTop, bar_index + 1, array.get(idmLevel, topIdx))
        box szTop = array.get(sniperZoneA, topIdx)
        if not na(szTop)
            box.set_right(szTop, bar_index + zoneExt)

if nNow > 1
    int secIdx = nNow - 2
    if not array.get(idmDone, secIdx)
        line lnSec = array.get(idmLine, secIdx)
        if not na(lnSec)
            line.set_x2(lnSec, bar_index + 1)
        label lbSec = array.get(idmLbl, secIdx)
        if not na(lbSec)
            label.set_xy(lbSec, bar_index + 1, array.get(idmLevel, secIdx))
        box szSec = array.get(sniperZoneA, secIdx)
        if not na(szSec)
            box.set_right(szSec, bar_index + zoneExt)


//=====================================================================
// ALERTES — zones de prédilection (lecture seule de la Sniper Zone du
// plus récent IDM actif). Calculées à chaque bougie (pas seulement
// barstate.islast) pour qu'alertcondition() détecte l'ENTRÉE dans la
// zone, pas juste "être dedans" en continu.
//=====================================================================
bool inSniperNow = false

// Garde supplementaire `not idmDone` : un IDM deja recupere a vu sa
// Sniper Zone supprimee. On ne relit jamais la boite d'un IDM inactif.
if nNow > 0 and not array.get(idmDone, nNow - 1)
    box topSniperA = array.get(sniperZoneA, nNow - 1)
    if not na(topSniperA)
        float tsTop = box.get_top(topSniperA)
        float tsBot = box.get_bottom(topSniperA)
        if close <= tsTop and close >= tsBot
            inSniperNow := true

bool enteredSniperZone = inSniperNow and not inSniperNow[1]


//=====================================================================
// ZONE IDM POUR LE GBB — calculé ICI, et surtout PAS plus bas.
//
// Un setup GBB ne peut tirer que si le prix touche la zone d'un IDM
// encore actif, dans le sens de cet IDM :
//   IDM haussier (IDBL) touché -> les setups ACHAT sont autorisés
//   IDM baissier (IDBR) touché -> les setups VENTE sont autorisés
//
// POURQUOI ICI ET PAS DANS LE BLOC GBB : la section juste en dessous
// marque `idmDone = true` DÈS que le prix touche l'IDM. Si ce test était
// placé dans le bloc GBB (bien plus bas dans le script), l'IDM que le
// prix est en train de toucher serait déjà classé "récupéré", donc exclu
// par la condition `not idmDone` — et la zone ne serait JAMAIS vraie au
// moment qui compte. Les setups GBB ne tiraient donc pratiquement jamais.
//
// Calculé ici, idmDone est encore dans son état d'AVANT la récupération :
// l'IDM touché est bien reconnu comme actif.
//
// La largeur de la bande est atrSniper, exactement la demi-épaisseur de
// ta Sniper Zone (module 3). On LIT idmLevel / idmDir / idmDone sans
// jamais y écrire : les deux moteurs restent séparés.
//=====================================================================
bool gbbIdmZoneBull = false
bool gbbIdmZoneBear = false

if array.size(idmLevel) > 0 and not na(atrSniper)
    for gi = array.size(idmLevel) - 1 to 0
        if not array.get(idmDone, gi)
            float gLvl = array.get(idmLevel, gi)
            // La bougie touche-t-elle la bande [niveau - atrSniper ; niveau + atrSniper] ?
            if low <= gLvl + atrSniper and high >= gLvl - atrSniper
                if array.get(idmDir, gi) == 1
                    gbbIdmZoneBull := true
                else
                    gbbIdmZoneBear := true


//=====================================================================
// RÉCUPÉRATION DE L'IDM (moteur — toujours actif)
//
// Vérifiée pour TOUS les IDM encore actifs, même les anciens FS. Les
// DEUX plus récents déclenchent le vrai signal d'entrée dès que le prix
// revient les chercher. Un ancien FS (position 3+) retesté plus tard ne
// déclenche jamais de signal, juste un marquage "✓" informatif.
//
// Point critique : si l'IDM est repris MAIS que, sur la même bougie, le
// prix casse réellement la structure dans le sens opposé, ce n'est PAS
// une continuation — c'est un BOS (retournement). Aucun signal d'entrée émis.
//=====================================================================
bool entrySignalBuy   = false
bool entrySignalSell  = false
bool signalBlockedByChoch = false

// Niveau de l'IDM qui vient d'être récupéré : c'est le point
// d'invalidation réel du setup, donc l'ancrage naturel du stop dans le
// module 13. Uniquement mémorisé ici, jamais utilisé par le moteur.
var float entryIdmLvl = na

// ÉTAT D'ARMEMENT (module 16). La récupération de l'IDM remplit ces
// variables ; c'est le bloc DÉCLENCHEUR, juste après, qui décide de
// tirer ou d'attendre.
var int   armDir  = 0     // 1 = achat armé, -1 = vente armée, 0 = rien
var float armLvl  = na    // niveau de l'IDM balayé
var int   armBar  = na    // bougie du balayage
var bool  armDeep = false // le 0.5 du mouvement a-t-il été franchi depuis ?

if array.size(idmLevel) > 0
    for i = array.size(idmLevel) - 1 to 0
        if not array.get(idmDone, i)
            float lvl = array.get(idmLevel, i)
            int   dir = array.get(idmDir, i)
            bool recovered = (dir == 1 and low <= lvl) or (dir == -1 and high >= lvl)

            if recovered
                array.set(idmDone, i, true)

                // L'IDM FIGÉ est éligible à l'entrée QUEL QUE SOIT son
                // rang. C'est tout l'intérêt de l'avoir gelé : c'est le
                // dernier piège posé avant le vrai retracement, donc le
                // niveau sur lequel tu veux entrer. Même s'il a glissé
                // en 3e position derrière des IDM plus récents, son
                // balayage arme le setup.
                bool isTopTwo       = i >= array.size(idmLevel) - 2 or
                     (not na(frozenIdx) and i == frozenIdx)
                bool blockedByChoch = (dir == 1 and chochBear) or (dir == -1 and chochBull)

                // Sniper Zone : dès que le prix part RÉELLEMENT pour le
                // mouvement, on la supprime immédiatement.
                //
                // ET ON REMET LE SLOT À na. C'est OBLIGATOIRE : après
                // box.delete(), la case du tableau contient encore
                // l'identifiant d'un objet qui n'existe plus. Toute
                // relecture ultérieure (box.get_top, box.set_right...)
                // déclenche une erreur d'exécution, et TradingView efface
                // alors TOUT le dessin de l'indicateur.
                box szr = array.get(sniperZoneA, i)
                bool szrWasDrawn = not na(szr)
                if szrWasDrawn
                    box.delete(szr)
                    array.set(sniperZoneA, i, na)

                // LA SIGNATURE — la bougie qui prend l'argent (module 17)
                //
                // CETTE bougie-ci est allée chercher la liquidité au-delà
                // de l'IDM. Ce n'est plus une bande ATR calculée autour
                // du niveau : la zone est posée sur SA MÈCHE RÉELLE,
                // celle qui a fait le balayage. C'est la vraie zone de
                // Demand (achat) / Supply (vente) — plus exacte qu'un
                // Order Block, qui ne fait que l'approcher.
                //
                // CONCEPT BIS. La zone d'achat est TOUJOURS sous l'IDBL,
                // la zone de vente TOUJOURS au-dessus de l'IDBR :
                //   achat -> du plus bas de la mèche (low) jusqu'au
                //            niveau de l'IDM, plafonnée par lvl ;
                //   vente -> du niveau de l'IDM jusqu'au plus haut de la
                //            mèche (high), plancher à lvl.
                // Jamais l'inverse : la zone ne déborde pas du bon côté.
                //
                // Le corps sert de borne intérieure quand il est déjà du
                // bon côté : on garde la mèche seule, pas la bougie
                // entière, parce que c'est la mèche qui a pris l'argent.
                if showSniperRefine and okRefine and isTopTwo and not blockedByChoch and szrWasDrawn
                    float sigPad = atrReady ? atrFast * sigPadAtr : 0.0
                    float sigTop = na
                    float sigBot = na

                    if dir == 1
                        // Achat : la zone tient SOUS l'IDBL.
                        float bodyLo = math.min(open, close)
                        sigTop := math.min(lvl, math.max(bodyLo, low)) + sigPad
                        sigBot := low - sigPad
                    else
                        // Vente : la zone tient AU-DESSUS de l'IDBR.
                        float bodyHi = math.max(open, close)
                        sigBot := math.max(lvl, math.min(bodyHi, high)) - sigPad
                        sigTop := high + sigPad

                    if not na(sigTop) and not na(sigBot) and sigTop > sigBot
                        array.push(sniperRefineBx, box.new(bar_index, sigTop, bar_index + zoneExt, sigBot,
                             border_color=refineCol, border_width=2,
                             bgcolor=color.new(refineCol, 70),
                             text=(dir == 1 ? "SIGNATURE — Demand" : "SIGNATURE — Supply"),
                             text_color=refineCol,
                             text_size=size.tiny, text_halign=text.align_left))
                        array.push(sigDirA, dir)
                        array.push(sigBarA, bar_index)
                        if array.size(sniperRefineBx) > 15
                            box.delete(array.shift(sniperRefineBx))
                            array.shift(sigDirA)
                            array.shift(sigBarA)

                line lnr = array.get(idmLine, i)
                label lbr = array.get(idmLbl, i)

                if isTopTwo and not blockedByChoch
                    // Même règle que pour la Sniper Zone : on supprime,
                    // ET on remet le slot à na. Sans ça le tableau garde
                    // l'identifiant d'un trait détruit, et la moindre
                    // relecture fait planter le script.
                    if not na(lnr)
                        line.delete(lnr)
                        array.set(idmLine, i, na)
                    if not na(lbr)
                        label.delete(lbr)
                        array.set(idmLbl, i, na)

                    entryIdmLvl := lvl
                    // Le balayage de l'IDM ARME le setup. Il ne l'ouvre
                    // plus : sans preuve que la zone est défendue, rien
                    // ne dit que le retracement est terminé.
                    armDir  := dir
                    armLvl  := lvl
                    armBar  := bar_index
                    armDeep := false
                    // Déclencheur désactivé -> comportement d'origine,
                    // entrée immédiate au contact.
                    if not useTrigger
                        if dir == 1
                            entrySignalBuy := true
                        else
                            entrySignalSell := true
                else
                    if isTopTwo and blockedByChoch
                        signalBlockedByChoch := true
                    string doneTxt = isTopTwo and blockedByChoch ?
                         array.get(idmKind, i) + " ✓ (BOS)" :
                         array.get(idmKind, i) + " ✓"

                    if not na(lnr)
                        line.set_x2(lnr, bar_index)
                        line.set_color(lnr, color.new(idmDoneCol, 40))
                    if not na(lbr)
                        label.set_text(lbr, doneTxt)
                        label.set_xy(lbr, bar_index, lvl)
                        label.set_color(lbr, color.new(idmDoneCol, 75))
                        label.set_textcolor(lbr, idmDoneCol)


//=====================================================================
// DÉCLENCHEUR D'ENTRÉE (module 16) — la fin du retracement se PROUVE
//
// Trois conditions, dans cet ordre :
//
//  1. BALAYAGE — déjà fait : c'est l'armement ci-dessus. Le prix est
//     allé CHERCHER la liquidité au-delà de l'IDM (sous l'IDBL à
//     l'achat, au-dessus de l'IDBR à la vente). Sans prise de
//     liquidité, aucun rallye ne démarre.
//
//  2. PROFONDEUR — le prix doit avoir franchi le 0.5 du mouvement. Un
//     retracement qui n'atteint pas le 0.5 n'est pas un vrai pullback,
//     c'est un piège. C'est ce filtre qui élimine le plus de faux
//     signaux.
//
//  3. REJET — une bougie doit prouver que la zone est DÉFENDUE :
//       • mèche de rejet : la mèche perce l'IDM, le corps clôture du
//         bon côté, la mèche fait au moins trigPinRatio de la bougie,
//         et la clôture tient dans la bonne moitié ;
//       • englobante : la bougie avale la précédente et clôture
//         au-delà d'elle, du bon côté de l'IDM.
//
// Tant que les trois ne sont pas réunies, le setup reste ARMÉ. Il se
// désarme si la structure s'inverse, ou après trigMaxBars sans preuve.
//=====================================================================
bool trigFired  = false
bool trigArmed  = false
bool trigExpired = false

if useTrigger and armDir != 0
    // --- 2. profondeur : le 0.5 a-t-il été franchi depuis l'armement ?
    if not na(moveFib50)
        if armDir == 1 and low <= moveFib50
            armDeep := true
        if armDir == -1 and high >= moveFib50
            armDeep := true

    // --- 3. rejet
    float trRng = high - low
    float trUpW = high - math.max(close, open)
    float trDnW = math.min(close, open) - low

    // Mèche de rejet : perce l'IDM, revient clôturer au-dessus, longue
    // mèche, et clôture dans la moitié haute de la bougie.
    bool pinBull = trRng > 0 and low < armLvl and close > armLvl and
         trDnW >= trRng * trigPinRatio and (close - low) >= trRng * 0.5
    bool pinBear = trRng > 0 and high > armLvl and close < armLvl and
         trUpW >= trRng * trigPinRatio and (high - close) >= trRng * 0.5

    // Englobante : avale la bougie précédente et clôture du bon côté.
    bool engBull = trigAllowEngulf and close > open and close > high[1] and close > armLvl
    bool engBear = trigAllowEngulf and close < open and close < low[1]  and close < armLvl

    bool deepOk = not trigNeedDeep or armDeep

    if armDir == 1 and deepOk and (pinBull or engBull)
        entrySignalBuy := true
        entryIdmLvl    := armLvl
        trigFired      := true
        armDir         := 0
    else if armDir == -1 and deepOk and (pinBear or engBear)
        entrySignalSell := true
        entryIdmLvl     := armLvl
        trigFired       := true
        armDir          := 0
    else
        // Désarmement : la structure s'est inversée, ou le marché n'a
        // rien défendu dans le délai imparti.
        bool armFlip = (armDir == 1 and chochBear) or (armDir == -1 and chochBull)
        if armFlip or (not na(armBar) and bar_index - armBar > trigMaxBars)
            armDir      := 0
            trigExpired := true
        else
            trigArmed := true


//=====================================================================
// L'IDM FIGÉ — entretien et libération
//
// Tant qu'il est gelé, son trait avance avec le prix mais son NIVEAU ne
// bouge jamais. Aucun nouvel IDM ne peut le remplacer, le dégrader en
// FS ni l'effacer : ses objets ont quitté les tableaux au moment du gel.
// Les autres IDM continuent de s'afficher normalement à côté.
//
// Il n'est libéré que quand le prix est VENU LE RÉCUPÉRER pour de bon,
// c'est-à-dire les deux étapes, dans l'ordre :
//   1. BALAYAGE — le prix passe au-delà du niveau (idmDone bascule) ;
//   2. REPRISE  — une bougie SUIVANTE clôture de l'autre côté : au
//      dessus de l'IDBL à l'achat, sous l'IDBR à la vente.
// Tant que la reprise n'a pas eu lieu, le niveau reste affiché : c'est
// exactement le prix auquel tu veux entrer, il ne doit pas disparaître
// sous tes yeux au moment du balayage.
//
// Garde-fou : au-delà de 200 bougies sans reprise, la thèse est morte
// et la ligne est retirée pour ne pas encombrer le graphique.
//=====================================================================
if not na(frozenIdx)
    // Le balayage a-t-il eu lieu ? (mémorisé une seule fois)
    if frozenIdx < array.size(idmDone) and array.get(idmDone, frozenIdx) and na(frozenSweptBar)
        frozenSweptBar := bar_index
        if not na(frozenLb)
            label.set_text(frozenLb, (frozenDir == 1 ? "▲" : "▼") + " IDM FIGÉ ✦ balayé " +
                 str.tostring(frozenLvl, format.mintick))

    // Le trait suit le prix, le niveau ne bouge pas.
    if not na(frozenLn)
        line.set_x2(frozenLn, bar_index + 1)
    if not na(frozenLb)
        label.set_xy(frozenLb, bar_index + 1, frozenLvl)

    bool frozenReclaimed = not na(frozenSweptBar) and bar_index > frozenSweptBar and
         (frozenDir == 1 ? close > frozenLvl : close < frozenLvl)
    bool frozenStale = not na(frozenBar) and bar_index - frozenBar > 200

    if frozenReclaimed or frozenStale
        line.delete(frozenLn)
        label.delete(frozenLb)
        frozenLn  := na
        frozenLb  := na
        frozenIdx := na
        frozenLvl := na
        frozenDir := 0
        frozenBar := na
        frozenSweptBar := na


//=====================================================================
// LA SIGNATURE — entretien
//
// Le bord droit suit le prix, comme toutes tes zones (jamais
// extend.right). Une Signature meurt quand elle a fait son travail ou
// quand elle a été traversée :
//   • Demand : le prix clôture SOUS le bas de la mèche -> invalidée ;
//   • Supply : le prix clôture AU-DESSUS du haut de la mèche -> idem ;
//   • plus de sigKeepBars bougies sans réaction -> périmée.
//=====================================================================
if array.size(sniperRefineBx) > 0
    for si = array.size(sniperRefineBx) - 1 to 0
        box sgB = array.get(sniperRefineBx, si)
        bool sgDrop = false
        if na(sgB)
            sgDrop := true
        else
            float sgT = box.get_top(sgB)
            float sgB2 = box.get_bottom(sgB)
            int   sgD = array.get(sigDirA, si)
            int   sgBar = array.get(sigBarA, si)
            if sgD == 1 and close < sgB2
                sgDrop := true
            else if sgD == -1 and close > sgT
                sgDrop := true
            else if bar_index - sgBar > sigKeepBars
                sgDrop := true
            else
                box.set_right(sgB, bar_index + zoneExt)
        if sgDrop
            if not na(sgB)
                box.delete(sgB)
            array.remove(sniperRefineBx, si)
            array.remove(sigDirA, si)
            array.remove(sigBarA, si)

// Le prix est-il DANS une Signature en ce moment ? Sert au dashboard et
// au score de confluence — la Signature remplace l'Order Block comme
// vraie zone d'offre / demande.
int sigZoneDir = 0
if array.size(sniperRefineBx) > 0
    for si = array.size(sniperRefineBx) - 1 to 0
        if sigZoneDir == 0
            box sgB = array.get(sniperRefineBx, si)
            if not na(sgB) and close <= box.get_top(sgB) and close >= box.get_bottom(sgB)
                sigZoneDir := array.get(sigDirA, si)


// limitation historique — 8 tableaux liés, on garde tout synchronisé
if array.size(idmLevel) > maxHistory
    line oldLn = array.shift(idmLine)
    if not na(oldLn)
        line.delete(oldLn)
    label oldLb = array.shift(idmLbl)
    if not na(oldLb)
        label.delete(oldLb)
    box oldSz = array.shift(sniperZoneA)
    if not na(oldSz)
        box.delete(oldSz)
    array.shift(idmLevel)
    array.shift(idmDir)
    array.shift(idmDone)
    array.shift(idmKind)
    // L'IDM figé glisse d'un cran vers la gauche. S'il tombe hors du
    // tableau, on relâche le gel proprement.
    if not na(frozenIdx)
        frozenIdx := frozenIdx - 1
        if frozenIdx < 0
            line.delete(frozenLn)
            label.delete(frozenLb)
            frozenLn  := na
            frozenLb  := na
            frozenIdx := na
            frozenLvl := na
            frozenDir := 0
            frozenBar := na
            frozenSweptBar := na


//=====================================================================
// ORDER BLOCKS + BREAKER BLOCKS (module 8)
//
// Logique de détection adaptée de "Order Blocks & Breaker Blocks"
// (© LuxAlgo, CC BY-NC-SA 4.0) — usage personnel non commercial.
//
// ADAPTATIONS SMV (ce n'est PAS une simple copie) :
//
//  1. Le déclencheur n'est plus le swing interne de LuxAlgo, mais TON
//     moteur de structure : un OB naît uniquement quand isStructHighBroken
//     / isStructLowBroken déclenche un vrai BOS/BMS. "Un Order Block
//     valide doit obligatoirement provoquer une vraie cassure de
//     structure" — c'est exactement ta règle.
//
//  2. La recherche remonte jusqu'au niveau RÉELLEMENT cassé
//     (brokenHighBar / brokenLowBar), pas jusqu'à un swing indépendant.
//
//  3. Confluence IDM (★) : un OB qui contient un IDM encore actif est
//     signalé. C'est LA confluence SMV — le niveau où tu attends déjà le
//     prix est aussi celui où les institutionnels ont laissé leur trace.
//
//  4. Déséquilibre FVG (⚡) signalé, comme tu l'as décrit.
//
//  5. Filtre 80/20 optionnel sur confirmedTrend.
//
//  6. IMPORTANT — LuxAlgo fait "for bx in box.all : bx.delete()", ce qui
//     effacerait TES Sniper Zones, tes phases et tes zones Supply/Demand.
//     Ici on ne supprime QUE nos propres objets, stockés dans des
//     tableaux dédiés.
//
// Breaker Block : quand le prix casse vraiment à travers un OB, celui-ci
// a échoué et change de polarité (un OB haussier cassé devient une
// résistance). Confirmation forte pour la SMV.
//=====================================================================
float obMax = obUseBody ? math.max(close, open) : high
float obMin = obUseBody ? math.min(close, open) : low

var float[] obTopA    = array.new_float()
var float[] obBtmA    = array.new_float()
var int[]   obLocA    = array.new_int()
var int[]   obDirA    = array.new_int()      // 1 = OB haussier, -1 = OB baissier
var bool[]  obBrkA    = array.new_bool()     // devenu Breaker Block ?
var int[]   obBrkLocA = array.new_int()
var bool[]  obFvgA    = array.new_bool()
var bool[]  obIdmA    = array.new_bool()     // confluence avec un IDM actif
var bool[]  obMitA    = array.new_bool()     // déjà mitigé (le prix y est revenu) ?

// Objets dessinés — on ne touche JAMAIS à box.all / line.all.
var box[]   obDrawBox = array.new_box()
var line[]  obDrawLn  = array.new_line()
var label[] obDrawLbl = array.new_label()

bool obStructBroke = isStructHighBroken or isStructLowBroken
// Même priorité que le moteur de structure plus haut (if / else if).
bool obBreakBull   = obStructBroke and not isStructLowBroken

// Distance à remonter : jusqu'au niveau réellement cassé, borné à 50
// bougies pour garder un buffer d'historique raisonnable.
int obOriginBar = obBreakBull ? brokenHighBar : brokenLowBar
int obScanLen   = obStructBroke and not na(obOriginBar) ? math.min(math.max(bar_index - obOriginBar, 1), 50) : 0

if showOB and obStructBroke and obScanLen > 0
    float minima = obMin[1]
    float maxima = obMax[1]
    int   locOff = 1

    if obBreakBull
        // Bougie du plus bas creux avant l'impulsion haussière.
        for i = 1 to obScanLen
            if obMin[i] < minima
                minima := obMin[i]
                maxima := obMax[i]
                locOff := i
    else
        // Bougie du plus haut sommet avant l'impulsion baissière.
        for i = 1 to obScanLen
            if obMax[i] > maxima
                maxima := obMax[i]
                minima := obMin[i]
                locOff := i

    if not na(minima) and not na(maxima) and maxima >= minima
        // Déséquilibre (FVG) laissé par l'impulsion qui part de l'OB.
        bool obHasFvg = false
        if obShowFvg and locOff >= 2
            obHasFvg := obBreakBull ? (low[locOff - 2] > high[locOff]) : (high[locOff - 2] < low[locOff])

        // Confluence SMV : un IDM encore actif tombe-t-il dans l'OB ?
        bool obHasIdm = false
        if obShowIdmConfluence and array.size(idmLevel) > 0
            for j = array.size(idmLevel) - 1 to 0
                if not obHasIdm and not array.get(idmDone, j)
                    float idmLv = array.get(idmLevel, j)
                    if idmLv <= maxima and idmLv >= minima
                        obHasIdm := true

        array.unshift(obTopA, maxima)
        array.unshift(obBtmA, minima)
        array.unshift(obLocA, bar_index - locOff)
        array.unshift(obDirA, obBreakBull ? 1 : -1)
        array.unshift(obBrkA, false)
        array.unshift(obBrkLocA, 0)
        array.unshift(obFvgA, obHasFvg)
        array.unshift(obIdmA, obHasIdm)
        array.unshift(obMitA, false)

        // Limite d'historique (les plus anciens tombent).
        if array.size(obTopA) > 40
            array.pop(obTopA)
            array.pop(obBtmA)
            array.pop(obLocA)
            array.pop(obDirA)
            array.pop(obBrkA)
            array.pop(obBrkLocA)
            array.pop(obFvgA)
            array.pop(obIdmA)
            array.pop(obMitA)

// Passage en Breaker Block, puis suppression définitive quand le prix
// dépasse franchement le Breaker (logique LuxAlgo conservée).
bool obJustBroke   = false
bool obTouchedNow  = false

if array.size(obTopA) > 0
    for i = array.size(obTopA) - 1 to 0
        int   dOb = array.get(obDirA, i)
        float tOb = array.get(obTopA, i)
        float bOb = array.get(obBtmA, i)
        bool  kOb = array.get(obBrkA, i)
        bool  dropIt = false

        if dOb == 1
            if not kOb
                if math.min(close, open) < bOb
                    array.set(obBrkA, i, true)
                    array.set(obBrkLocA, i, bar_index)
                    obJustBroke := true
                else if low <= tOb and high >= bOb
                    obTouchedNow := true
                    // MITIGATION : le prix est revenu dans l'Order Block.
                    // Les ordres qui y dormaient ont été servis. La zone
                    // reste surveillée (dashboard, confluence) mais elle
                    // n'est plus tracée : un OB déjà mitigé n'a plus rien
                    // à donner.
                    array.set(obMitA, i, true)
            else
                if close > tOb
                    dropIt := true
        else
            if not kOb
                if math.max(close, open) > tOb
                    array.set(obBrkA, i, true)
                    array.set(obBrkLocA, i, bar_index)
                    obJustBroke := true
                else if high >= bOb and low <= tOb
                    obTouchedNow := true
                    array.set(obMitA, i, true)
            else
                if close < bOb
                    dropIt := true

        if dropIt
            array.remove(obTopA, i)
            array.remove(obBtmA, i)
            array.remove(obLocA, i)
            array.remove(obDirA, i)
            array.remove(obBrkA, i)
            array.remove(obBrkLocA, i)
            array.remove(obFvgA, i)
            array.remove(obIdmA, i)
            array.remove(obMitA, i)

// État courant pour le dashboard : le prix est-il dans un OB / Breaker ?
int    obZoneDir = 0
string obZoneTxt = "-"

if array.size(obTopA) > 0
    for i = 0 to array.size(obTopA) - 1
        if obZoneDir == 0
            float tOb = array.get(obTopA, i)
            float bOb = array.get(obBtmA, i)
            if close <= tOb and close >= bOb
                bool kOb = array.get(obBrkA, i)
                int  dOb = array.get(obDirA, i)
                // Un Breaker a changé de polarité : sens inversé.
                obZoneDir := kOb ? -dOb : dOb
                obZoneTxt := (kOb ? (dOb == 1 ? "Dans BREAKER (ex-OB haussier)" : "Dans BREAKER (ex-OB baissier)")
                     : (dOb == 1 ? "Dans OB haussier" : "Dans OB baissier")) +
                     (array.get(obIdmA, i) ? " ★IDM" : "") +
                     (array.get(obFvgA, i) ? " ⚡" : "")

// AFFICHAGE — uniquement sur la dernière bougie, et on ne supprime QUE
// nos propres objets (jamais box.all / line.all : ça détruirait les
// Sniper Zones, les phases et les zones Supply/Demand).
if barstate.islast
    while array.size(obDrawBox) > 0
        box.delete(array.pop(obDrawBox))
    while array.size(obDrawLn) > 0
        line.delete(array.pop(obDrawLn))
    while array.size(obDrawLbl) > 0
        label.delete(array.pop(obDrawLbl))

    if showOB and okOB and array.size(obTopA) > 0
        int drawnBull = 0
        int drawnBear = 0

        for i = 0 to array.size(obTopA) - 1
            int   dOb = array.get(obDirA, i)
            bool  kOb = array.get(obBrkA, i)
            float tOb = array.get(obTopA, i)
            float bOb = array.get(obBtmA, i)
            int   lOb = array.get(obLocA, i)

            bool quotaOk = dOb == 1 ? drawnBull < obShowBull : drawnBear < obShowBear
            // Filtre 80/20 : ne s'applique jamais aux Breakers, qui ont
            // justement changé de polarité.
            bool dirOk = not obFilter8020 or kOb or confirmedTrend == 0 or confirmedTrend == dOb
            bool brkOk = obShowBreaker or not kOb
            // FILTRAGE RIGOUREUX DES ORDER BLOCKS — deux conditions, plus
            // aucune case à décocher :
            //
            //   1. DÉSÉQUILIBRE OBLIGATOIRE. Un Order Block sans FVG est
            //      un OB faible : rien ne prouve qu'une exécution
            //      institutionnelle a eu lieu là. Seuls ceux qui ont
            //      laissé un vrai Fair Value Gap derrière eux sont tracés.
            //
            //   2. NON MITIGÉ OBLIGATOIRE. Dès que le prix est revenu
            //      dans la zone, les ordres qui y dormaient ont été
            //      servis : l'OB a fait son travail, il n'a plus rien à
            //      donner. Il disparaît du graphique.
            //
            // Les Breaker Blocks échappent aux deux filtres : leur
            // polarité inversée est une information à part entière, et
            // par définition ils ont déjà été traversés.
            bool fvgOk   = kOb or array.get(obFvgA, i)
            bool freshOk = kOb or not array.get(obMitA, i)
            // Anti-encombrement : uniquement la proximite au prix. Le
            // reglage "masquer les zones testees" ne s'applique JAMAIS
            // aux Order Blocks — un OB casse devient un Breaker, et
            // c'est justement l'information la plus utile.
            bool nearOk  = not f_zoneFar(tOb, bOb)

            if quotaOk and dirOk and brkOk and fvgOk and freshOk and nearOk
                if dOb == 1
                    drawnBull += 1
                else
                    drawnBear += 1

                color baseCol = f_zoneFade(dOb == 1 ? obBullCol : obBearCol, tOb, bOb)
                color brkCol  = f_zoneFade(dOb == 1 ? obBullBreakCol : obBearBreakCol, tOb, bOb)
                color solid   = color.rgb(color.r(baseCol), color.g(baseCol), color.b(baseCol))
                color brkSol  = color.rgb(color.r(brkCol), color.g(brkCol), color.b(brkCol))

                string tag = (kOb ? "BRK " : "OB ") + (dOb == 1 ? "⬆" : "⬇") +
                     (array.get(obIdmA, i) ? " ★" : "") +
                     (array.get(obFvgA, i) ? " ⚡" : "")

                // Bord droit = le prix actuel (+ marge de lisibilité).
                // JAMAIS extend.right : la zone suit le prix, elle ne
                // part pas à l'infini vers la droite.
                int rightEdge = bar_index + zoneExt

                if kOb
                    int bLoc = array.get(obBrkLocA, i)
                    // Partie encore valide (avant la cassure)
                    array.push(obDrawBox, box.new(lOb, tOb, bLoc, bOb,
                         border_color=solid, bgcolor=baseCol))
                    // Partie Breaker (polarité inversée), suit le prix
                    array.push(obDrawBox, box.new(bLoc, tOb, rightEdge, bOb,
                         border_color=na, bgcolor=brkCol))
                    array.push(obDrawLn, line.new(bLoc, tOb, rightEdge, tOb,
                         xloc=xloc.bar_index, color=brkSol, style=line.style_dashed))
                    array.push(obDrawLn, line.new(bLoc, bOb, rightEdge, bOb,
                         xloc=xloc.bar_index, color=brkSol, style=line.style_dashed))
                    if lblAll
                        array.push(obDrawLbl, label.new(rightEdge, (tOb + bOb) / 2, tag,
                             style=label.style_label_left, color=brkCol, textcolor=brkSol, size=size.tiny))
                else
                    array.push(obDrawBox, box.new(lOb, tOb, rightEdge, bOb,
                         border_color=na, bgcolor=baseCol))
                    array.push(obDrawLn, line.new(lOb, tOb, rightEdge, tOb,
                         xloc=xloc.bar_index, color=solid))
                    array.push(obDrawLn, line.new(lOb, bOb, rightEdge, bOb,
                         xloc=xloc.bar_index, color=solid))
                    if lblAll
                        array.push(obDrawLbl, label.new(rightEdge, (tOb + bOb) / 2, tag,
                             style=label.style_label_left, color=baseCol, textcolor=solid, size=size.tiny))



//=====================================================================
// ZONES SUPPLY / DEMAND (module 9) — la version LARGE.
//
// Contrairement à l'OB (module 8), aucune cassure de structure n'est
// exigée : une base de consolidation suivie d'une impulsion forte
// suffit. La zone englobe TOUTE la base (plusieurs bougies), là où l'OB
// ne retient que la dernière bougie opposée.
//
// La base est construite au fil de l'eau (variables var) — comme pour
// l'OB, aucune relecture d'historique à index variable.
//=====================================================================
var box[]   sdBox = array.new_box()
var label[] sdLbl = array.new_label()
var float[] sdTop = array.new_float()
var float[] sdBot = array.new_float()
var int[]   sdDir = array.new_int()
var bool[]  sdMit = array.new_bool()

var float sdBaseTop   = na
var float sdBaseBot   = na
var int   sdBaseCount = 0
var int   sdBaseStart = na

float sdBody      = math.abs(close - open)
bool  sdIsImpulse = showSD and okSD and atrReady and sdBody > atrFast * sdImpulseMult
bool  sdIsSmall   = atrReady and sdBody < atrFast * 0.8
int   sdDirNow    = close > open ? 1 : -1

if sdIsImpulse
    // La base accumulée juste avant devient la zone Supply/Demand.
    if sdBaseCount > 0 and not na(sdBaseTop) and not na(sdBaseBot) and not na(sdBaseStart)
        color  sdCol = sdDirNow == 1 ? sdDemandCol : sdSupplyCol
        string sdTxt = sdDirNow == 1 ? "DEMAND" : "SUPPLY"

        box   sb = box.new(sdBaseStart, sdBaseTop, bar_index + zoneExt, sdBaseBot,
             border_color=sdCol, border_width=1,
             bgcolor=color.new(sdCol, 88))
        label sl = not lblAll ? na : label.new(sdBaseStart, sdDirNow == 1 ? sdBaseBot : sdBaseTop, sdTxt,
             style=sdDirNow == 1 ? label.style_label_up : label.style_label_down,
             color=color.new(sdCol, 82), textcolor=sdCol, size=size.tiny)

        array.push(sdBox, sb)
        array.push(sdLbl, sl)
        array.push(sdTop, sdBaseTop)
        array.push(sdBot, sdBaseBot)
        array.push(sdDir, sdDirNow)
        array.push(sdMit, false)

    sdBaseTop := na
    sdBaseBot := na
    sdBaseCount := 0
    sdBaseStart := na
else if sdIsSmall
    if sdBaseCount >= sdMaxBase
        // Base trop longue : on repart d'une base neuve sur cette bougie.
        sdBaseTop := high
        sdBaseBot := low
        sdBaseCount := 1
        sdBaseStart := bar_index
    else
        sdBaseTop := na(sdBaseTop) ? high : math.max(sdBaseTop, high)
        sdBaseBot := na(sdBaseBot) ? low  : math.min(sdBaseBot, low)
        sdBaseCount := sdBaseCount + 1
        sdBaseStart := na(sdBaseStart) ? bar_index : sdBaseStart
else
    // Bougie moyenne : ni base ni impulsion, on repart de zéro.
    sdBaseTop := na
    sdBaseBot := na
    sdBaseCount := 0
    sdBaseStart := na

// Purge : garde au plus sdCount zones par côté (Demand et Supply
// comptées séparément), les plus récentes.
if array.size(sdBox) > 0
    int keepDemand = 0
    int keepSupply = 0
    for i = array.size(sdBox) - 1 to 0
        bool keepIt = true
        if array.get(sdDir, i) == 1
            keepDemand := keepDemand + 1
            keepIt := keepDemand <= sdCount
        else
            keepSupply := keepSupply + 1
            keepIt := keepSupply <= sdCount
        if not keepIt
            box.delete(array.get(sdBox, i))
            label sdOld = array.get(sdLbl, i)
            if not na(sdOld)
                label.delete(sdOld)
            array.remove(sdBox, i)
            array.remove(sdLbl, i)
            array.remove(sdTop, i)
            array.remove(sdBot, i)
            array.remove(sdDir, i)
            array.remove(sdMit, i)

// Prolongation + mitigation des zones Supply/Demand.
bool sdTouched = false

if array.size(sdBox) > 0
    for i = 0 to array.size(sdBox) - 1
        box bx = array.get(sdBox, i)
        box.set_right(bx, bar_index + zoneExt)

        float sdT = array.get(sdTop, i)
        float sdB = array.get(sdBot, i)
        bool  sdWasHit = array.get(sdMit, i)

        // Anti-superposition : si un Order Block (plus precis) recouvre
        // cette zone, on masque la zone large — priorite OB > S/D.
        bool sdUnderOB = false
        if useAntiOverlap and array.size(obTopA) > 0
            for k = 0 to array.size(obTopA) - 1
                if not sdUnderOB and sdT >= array.get(obBtmA, k) and sdB <= array.get(obTopA, k)
                    sdUnderOB := true

        bool sdHide = f_zoneFar(sdT, sdB) or sdUnderOB or (hideTested and sdWasHit)
        color sdShownCol = sdHide ? color.new(color.gray, 100) :
             f_zoneFade(sdWasHit ? sdMitigatedCol : (array.get(sdDir, i) == 1 ? sdDemandCol : sdSupplyCol), sdT, sdB)
        box.set_bgcolor(bx, sdShownCol)
        box.set_border_color(bx, sdHide ? color.new(color.gray, 100) : sdShownCol)
        label sdLbNow = array.get(sdLbl, i)
        if not na(sdLbNow)
            label.set_color(sdLbNow, sdHide ? color.new(color.gray, 100) : sdShownCol)
            label.set_textcolor(sdLbNow, sdHide ? color.new(color.gray, 100) : sdShownCol)
        if not array.get(sdMit, i)
            if low <= array.get(sdTop, i) and high >= array.get(sdBot, i)
                array.set(sdMit, i, true)
                sdTouched := true
                box.set_border_color(bx, sdMitigatedCol)
                box.set_bgcolor(bx, color.new(sdMitigatedCol, 92))
                label lbD = array.get(sdLbl, i)
                if not na(lbD)
                    label.set_color(lbD, color.new(sdMitigatedCol, 85))
                    label.set_textcolor(lbD, sdMitigatedCol)


//=====================================================================
// IMBALANCES / FAIR VALUE GAP (module 10)
//
// Vide de prix sur 3 bougies : le marché est monté (ou descendu) trop
// vite pour qu'un échange équitable ait lieu sur cette plage.
//   Haussière : le bas de la bougie actuelle est AU-DESSUS du haut de
//               la bougie d'il y a 2 périodes -> zone [high[2], low].
//   Baissière : le haut de la bougie actuelle est SOUS le bas de la
//               bougie d'il y a 2 périodes -> zone [high, low[2]].
//
// Indices d'historique CONSTANTS ([2]) uniquement — aucun risque de
// buffer.
//
// AFFICHAGE SUPPRIMÉ. Ce module ne dessine plus RIEN : les boîtes
// d'imbalance ont été retirées du code, pas mises derrière une case à
// décocher. Elles se superposaient systématiquement aux Order Blocks et
// aux Sniper Zones, et c'est cette double boîte qui rendait le
// graphique illisible.
//
// Le calcul, lui, tourne toujours à plein régime et sert à trois
// endroits :
//   • le filtre « déséquilibre obligatoire » des Order Blocks ;
//   • le repli de l'IDM 4 ;
//   • le score de confluence du module 15.
// Le suivi du comblement est donc maintenu à l'identique, simplement
// sans objet graphique.
//=====================================================================
var float[] fvgTop = array.new_float()
var float[] fvgBot = array.new_float()
var int[]   fvgDir = array.new_int()

bool fvgUpNew   = showFvg and bar_index >= 2 and low > high[2]
bool fvgDownNew = showFvg and bar_index >= 2 and high < low[2]
float fvgMinPx  = atrReady ? atrFast * fvgMinSize : 0.0

if fvgUpNew and (low - high[2]) >= fvgMinPx
    array.push(fvgTop, low)
    array.push(fvgBot, high[2])
    array.push(fvgDir, 1)

if fvgDownNew and (low[2] - high) >= fvgMinPx
    array.push(fvgTop, low[2])
    array.push(fvgBot, high)
    array.push(fvgDir, -1)

// Comblement : la zone rétrécit, puis disparaît quand elle est remplie.
bool fvgFilledNow = false

if array.size(fvgTop) > 0
    for i = array.size(fvgTop) - 1 to 0
        float fT = array.get(fvgTop, i)
        float fB = array.get(fvgBot, i)
        int   fD = array.get(fvgDir, i)
        bool  gone = false

        if fD == 1
            // Comblée par le bas : le prix remonte dans le vide.
            if low <= fB
                gone := true
            else if fvgShrink and low < fT
                array.set(fvgTop, i, low)
                fvgFilledNow := true
        else
            if high >= fT
                gone := true
            else if fvgShrink and high > fB
                array.set(fvgBot, i, high)
                fvgFilledNow := true

        if gone
            array.remove(fvgTop, i)
            array.remove(fvgBot, i)
            array.remove(fvgDir, i)

// Purge : au plus fvgCount imbalances par côté, les plus récentes.
if array.size(fvgTop) > 0
    int keepUp = 0
    int keepDn = 0
    for i = array.size(fvgTop) - 1 to 0
        bool keepF = true
        if array.get(fvgDir, i) == 1
            keepUp := keepUp + 1
            keepF := keepUp <= fvgCount
        else
            keepDn := keepDn + 1
            keepF := keepDn <= fvgCount
        if not keepF
            array.remove(fvgTop, i)
            array.remove(fvgBot, i)
            array.remove(fvgDir, i)

// Le prix est-il dans une imbalance en ce moment ?
int fvgZoneDir = 0
if array.size(fvgTop) > 0
    for i = array.size(fvgTop) - 1 to 0
        if fvgZoneDir == 0 and close <= array.get(fvgTop, i) and close >= array.get(fvgBot, i)
            fvgZoneDir := array.get(fvgDir, i)


// État courant : le prix est-il DANS un OB / Breaker, une zone S/D ou
// une imbalance ? Sert au dashboard pour la confirmation d'entrée.
// Priorité : Order Block (niveau chirurgical) > Supply/Demand (zone
// large) > imbalance (vide de prix à combler).
int    zoneNowDir = obZoneDir
string zoneNowTxt = obZoneTxt

if zoneNowDir == 0 and array.size(sdBox) > 0
    for i = array.size(sdBox) - 1 to 0
        if zoneNowDir == 0 and close <= array.get(sdTop, i) and close >= array.get(sdBot, i)
            zoneNowDir := array.get(sdDir, i)
            zoneNowTxt := (array.get(sdDir, i) == 1 ? "Dans zone DEMAND" : "Dans zone SUPPLY") + (array.get(sdMit, i) ? " (mitigée)" : "")

if zoneNowDir == 0 and fvgZoneDir != 0
    zoneNowDir := fvgZoneDir
    zoneNowTxt := fvgZoneDir == 1 ? "Dans imbalance haussière" : "Dans imbalance baissière"

// Une imbalance QUI COÏNCIDE avec un OB est la meilleure configuration
// SMC : on le signale explicitement.
if obZoneDir != 0 and fvgZoneDir != 0
    zoneNowTxt := obZoneTxt + " + imbalance"


//=====================================================================
// IDM 3 — CONFLUENCE H1 + M15 + M5 (module 11)
//
// Le niveau est ANCRÉ sur le H1 (le timeframe de décision) : c'est lui
// qui donne le prix de référence. Le M15 et le M5 servent de
// CONFIRMATION — s'ils voient un point de ravitaillement au même
// endroit, le niveau est bien plus solide.
//
// Sens : dicté par h1Bias, exactement comme la case "Acheteur/Vendeur
// maintenant" du dashboard.
//   H1 haussier -> on attend le prix EN DESSOUS, sur un creux.
//   H1 baissier -> on attend le prix AU-DESSUS, sur un sommet.
//
// La confluence affichée (3/3, 2/3, 1/3) est un DÉCOMPTE VÉRIFIABLE du
// nombre de timeframes d'accord, pas une probabilité inventée.
//=====================================================================
var float projLvl   = na
var int   projDirV  = 0
var int   projAgree = 0

// Niveau vu par chaque timeframe, dans le sens du H1.
float lvH1  = h1Bias == 1 ? h1Lo  : h1Bias == -1 ? h1Hi  : na
float lvM15 = h1Bias == 1 ? m15Lo : h1Bias == -1 ? m15Hi : na
float lvM5  = h1Bias == 1 ? m5Lo  : h1Bias == -1 ? m5Hi  : na

float projTol = atrReady ? atrFast * projTolAtr : na

int   agreeCnt = 0
float agreeSum = 0.0

if not na(lvH1) and not na(projTol)
    // Le H1 est l'ancre : il compte toujours pour 1.
    agreeCnt := 1
    agreeSum := lvH1
    if not na(lvM15) and math.abs(lvM15 - lvH1) <= projTol
        agreeCnt := agreeCnt + 1
        agreeSum := agreeSum + lvM15
    if not na(lvM5) and math.abs(lvM5 - lvH1) <= projTol
        agreeCnt := agreeCnt + 1
        agreeSum := agreeSum + lvM5

// Le niveau retenu est la moyenne des timeframes d'accord : il se cale
// naturellement là où les lectures se rejoignent.
float projCand = agreeCnt > 0 ? agreeSum / agreeCnt : na

// Calculé TOUJOURS (dashboard + confluence), même si le tracé est coupé.
if not na(projCand) and agreeCnt >= projMinTf and h1Bias != 0
    projLvl   := projCand
    projDirV  := h1Bias
    projAgree := agreeCnt

// Disparition : le prix l'a touché (il a fait son travail), ou la
// structure H1 s'est inversée (la thèse est morte), ou le H1 ne donne
// plus de niveau exploitable.
bool projHit = not na(projLvl) and
     (projDirV == 1 ? low <= projLvl : projDirV == -1 ? high >= projLvl : false)
bool projFlip = not na(projLvl) and projDirV != 0 and h1Bias != 0 and h1Bias != projDirV

if projHit or projFlip or na(lvH1)
    projLvl   := na
    projDirV  := 0
    projAgree := 0

// AFFICHAGE DE L'IDM 3 : SUPPRIMÉ.
//
// La ligne en tirets, sa zone et son étiquette ont été retirées du
// code. Le niveau reste calculé bougie par bougie : il remplit la case
// « IDM 3 » du dashboard et vaut 1 point dans le score de confluence du
// module 15. Il n'encombre simplement plus le graphique.

//=====================================================================
// IDM 4 : MODULE ENTIÈREMENT SUPPRIMÉ (ex-module 12)
//
// Il n'était plus tracé sur le graphique et il ne figure plus dans le
// tableau de bord. Plus personne ne lisait idm4Lvl / idm4DirV /
// idm4Base : c'était devenu du calcul mort à chaque bougie. Le module
// est donc retiré, avec son groupe de réglages et sa couleur.
//
// Rien d'autre n'en dépendait : les imbalances et les Order Blocks qui
// lui servaient de matière première alimentent toujours le filtre des
// OB et le score de confluence.
//=====================================================================


//=====================================================================
// PHASES — Accumulation / Réaccumulation, Distribution / Redistribution
// (moteur toujours actif ; le dessin est gated par showPhaseBox /
// showPhaseMarkers, chacune indépendante). Purement informatif — bons
// endroits pour préparer un trade, mais l'IDM et la Sniper Zone restent
// les seules zones d'action de l'indicateur.
//=====================================================================
//---------------------------------------------------------------------
// PLAFOND DES OBJETS DU MODULE PHASES
//
// Même problème que les étiquettes de pivot : les marqueurs SC / BC /
// STB / SPRING / UT / UTAD et les rectangles Accumulation / Distribution
// étaient créés sans jamais être supprimés. Ils saturaient le quota de
// 500 étiquettes et de 500 boîtes de TradingView, qui évinçait alors les
// plus anciens objets du script — dont les BOS et les BMS.
//
// On garde les 30 derniers marqueurs et les 8 derniers rectangles.
//---------------------------------------------------------------------
var label[] phaseLbls = array.new_label()
var box[]   phaseBoxes = array.new_box()

f_capPhaseLbl(label lb) =>
    array.push(phaseLbls, lb)
    if array.size(phaseLbls) > 30
        label.delete(array.shift(phaseLbls))

f_capPhaseBox(box bx) =>
    array.push(phaseBoxes, bx)
    if array.size(phaseBoxes) > 8
        box.delete(array.shift(phaseBoxes))

var string lastPhase = "-"

var bool  accActive = false
var float accSC = na
var int   accSCBar = na
var float accLow = na
var float accTop = na
var int   accSTBBar = na
var float accSTBVal = na
var int   accSpringBar = na
var float accSpringVal = na
var int   accAge = 0
var int   accStartBias = 0

var bool  disActive = false
var float disBC = na
var int   disBCBar = na
var float disHigh = na
var float disBottom = na
var int   disUTBar = na
var float disUTVal = na
var int   disUTADBar = na
var float disUTADVal = na
var int   disAge = 0
var int   disStartBias = 0

bool phaseAccConfirmed = false
bool phaseDisConfirmed = false

if accActive
    accAge += 1
    accTop := math.max(accTop, high)
    if low < accLow
        if na(accSTBBar)
            accSTBBar := bar_index
            accSTBVal := low
            if showPhaseMarkers and okPhase and lblEss
                f_capPhaseLbl(label.new(accSTBBar, accSTBVal, "STB", style=label.style_label_up, color=color.new(phaseCol, 70), textcolor=phaseCol, size=size.small))
        else
            accSpringBar := bar_index
            accSpringVal := low
            if showPhaseMarkers and okPhase and lblEss
                f_capPhaseLbl(label.new(accSpringBar, accSpringVal, "SPRING", style=label.style_label_up, color=color.new(phaseCol, 55), textcolor=phaseCol, size=size.small))
        accLow := low
    if newMoveDown
        accActive := false
    if accAge > 500
        accActive := false

if disActive
    disAge += 1
    disBottom := math.min(disBottom, low)
    if high > disHigh
        if na(disUTBar)
            disUTBar := bar_index
            disUTVal := high
            if showPhaseMarkers and okPhase and lblEss
                f_capPhaseLbl(label.new(disUTBar, disUTVal, "UT", style=label.style_label_down, color=color.new(phaseCol, 70), textcolor=phaseCol, size=size.small))
        else
            disUTADBar := bar_index
            disUTADVal := high
            if showPhaseMarkers and okPhase and lblEss
                f_capPhaseLbl(label.new(disUTADBar, disUTADVal, "UTAD", style=label.style_label_down, color=color.new(phaseCol, 55), textcolor=phaseCol, size=size.small))
        disHigh := high
    if newMoveUp
        disActive := false
    if disAge > 500
        disActive := false

if accActive and newMoveUp and not na(accSCBar)
    float topA = math.max(accTop, high)
    string phTxt = accStartBias == 1 ? "RÉACCUMULATION" : "ACCUMULATION"
    lastPhase := phTxt
    accActive := false
    phaseAccConfirmed := true
    if showPhaseBox and okPhase
        f_capPhaseBox(box.new(accSCBar, topA, bar_index, accLow, border_color=color.new(bullCol, 30), bgcolor=color.new(bullCol, 92)))
        f_capPhaseLbl(label.new(accSCBar, topA, phTxt, style=label.style_label_down, color=color.new(bullCol, 55), textcolor=bullCol, size=size.small))

if disActive and newMoveDown and not na(disBCBar)
    float botD = math.min(disBottom, low)
    string phTxt = disStartBias == -1 ? "REDISTRIBUTION" : "DISTRIBUTION"
    lastPhase := phTxt
    disActive := false
    phaseDisConfirmed := true
    if showPhaseBox and okPhase
        f_capPhaseBox(box.new(disBCBar, disHigh, bar_index, botD, border_color=color.new(bearCol, 30), bgcolor=color.new(bearCol, 92)))
        f_capPhaseLbl(label.new(disBCBar, botD, phTxt, style=label.style_label_up, color=color.new(bearCol, 55), textcolor=bearCol, size=size.small))

if not accActive and not na(pl)
    accActive := true
    accSC := pl
    accSCBar := plBar
    accLow := pl
    accTop := na(lastPH) ? high : math.max(lastPH, high)
    accSTBBar := na
    accSTBVal := na
    accSpringBar := na
    accSpringVal := na
    accAge := 0
    accStartBias := bias
    if showPhaseMarkers and okPhase and lblEss
        f_capPhaseLbl(label.new(accSCBar, accSC, "SC", style=label.style_label_up, color=color.new(bullCol, 70), textcolor=bullCol, size=size.small))

if not disActive and not na(ph)
    disActive := true
    disBC := ph
    disBCBar := phBar
    disHigh := ph
    disBottom := na(lastPL) ? low : math.min(lastPL, low)
    disUTBar := na
    disUTVal := na
    disUTADBar := na
    disUTADVal := na
    disAge := 0
    disStartBias := bias
    if showPhaseMarkers and okPhase and lblEss
        f_capPhaseLbl(label.new(disBCBar, disBC, "BC", style=label.style_label_down, color=color.new(bearCol, 70), textcolor=bearCol, size=size.small))

bool stbJustFormed    = accSTBBar == bar_index
bool springJustFormed = accSpringBar == bar_index
bool utJustFormed     = disUTBar == bar_index
bool utadJustFormed   = disUTADBar == bar_index

//=====================================================================
// FILTRE DE SIGNAL SMV (module 15) — structure robuste + confluence
//
// POURQUOI CE MODULE EXISTE
//
// confirmedTrend bascule sur isStructLowBroken / isStructHighBroken. Or
// le niveau que ces tests surveillent (bosLow / bosHigh) est ancré sur
// f_structLowestBar(10) : le plus bas des DIX dernières bougies au
// moment de la cassure. En tendance haussière franche, ce creux est
// tout proche du prix — le moindre retracement le traverse, le moteur
// annonce un BOS baissier, confirmedTrend passe à -1, et des VENTES
// s'ouvrent au beau milieu d'une structure haussière.
//
// C'est exactement le défaut visible sur le graphique : la structure
// monte, mais chaque respiration produit un faux retournement.
//
// Ce module NE TOUCHE PAS au moteur : bias, confirmedTrend, les lignes
// BOS/BMS et tout ce qui est dessiné restent identiques. Il calcule une
// SECONDE lecture de la structure, plus lente et plus solide, qui sert
// UNIQUEMENT à autoriser ou refuser les entrées.
//
//---------------------------------------------------------------------
// 1) TENDANCE STRUCTURELLE — cassure du POINT PROTÉGÉ
//
// En SMC, une structure haussière n'est cassée que lorsque le prix
// CLÔTURE sous le dernier creux HIGHER LOW confirmé — le point protégé.
// Pas sous n'importe quel petit creux : sous CELUI-LÀ.
//
// Les creux et sommets utilisés sont ceux du zigzag principal (seuil
// 1.5 x ATR), pas une fenêtre de 10 bougies : ce sont de vrais swings.
//
//   Structure haussière : protLow ne fait que MONTER (chaque nouveau
//   HL le relève). Elle ne casse que si close < protLow.
//   Structure baissière : protHigh ne fait que DESCENDRE. Elle ne casse
//   que si close > protHigh.
//
// Un retracement, même profond, ne casse rien tant qu'il ne clôture pas
// sous le dernier HL. C'est ta règle : pas de signal pendant les
// retracements, sauf si la structure est réellement cassée.
//=====================================================================
var int   smvTrend  = 0
var float protLow   = na
var float protHigh  = na
bool smvTrendFlip = false

// Mise à jour du point protégé sur chaque nouveau swing confirmé.
if not na(pl)
    if na(protLow)
        protLow := pl
    else if smvTrend >= 0 and pl > protLow
        // Creux plus haut : la structure haussière se renforce, le point
        // protégé remonte avec elle.
        protLow := pl

if not na(ph)
    if na(protHigh)
        protHigh := ph
    else if smvTrend <= 0 and ph < protHigh
        // Sommet plus bas : la structure baissière se renforce.
        protHigh := ph

// Bascule — uniquement sur CLÔTURE au-delà du point protégé.
if not na(protHigh) and close > protHigh and smvTrend != 1
    smvTrend := 1
    smvTrendFlip := true
    // Nouveau point protégé haussier : le dernier creux de swing connu.
    protLow := na(lastPL) ? protLow : lastPL

if not na(protLow) and close < protLow and smvTrend != -1
    smvTrend := -1
    smvTrendFlip := true
    protHigh := na(lastPH) ? protHigh : lastPH

//=====================================================================
// 2) CONFLUENCE SMV — ce qui rend le signal CONCRET
//
// Une entrée doit avoir une raison identifiable à l'endroit où elle se
// fait. UN SEUL élément suffit à la justifier : un Order Block, ou une
// imbalance, ou un SPRING — l'un OU l'autre, pas forcément plusieurs.
// Quand plusieurs se retrouvent au même endroit, le signal est
// simplement plus solide, mais ce n'est pas une obligation.
//
// On compte donc, là où le prix se trouve, combien d'éléments de TA
// méthode sont présents. Chacun vaut 1 point, et chacun vient d'un
// module que tu as déjà — rien n'est inventé, tout est vérifiable :
//
//   1. Order Block non cassé, du bon sens, qui contient le prix
//   2. Imbalance (FVG) non comblée, du bon sens, qui contient le prix
//   3. Zone Supply/Demand non mitigée, du bon sens, qui contient le prix
//   4. Phase Wyckoff récente : SPRING ou STB pour un achat,
//      UTAD ou UT pour une vente
//   5. Le 0.5 du mouvement déjà validé dans le bon sens (validTest)
//   6. IDM 3 (le niveau H1 confirmé par le M15 et le M5) touché
//   7. LA SIGNATURE — le prix est dans la mèche de la bougie qui a pris
//      l'argent. C'est le point le plus fort de tous : la vraie zone de
//      Demand / Supply, plus exacte qu'un Order Block.
//
// Le score est calculé séparément pour l'achat et pour la vente : un
// même endroit peut être fort à l'achat et nul à la vente.
//=====================================================================
int smvConfBull = 0
int smvConfSell = 0

// --- 1. Order Block non cassé contenant le prix
if array.size(obTopA) > 0
    for ci = 0 to array.size(obTopA) - 1
        if not array.get(obBrkA, ci)
            float cTop = array.get(obTopA, ci)
            float cBtm = array.get(obBtmA, ci)
            if close <= cTop and close >= cBtm
                if array.get(obDirA, ci) == 1
                    smvConfBull := smvConfBull + 1
                else
                    smvConfSell := smvConfSell + 1

// --- 2. Imbalance non comblée contenant le prix
if array.size(fvgTop) > 0
    for ci = 0 to array.size(fvgTop) - 1
        if close <= array.get(fvgTop, ci) and close >= array.get(fvgBot, ci)
            if array.get(fvgDir, ci) == 1
                smvConfBull := smvConfBull + 1
            else
                smvConfSell := smvConfSell + 1

// --- 3. Zone Supply/Demand non mitigée contenant le prix
if array.size(sdTop) > 0
    for ci = 0 to array.size(sdTop) - 1
        if not array.get(sdMit, ci) and close <= array.get(sdTop, ci) and close >= array.get(sdBot, ci)
            if array.get(sdDir, ci) == 1
                smvConfBull := smvConfBull + 1
            else
                smvConfSell := smvConfSell + 1

// --- 4. Phase Wyckoff récente
// SPRING et STB annoncent la fin d'une accumulation -> confluence ACHAT.
// UTAD et UT annoncent la fin d'une distribution -> confluence VENTE.
bool springFresh = not na(accSpringBar) and bar_index - accSpringBar <= smvPhaseBars
bool stbFresh    = not na(accSTBBar)    and bar_index - accSTBBar    <= smvPhaseBars
bool utadFresh   = not na(disUTADBar)   and bar_index - disUTADBar   <= smvPhaseBars
bool utFresh     = not na(disUTBar)     and bar_index - disUTBar     <= smvPhaseBars

if springFresh or stbFresh
    smvConfBull := smvConfBull + 1
if utadFresh or utFresh
    smvConfSell := smvConfSell + 1

// --- 5. Le 0.5 du mouvement validé dans le bon sens
if validTest and moveDir == 1
    smvConfBull := smvConfBull + 1
if validTest and moveDir == -1
    smvConfSell := smvConfSell + 1

// --- 6. IDM 3 touché (niveau H1 confirmé par le M15 et le M5)
if not na(projLvl) and atrReady
    if low <= projLvl + atrFast * 0.25 and high >= projLvl - atrFast * 0.25
        if projDirV == 1
            smvConfBull := smvConfBull + 1
        else if projDirV == -1
            smvConfSell := smvConfSell + 1

//---------------------------------------------------------------------
// AUTORISATION FINALE — c'est ce que les deux moteurs d'entrée lisent.
//
// Structure haussière -> uniquement des ACHATS.
// Structure baissière -> uniquement des VENTES.
// Structure pas encore établie (smvTrend == 0) -> rien du tout : on
// n'ouvre pas à l'aveugle au tout début du graphique.
//---------------------------------------------------------------------
// --- 7. LA SIGNATURE — la mèche qui a pris l'argent contient le prix.
// C'est la vraie zone d'offre / demande de la méthode : elle prime sur
// l'Order Block, qui n'en est qu'une approximation.
if sigZoneDir == 1
    smvConfBull := smvConfBull + 1
if sigZoneDir == -1
    smvConfSell := smvConfSell + 1

bool smvBuyOk  = not smvUseFilter or (smvTrend == 1  and smvConfBull >= smvMinConf)
bool smvSellOk = not smvUseFilter or (smvTrend == -1 and smvConfSell >= smvMinConf)


//=====================================================================
// DASHBOARD — lit uniquement l'état du moteur, fonctionne même si tous
// les autres modules d'affichage sont désactivés
//=====================================================================
// Le tableau suit désormais TA séquence, dans l'ordre où tu la lis :
//
//   structure -> biais -> IDM à surveiller -> IDM figé -> 0.5 ->
//   Signature -> confluence -> déclencheur -> cible -> action
//
// RETIRÉ : « Structure » (bias brut), IDM 2, IDM 3, IDM 4. Le bias brut
// contredisait parfois la ligne suivante et surtout ce n'est PAS lui qui
// autorise les entrées — c'est smvTrend, désormais affiché à sa place.
// Les IDM 2/3/4 ne sont plus tracés et ne sont plus listés ici non plus.
var table dash = table.new(position.top_right, 2, 12,
     border_width=1, frame_width=1, frame_color=color.gray)

if showDash and barstate.islast

    // 1. STRUCTURE SMV — la seule qui autorise ou refuse une entrée.
    // C'est la lecture lente, ancrée sur le point protégé (module 15),
    // pas le bias brut qui bascule au moindre retracement.
    string smvTxt =
         smvTrend == 1 ? "HAUSSIÈRE — achats seuls" :
         smvTrend == -1 ? "BAISSIÈRE — ventes seules" :
         "pas encore établie — aucun signal"
    color smvCol = smvTrend == 1 ? bullCol : smvTrend == -1 ? bearCol : rangeCol

    // 2. Acheteur/Vendeur maintenant — se fie UNIQUEMENT à la structure
    // H1 (h1Bias), jamais au chart courant.
    string posTxt = h1Bias == 1 ? "ACHETEUR" : h1Bias == -1 ? "VENDEUR" : "NEUTRE"
    color  posCol = h1Bias == 1 ? entryBuyCol : h1Bias == -1 ? entrySellCol : rangeCol

    // 3. IDM 1 — le plus récent qui respecte la structure (règle 80/20).
    int nIdm = array.size(idmLevel)
    int idmWaitIdx = -1
    if nIdm > 0
        for i = nIdm - 1 to 0
            if idmWaitIdx == -1 and not array.get(idmDone, i) and
                 (confirmedTrend == 0 or array.get(idmDir, i) == confirmedTrend)
                idmWaitIdx := i

    string idmWaitTxt = idmWaitIdx == -1 ? "-" :
         (array.get(idmDir, idmWaitIdx) == 1 ? "IDBL " : "IDBR ") +
         str.tostring(array.get(idmLevel, idmWaitIdx), format.mintick)
    color idmWaitColCell = idmWaitIdx == -1 ? dashValueCol : idmActiveCol

    // 4. IDM FIGÉ — le dernier piège posé avant le vrai retracement.
    // C'est LE niveau sur lequel tu entres : il ne bouge plus.
    string frzTxt = na(frozenIdx) ? "-" :
         (frozenDir == 1 ? "IDBL " : "IDBR ") + str.tostring(frozenLvl, format.mintick) +
         (na(frozenSweptBar) ? "  · attend le balayage" : "  ✦ balayé, attend la reprise")
    color frzCol = na(frozenIdx) ? dashValueCol : idmActiveCol

    // 5. LE 0.5 — étape obligatoire avant toute entrée.
    string fibTxt = na(moveFib50) ? "-" :
         str.tostring(moveFib50, format.mintick) +
         (validTest ? "  ✓ atteint" :
              "  · à " + str.tostring(math.abs(close - moveFib50), format.mintick))
    color fibCol = na(moveFib50) ? dashValueCol : validTest ? idmDoneCol : rangeCol

    // 6. LA SIGNATURE — la mèche qui a pris l'argent.
    int nSig = array.size(sniperRefineBx)
    string sigTxt =
         sigZoneDir == 1 ? "PRIX DEDANS — Demand" :
         sigZoneDir == -1 ? "PRIX DEDANS — Supply" :
         nSig > 0 ? str.tostring(nSig) + " active(s), prix dehors" : "-"
    color sigCol = sigZoneDir == 1 ? entryBuyCol : sigZoneDir == -1 ? entrySellCol : dashValueCol

    // 7. CONFLUENCE — le score qui autorise ou refuse le signal.
    string cfTxt = "achat " + str.tostring(smvConfBull) + "/7   ·   vente " +
         str.tostring(smvConfSell) + "/7   (seuil " + str.tostring(smvMinConf) + ")"
    color cfCol =
         smvTrend == 1 and smvConfBull >= smvMinConf ? entryBuyCol :
         smvTrend == -1 and smvConfSell >= smvMinConf ? entrySellCol :
         dashValueCol

    // 8. DÉCLENCHEUR — l'état réel du setup.
    string trigTxt = "-"
    color  trigCol = rangeCol
    if not useTrigger
        trigTxt := "désactivé — entrée au contact de l'IDM"
        trigCol := rangeCol
    else if entrySignalBuy
        trigTxt := "TIRÉ — ACHAT"
        trigCol := entryBuyCol
    else if entrySignalSell
        trigTxt := "TIRÉ — VENTE"
        trigCol := entrySellCol
    else if trigArmed
        int trigLeft = na(armBar) ? trigMaxBars : trigMaxBars - (bar_index - armBar)
        trigTxt := (armDir == 1 ? "ARMÉ ACHAT" : "ARMÉ VENTE") +
             (armDeep ? " · 0.5 pris, attend le rejet" : " · attend le 0.5") +
             "  (" + str.tostring(math.max(trigLeft, 0)) + " bougies)"
        trigCol := armDir == 1 ? entryBuyCol : entrySellCol
    else if trigExpired
        trigTxt := "expiré — zone non défendue"
        trigCol := rangeCol

    // 9. Liquidité cible.
    string targetDashTxt = targetValid ?
         str.tostring(targetLevel, format.mintick) +
         (na(targetProgressPct) ? "" : " (" + str.tostring(targetProgressPct, "#") + "% parcouru)") :
         "-"
    color targetDashCol = targetValid ? targetCol : rangeCol

    // 10. Action.
    string actionTxt = "-"
    color actionCol = rangeCol

    if entrySignalBuy
        actionTxt := "ENTRER ACHAT MAINTENANT"
        actionCol := entryBuyCol
    else if entrySignalSell
        actionTxt := "ENTRER VENTE MAINTENANT"
        actionCol := entrySellCol
    else if trigArmed
        actionTxt := armDeep ? "Setup armé — attendre la bougie de rejet" :
             "Setup armé — attendre le 0.5"
        actionCol := armDir == 1 ? entryBuyCol : entrySellCol
    else if not na(frozenIdx)
        actionTxt := (frozenDir == 1 ? "Préparer ACHAT — IDM figé " : "Préparer VENTE — IDM figé ") +
             str.tostring(frozenLvl, format.mintick)
        actionCol := idmActiveCol
    else if idmWaitIdx != -1
        actionTxt := (array.get(idmDir, idmWaitIdx) == 1 ? "Préparer ACHAT — retest " : "Préparer VENTE — retest ") +
             str.tostring(array.get(idmLevel, idmWaitIdx), format.mintick)
        actionCol := idmActiveCol
    else if nIdm > 0
        actionTxt := "Attendre le prochain IDM"
        actionCol := rangeCol

    table.cell(dash, 0, 0, "SMV — MOTEUR", text_color=color.white, bgcolor=dashTitleBg, text_size=size.small)
    table.merge_cells(dash, 0, 0, 1, 0)

    table.cell(dash, 0, 1, "Structure SMV (autorise les entrées)", text_color=dashLabelCol, text_size=size.small, bgcolor=dashBgCol)
    table.cell(dash, 1, 1, smvTxt, text_color=smvCol, text_size=size.small, bgcolor=dashBgCol)

    table.cell(dash, 0, 2, "Acheteur / Vendeur maintenant (H1)", text_color=dashLabelCol, text_size=size.small, bgcolor=dashBgCol)
    table.cell(dash, 1, 2, posTxt, text_color=posCol, text_size=size.small, bgcolor=dashBgCol)

    table.cell(dash, 0, 3, "IDM 1 (le plus récent)", text_color=dashLabelCol, text_size=size.small, bgcolor=dashBgCol)
    table.cell(dash, 1, 3, idmWaitTxt, text_color=idmWaitColCell, text_size=size.small, bgcolor=dashBgCol)

    table.cell(dash, 0, 4, "IDM FIGÉ (le niveau à trader)", text_color=dashLabelCol, text_size=size.small, bgcolor=dashBgCol)
    table.cell(dash, 1, 4, frzTxt, text_color=frzCol, text_size=size.small, bgcolor=dashBgCol)

    table.cell(dash, 0, 5, "Le 0.5 (Premium / Discount)", text_color=dashLabelCol, text_size=size.small, bgcolor=dashBgCol)
    table.cell(dash, 1, 5, fibTxt, text_color=fibCol, text_size=size.small, bgcolor=dashBgCol)

    table.cell(dash, 0, 6, "Signature (mèche qui prend l'argent)", text_color=dashLabelCol, text_size=size.small, bgcolor=dashBgCol)
    table.cell(dash, 1, 6, sigTxt, text_color=sigCol, text_size=size.small, bgcolor=dashBgCol)

    // Le prix est-il actuellement DANS un Order Block ou une zone
    // Supply/Demand de ce timeframe ?
    color zoneNowCol = zoneNowDir == 1 ? entryBuyCol : zoneNowDir == -1 ? entrySellCol : dashValueCol
    table.cell(dash, 0, 7, "Zone OB / Supply-Demand", text_color=dashLabelCol, text_size=size.small, bgcolor=dashBgCol)
    table.cell(dash, 1, 7, zoneNowTxt, text_color=zoneNowCol, text_size=size.small, bgcolor=dashBgCol)

    table.cell(dash, 0, 8, "Confluence", text_color=dashLabelCol, text_size=size.small, bgcolor=dashBgCol)
    table.cell(dash, 1, 8, cfTxt, text_color=cfCol, text_size=size.small, bgcolor=dashBgCol)

    table.cell(dash, 0, 9, "Déclencheur", text_color=dashLabelCol, text_size=size.small, bgcolor=dashBgCol)
    table.cell(dash, 1, 9, trigTxt, text_color=trigCol, text_size=size.small, bgcolor=dashBgCol)

    table.cell(dash, 0, 10, "Liquidité cible", text_color=dashLabelCol, text_size=size.small, bgcolor=dashBgCol)
    table.cell(dash, 1, 10, targetDashTxt, text_color=targetDashCol, text_size=size.small, bgcolor=dashBgCol)

    table.cell(dash, 0, 11, "Action", text_color=dashLabelCol, text_size=size.small, bgcolor=dashBgCol)
    table.cell(dash, 1, 11, actionTxt, text_color=actionCol, text_size=size.small, bgcolor=dashBgCol)


//=====================================================================
// PLAN DE TRADE — SL / TP1 / TP2 / TP3 (module 13)
//
// Moteur de gestion repris du "Setup Scanner [GBB]" (échelle de TP,
// suivi du trade, estompage des trades terminés, scoreboard), MAIS
// branché uniquement sur TON signal : la récupération d'IDM
// (entrySignalBuy / entrySignalSell).
//
// Aucun des 6 setups d'origine n'est repris, volontairement :
//   - "Break and retest" = ton BOS + retest : doublon exact.
//   - "Liquidity sweep"  = ton IDM (inducement) : doublon exact.
//   - VWAP / EMA / ORB   = hors SMV, et tu les avais déjà retirés.
// Ajouter les 6 aurait créé des signaux concurrents des tiens et
// fabriqué un scoreboard qui ne mesure plus TA stratégie.
//
// Ce module LIT le moteur, il ne le modifie jamais : la structure, les
// IDM, les Sniper Zones, la Liquidité Cible et le dashboard gardent
// exactement le comportement que tu backtestes déjà.
//
// DEUX ADAPTATIONS SMV par rapport à l'original :
//
//  1. STOP STRUCTUREL (par défaut). L'original pose le stop à une
//     distance fixe en ATR, la même partout. Ici il se place juste
//     derrière l'IDM récupéré : c'est le vrai point d'invalidation de
//     ta stratégie. Si le prix repasse derrière l'IDM, le setup est
//     mort — pas besoin d'une distance arbitraire. Conséquence utile :
//     un retest précis donne un stop serré, donc un R élevé, ce qui
//     récompense automatiquement les Sniper Zones bien placées.
//
//  2. TP3 SUR LA LIQUIDITÉ CIBLE (par défaut). Ton indicateur sait déjà
//     où le prix veut aller. Le dernier objectif se cale dessus au lieu
//     d'un 3R inventé. TP1 et TP2 restent en R pour sécuriser en route.
//=====================================================================
type SmvTrade
    int   dir
    float entry
    float stop
    float t1
    float t2
    float t3
    int   openBar
    int   stage      // 0 = en cours, 1 = TP1 pris, 2 = TP2 pris
    bool  done
    // Le prix a-t-il VRAIMENT quitté le TP2 après l'avoir atteint ?
    // Vrai dès qu'une bougie CLÔTURE au-delà du TP2. Tant que c'est faux,
    // le retour sur le TP2 ne peut pas clôturer le trade — sinon la bougie
    // qui vient de toucher le TP2 le fermerait elle-même, puisque son
    // extrême opposé est forcément encore en deçà.
    bool  leftT2 = false
    box   bRisk
    box   bRwd
    line  lEnt
    line  lT1
    line  lT2
    line  lT3
    label lTag
    label lOut

var array<SmvTrade> smvTrades = array.new<SmvTrade>()

// Compteurs du scoreboard — indice 0 = ACHAT, 1 = VENTE.
var array<int> scFired = array.new_int(2, 0)
var array<int> scT1    = array.new_int(2, 0)
var array<int> scT2    = array.new_int(2, 0)
var array<int> scT3    = array.new_int(2, 0)
var array<int> scStop  = array.new_int(2, 0)
var array<int> scExp   = array.new_int(2, 0)

f_scBump(array<int> a, int i) =>
    array.set(a, i, array.get(a, i) + 1)

// Transparence d'un objet appartenant à un trade terminé.
f_trFade(int liveT) =>
    fadeClosedTr ? math.min(99, liveT + math.round((99 - liveT) * fadeStrength / 100.0)) : liveT

// Un objectif ATTEINT s'efface deux fois moins vite : même une fois le
// trade fini, on doit pouvoir lire jusqu'où il est allé.
f_trFadeKeep(int liveT) =>
    fadeClosedTr ? math.min(99, liveT + math.round((99 - liveT) * fadeStrength / 200.0)) : liveT

f_trOpenCount() =>
    int n = 0
    if array.size(smvTrades) > 0
        for i = 0 to array.size(smvTrades) - 1
            SmvTrade tc = array.get(smvTrades, i)
            if not tc.done
                n += 1
    n

// On ne supprime QUE nos propres objets, jamais box.all / line.all.
f_trKill(SmvTrade t) =>
    box.delete(t.bRisk)
    box.delete(t.bRwd)
    line.delete(t.lEnt)
    line.delete(t.lT1)
    line.delete(t.lT2)
    line.delete(t.lT3)
    label.delete(t.lTag)
    label.delete(t.lOut)

f_trDraw(SmvTrade t) =>
    int l = t.openBar
    int r = bar_index + zoneExt
    if tpZoneShow
        t.bRisk := box.new(l, math.max(t.entry, t.stop), r, math.min(t.entry, t.stop),
             border_color=color.new(slCol, 25), border_width=1,
             bgcolor=color.new(slCol, 88))
        // Zone de gain SANS bordure : ses bords tombent pile sur la ligne
        // d'entrée et sur celle du TP3. Une bordure masquerait le TP3 en
        // pointillés, et un objectif NON atteint se lirait comme atteint.
        t.bRwd := box.new(l, math.max(t.entry, t.t3), r, math.min(t.entry, t.t3),
             border_color=color.new(tpCol, 100), border_width=1,
             bgcolor=color.new(tpCol, 93))
    t.lEnt := line.new(l, t.entry, r, t.entry, color=color.new(#9ba4b0, 10), width=2)
    t.lT1  := line.new(l, t.t1, r, t.t1, color=color.new(tpCol, 10), style=line.style_dashed)
    t.lT2  := line.new(l, t.t2, r, t.t2, color=color.new(tpCol, 30), style=line.style_dashed)
    t.lT3  := line.new(l, t.t3, r, t.t3, color=color.new(tpCol, 50), style=line.style_dashed)
    // AUCUNE ÉTIQUETTE. L'étiquette "▲ ACHAT / ▼ VENTE + SL" qui se posait
    // ici a été supprimée : elle encombrait les bougies pour rien. Les prix
    // d'entrée, de stop et des objectifs se lisent directement sur l'échelle
    // à droite, en face de chaque trait.
    // t.lTag reste dans le type SmvTrade uniquement pour que f_trClose et
    // f_trKill compilent — il vaut toujours na, et label.delete(na) ne fait
    // rien.

// Un trade en cours suit le prix, comme toutes tes autres zones : bord
// droit à bar_index + zoneExt, jamais extend.right.
f_trExtend(SmvTrade t) =>
    int r = bar_index + zoneExt
    if not na(t.bRisk)
        box.set_right(t.bRisk, r)
    if not na(t.bRwd)
        box.set_right(t.bRwd, r)
    line.set_x2(t.lEnt, r)
    line.set_x2(t.lT1, r)
    line.set_x2(t.lT2, r)
    line.set_x2(t.lT3, r)

// Objectif atteint : sa ligne passe en trait plein. Pas d'étiquette en
// plus — elle se poserait sur les bougies, exactement le fouillis dont
// tu te plaignais.
f_trTpHit(line ln) =>
    line.set_style(ln, line.style_solid)
    line.set_color(ln, tpCol)
    line.set_width(ln, 2)

f_trClose(SmvTrade t, string why) =>
    t.done := true
    int r = bar_index
    if not na(t.bRisk)
        box.set_right(t.bRisk, r)
        box.set_bgcolor(t.bRisk, color.new(slCol, f_trFade(88)))
        box.set_border_color(t.bRisk, color.new(slCol, f_trFade(25)))
    if not na(t.bRwd)
        box.set_right(t.bRwd, r)
        box.set_bgcolor(t.bRwd, color.new(tpCol, f_trFade(93)))
    line.set_x2(t.lEnt, r)
    line.set_x2(t.lT1, r)
    line.set_x2(t.lT2, r)
    line.set_x2(t.lT3, r)
    line.set_color(t.lEnt, color.new(#9ba4b0, f_trFade(10)))
    line.set_color(t.lT1, color.new(tpCol, t.stage >= 1 ? f_trFadeKeep(10) : f_trFade(20)))
    line.set_width(t.lT1, t.stage >= 1 ? 2 : 1)
    line.set_color(t.lT2, color.new(tpCol, t.stage >= 2 ? f_trFadeKeep(20) : f_trFade(35)))
    line.set_width(t.lT2, t.stage >= 2 ? 2 : 1)
    line.set_color(t.lT3, color.new(tpCol, why == "TP3" ? f_trFadeKeep(30) : f_trFade(50)))
    line.set_width(t.lT3, why == "TP3" ? 2 : 1)
    if not na(t.lTag)
        label.set_color(t.lTag, color.new(t.dir == 1 ? entryBuyCol : entrySellCol, f_trFade(20)))
        label.set_textcolor(t.lTag, color.new(color.white, f_trFade(0)))
    // AUCUNE ÉTIQUETTE DE RÉSULTAT. Les pastilles "stop" / "TP3" / "expiré"
    // qui se posaient sur la bougie de clôture ont été supprimées. Le trait
    // plein d'un objectif atteint et l'estompage du trade terminé disent
    // déjà comment il s'est fini, sans écrire un mot sur le graphique.
    // Le paramètre `why` continue de piloter tout ça (largeur et opacité des
    // traits juste au-dessus) — seule l'étiquette disparaît.

f_trFire(int dir, float idmLvl) =>
    float riskPx = stopModeStruct and not na(idmLvl) ?
         math.abs(close - idmLvl) + atrFast * stopBufAtr :
         atrFast * stopAtrMult
    // Garde-fou : une entrée pile sur l'IDM donnerait un risque quasi nul,
    // donc des objectifs absurdes et un R fantaisiste dans le scoreboard.
    riskPx := math.max(riskPx, atrFast * 0.3)

    float stPx = dir == 1 ? close - riskPx : close + riskPx
    float p1   = dir == 1 ? close + riskPx * rMul1 : close - riskPx * rMul1
    float p2   = dir == 1 ? close + riskPx * rMul2 : close - riskPx * rMul2
    float p3   = dir == 1 ? close + riskPx * rMul3 : close - riskPx * rMul3

    // TP3 sur la Liquidité Cible — seulement si elle est DEVANT le prix
    // et au-delà du TP2. Sinon le 3R reprend la main automatiquement.
    if tpModeTarget and targetValid and not na(targetLevel)
        bool okTgt = dir == 1 ? targetLevel > p2 : targetLevel < p2
        if okTgt
            p3 := targetLevel

    SmvTrade t = SmvTrade.new(dir=dir, entry=close, stop=stPx, t1=p1, t2=p2, t3=p3,
         openBar=bar_index, stage=0, done=false)
    f_trDraw(t)
    array.push(smvTrades, t)
    f_scBump(scFired, dir == 1 ? 0 : 1)
    t

//---------------------------------------------------------------------
// Avancement des trades ouverts
//---------------------------------------------------------------------
bool trTp1Hit  = false
bool trTp3Hit  = false
bool trStopHit = false
bool trBackT2  = false

if showTradePlan and atrReady and array.size(smvTrades) > 0
    for i = array.size(smvTrades) - 1 to 0
        SmvTrade t = array.get(smvTrades, i)
        if not t.done
            int  di    = t.dir == 1 ? 0 : 1
            bool hitSl = t.dir == 1 ? low <= t.stop  : high >= t.stop
            bool hit1  = t.dir == 1 ? high >= t.t1   : low <= t.t1
            bool hit2  = t.dir == 1 ? high >= t.t2   : low <= t.t2
            bool hit3  = t.dir == 1 ? high >= t.t3   : low <= t.t3

            // Prudent : si le stop et un objectif tombent sur la MÊME
            // bougie, c'est le stop qui gagne. On ne s'invente pas un
            // gain qu'on n'aurait peut-être pas eu — sinon le scoreboard
            // devient un mensonge et ne sert plus à rien.
            if hitSl
                if t.stage == 0
                    f_scBump(scStop, di)
                trStopHit := true
                f_trClose(t, "stop")
            else
                if hit1 and t.stage < 1
                    t.stage := 1
                    f_scBump(scT1, di)
                    f_trTpHit(t.lT1)
                    trTp1Hit := true
                if hit2 and t.stage < 2
                    t.stage := 2
                    f_scBump(scT2, di)
                    f_trTpHit(t.lT2)

                // RETOUR SUR LE TP2 — le trade est déjà gagnant, on ne le
                // laisse pas se faire reprendre. Une fois le TP2 atteint ET
                // vraiment quitté, la première bougie qui revient le toucher
                // clôture le trade sur-le-champ, et la place se libère pour
                // la prochaine opportunité.
                //
                // leftT2 est lu ICI dans son état de la bougie PRÉCÉDENTE
                // (il n'est mis à jour qu'en fin de bloc) : la bougie qui
                // atteint le TP2 ne peut donc jamais se clôturer elle-même.
                bool backT2 = t.stage >= 2 and t.leftT2 and
                     (t.dir == 1 ? low <= t.t2 : high >= t.t2)

                if hit3
                    f_scBump(scT3, di)
                    f_trTpHit(t.lT3)
                    trTp3Hit := true
                    f_trClose(t, "TP3")
                else if backT2
                    trBackT2 := true
                    f_trClose(t, "retour TP2")
                else if bar_index - t.openBar >= maxBarsTr
                    if t.stage == 0
                        f_scBump(scExp, di)
                    f_trClose(t, "expiré")
                else
                    f_trExtend(t)

                // Mise à jour du drapeau EN DERNIER, et uniquement si le
                // trade est encore ouvert : "parti" = une bougie a CLÔTURÉ
                // au-delà du TP2. À partir de la bougie suivante, tout
                // retour sur le TP2 ferme le trade.
                if not t.done and t.stage >= 2 and not t.leftT2
                    if t.dir == 1 ? close > t.t2 : close < t.t2
                        t.leftT2 := true

//---------------------------------------------------------------------
// Ouverture — uniquement sur TON signal, et uniquement dans le SENS DE
// LA STRUCTURE.
//
// RÈGLE 80/20 (continuation) : dans une structure HAUSSIÈRE on ne donne
// que des signaux HAUSSIERS, dans une structure BAISSIÈRE que des
// signaux BAISSIERS. Jamais l'inverse.
//
// La seule chose qui autorise à changer de sens est un vrai BOS
// (retournement) : c'est lui, et lui seul, qui fait basculer
// confirmedTrend (voir plus haut : chochBull -> 1, chochBear -> -1).
// Un BMS de continuation n'y touche jamais. Tant que le BOS n'a pas eu
// lieu, un signal à contre-sens est purement ignoré : pas de trade, et
// rien dans le scoreboard.
//
// confirmedTrend == 0 = aucune structure encore confirmée : on laisse
// passer, il n'y a pas encore de sens à contredire.
//---------------------------------------------------------------------
int  trSigDir = entrySignalBuy ? 1 : entrySignalSell ? -1 : 0
// smvBuyOk / smvSellOk (module 15) remplacent l'ancien test sur
// confirmedTrend : celui-ci basculait sur un creux de 10 bougies, donc un
// simple retracement autorisait des ventes en pleine structure haussière.
// La nouvelle lecture n'accepte le changement de sens que sur clôture
// au-delà du dernier point protégé, et exige en plus la confluence.
bool trDirOk  = trSigDir == 1 ? smvBuyOk : trSigDir == -1 ? smvSellOk : false

if showTradePlan and atrReady and trSigDir != 0 and trDirOk
    if f_trOpenCount() < maxOpenTr
        f_trFire(trSigDir, entryIdmLvl)

// Purge des plus anciens trades TERMINÉS (un trade en cours n'est jamais
// supprimé, même s'il dépasse la limite).
while array.size(smvTrades) > keepTr
    SmvTrade oldT = array.get(smvTrades, 0)
    if oldT.done
        f_trKill(oldT)
        array.shift(smvTrades)
    else
        break


//=====================================================================
// SCOREBOARD — les résultats réels de TA stratégie (module 14)
//
// Chaque ligne vient de trades RÉELLEMENT déclenchés par ton moteur sur
// l'historique du graphique. Rien n'est simulé ni extrapolé.
//
// Lecture des colonnes :
//   tirés    = nombre de fois où un IDM récupéré a ouvert un trade
//   TP1/2/3  = % de ces trades qui ont ATTEINT ce palier
//   stop sec = % stoppés SANS avoir touché TP1 (les vraies pertes)
// Un trade qui touche TP1 puis redescend compte quand même dans TP1 :
// le palier a bien été offert par le marché.
//=====================================================================
f_scPos() =>
    switch scorePosStr
        "En bas à gauche"     => position.bottom_left
        "En haut à gauche"    => position.top_left
        "Au milieu à droite"  => position.middle_right
        => position.bottom_right

f_scPct(int num, int den) =>
    den > 0 ? str.tostring(math.round(100.0 * num / den)) + "%" : "—"

var table scTbl = table.new(f_scPos(), 6, 5, border_width=1,
     frame_color=color.new(color.gray, 60), frame_width=1,
     border_color=color.new(color.gray, 80))

if showScore and barstate.islast
    color scHdrBg = color.new(#5b6472, 82)
    color scHdrTx = #8a94a3
    color scBody  = #c6cdd8
    color scWeak  = color.new(#5b6472, 35)

    int scNbL = array.get(scFired, 0)
    int scNbS = array.get(scFired, 1)
    int scTot = scNbL + scNbS

    table.cell(scTbl, 0, 0, "SMV — RÉSULTATS RÉELS", bgcolor=scHdrBg, text_color=scHdrTx,
         text_size=size.tiny, text_halign=text.align_left)
    table.cell(scTbl, 1, 0, "tirés",    bgcolor=scHdrBg, text_color=scHdrTx, text_size=size.tiny)
    table.cell(scTbl, 2, 0, "TP1",      bgcolor=scHdrBg, text_color=scHdrTx, text_size=size.tiny)
    table.cell(scTbl, 3, 0, "TP2",      bgcolor=scHdrBg, text_color=scHdrTx, text_size=size.tiny)
    table.cell(scTbl, 4, 0, "TP3",      bgcolor=scHdrBg, text_color=scHdrTx, text_size=size.tiny)
    table.cell(scTbl, 5, 0, "stop sec", bgcolor=scHdrBg, text_color=scHdrTx, text_size=size.tiny)

    // Lignes ACHAT (0) et VENTE (1) : savoir si ta stratégie marche mieux
    // à l'achat ou à la vente est une information directement actionnable.
    for d = 0 to 1
        int   scNbD  = array.get(scFired, d)
        color cel = scNbD >= minSampl ? scBody : scWeak
        table.cell(scTbl, 0, d + 1, d == 0 ? "ACHAT" : "VENTE",
             text_color=scNbD >= minSampl ? (d == 0 ? entryBuyCol : entrySellCol) : scWeak,
             text_size=size.tiny, text_halign=text.align_left)
        table.cell(scTbl, 1, d + 1, str.tostring(scNbD), text_color=cel, text_size=size.tiny)
        table.cell(scTbl, 2, d + 1, f_scPct(array.get(scT1, d), scNbD),   text_color=cel, text_size=size.tiny)
        table.cell(scTbl, 3, d + 1, f_scPct(array.get(scT2, d), scNbD),   text_color=cel, text_size=size.tiny)
        table.cell(scTbl, 4, d + 1, f_scPct(array.get(scT3, d), scNbD),   text_color=cel, text_size=size.tiny)
        table.cell(scTbl, 5, d + 1, f_scPct(array.get(scStop, d), scNbD), text_color=cel, text_size=size.tiny)

    color celT = scTot >= minSampl ? color.white : scWeak
    table.cell(scTbl, 0, 3, "TOTAL", bgcolor=scHdrBg, text_color=celT,
         text_size=size.tiny, text_halign=text.align_left)
    table.cell(scTbl, 1, 3, str.tostring(scTot), bgcolor=scHdrBg, text_color=celT, text_size=size.tiny)
    table.cell(scTbl, 2, 3, f_scPct(array.get(scT1, 0) + array.get(scT1, 1), scTot),
         bgcolor=scHdrBg, text_color=celT, text_size=size.tiny)
    table.cell(scTbl, 3, 3, f_scPct(array.get(scT2, 0) + array.get(scT2, 1), scTot),
         bgcolor=scHdrBg, text_color=celT, text_size=size.tiny)
    table.cell(scTbl, 4, 3, f_scPct(array.get(scT3, 0) + array.get(scT3, 1), scTot),
         bgcolor=scHdrBg, text_color=celT, text_size=size.tiny)
    table.cell(scTbl, 5, 3, f_scPct(array.get(scStop, 0) + array.get(scStop, 1), scTot),
         bgcolor=scHdrBg, text_color=celT, text_size=size.tiny)

    // Espérance sous UNE hypothèse explicite, annoncée dans la cellule :
    // on sort tout au TP1, un stop sec coûte 1R, un trade expiré vaut 0.
    // Ce n'est pas une promesse de gain, c'est la seule façon honnête de
    // résumer les colonnes du dessus en un seul chiffre.
    int   nT1All  = array.get(scT1, 0) + array.get(scT1, 1)
    int   nSlAll  = array.get(scStop, 0) + array.get(scStop, 1)
    float espR    = scTot > 0 ? (nT1All * rMul1 - nSlAll * 1.0) / scTot : na
    color espCol  = scTot < minSampl ? scWeak : na(espR) ? scWeak : espR > 0 ? tpCol : slCol
    table.cell(scTbl, 0, 4, "Espérance si sortie au TP1", text_color=scHdrTx,
         text_size=size.tiny, text_halign=text.align_left)
    table.cell(scTbl, 1, 4, na(espR) ? "—" : str.tostring(espR, "#.##") + "R",
         text_color=espCol, text_size=size.tiny)
    table.cell(scTbl, 2, 4, "", text_size=size.tiny)
    table.cell(scTbl, 3, 4, "", text_size=size.tiny)
    table.cell(scTbl, 4, 4, "", text_size=size.tiny)
    table.cell(scTbl, 5, 4, scTot < minSampl ? "trop peu de trades" : "",
         text_color=scWeak, text_size=size.tiny)


//=====================================================================
// SETUP SCANNER [GBB] v1.1 — INTÉGRÉ TEL QUEL (modules 15 à 22)
//
// Les 6 setups d'origine, leur moteur de trade, leur panneau et leur
// scoreboard sont repris À L'IDENTIQUE : VWAP reclaim, EMA pullback,
// Break and retest, Liquidity sweep, RSI divergence, Opening range.
// Aucune mécanique n'a été modifiée.
//
// SEULE ET UNIQUE MODIFICATION — la règle de structure 80/20 :
// dans une structure HAUSSIÈRE, seuls les signaux HAUSSIERS sont
// retenus ; dans une structure BAISSIÈRE, seuls les BAISSIERS. Jamais
// l'inverse. Ce filtre s'appuie sur confirmedTrend, qui ne bascule que
// sur un vrai BOS (retournement) — c'est donc le BOS, et lui seul, qui
// autorise le changement de sens. Il s'applique sur TOUS les timeframes,
// puisque confirmedTrend est recalculé sur le graphique courant.
// Voir smvBuyOk / smvSellOk (module 15), et leurs points d'application.
//
// Ce bloc est totalement indépendant du moteur SMV : il ne lit que
// confirmedTrend, et n'écrit dans aucune variable des modules 1 à 14.
//=====================================================================

const int N_SETUPS = 6

const int S_VWAP  = 0   // VWAP reclaim
const int S_EMA   = 1   // EMA pullback
const int S_BRT   = 2   // Break and retest
const int S_SWEEP = 3   // Liquidity sweep reversal
const int S_DIV   = 4   // RSI divergence
const int S_ORB   = 5   // Opening range break

// setup state
const int ST_OFF     = 0
const int ST_DORMANT = 1
const int ST_FORMING = 2
const int ST_LONG    = 3
const int ST_SHORT   = 4

setupName(int sid) =>
    switch sid
        S_VWAP  => "VWAP reclaim"
        S_EMA   => "EMA pullback"
        S_BRT   => "Break and retest"
        S_SWEEP => "Liquidity sweep"
        S_DIV   => "RSI divergence"
        S_ORB   => "Opening range"
        => "?"

// ═════════════════════════════════════════════════════════════════════
//  INPUTS
// ═════════════════════════════════════════════════════════════════════

var string GS = "19. GBB — Setups"
bool useVwap  = input.bool(true,  "VWAP reclaim",         group = GS)
bool useEma   = input.bool(true,  "EMA pullback (9/21)",  group = GS)
bool useBrt   = input.bool(true,  "Break and retest",     group = GS)
bool useSweep = input.bool(true,  "Liquidity sweep",      group = GS)
bool useDiv   = input.bool(true,  "RSI divergence",       group = GS)
bool useOrb   = input.bool(true,  "Opening range break",  group = GS)

var string GT = "20. GBB — Plan de trade"
float stopAtr  = input.float(1.2, "Stop distance (ATR)",  minval = 0.2, step = 0.1, group = GT)
float r1       = input.float(1.0, "TP1 (R)",              minval = 0.2, step = 0.1, group = GT)
float r2       = input.float(2.0, "TP2 (R)",              minval = 0.2, step = 0.1, group = GT)
float r3       = input.float(3.0, "TP3 (R)",              minval = 0.2, step = 0.1, group = GT)
int   maxOpen  = input.int(1,     "Max concurrent trades", minval = 1, maxval = 5, group = GT)
int   maxBars  = input.int(60,    "Give up after N bars",  minval = 5, group = GT)
int   reentry  = input.int(0,     "Re-entry cooldown (bars)", minval = 0, group = GT,
     tooltip = "Bars to wait after any trade resolves before a new one may open. " +
               "0 keeps every signal, which is why stops cluster back-to-back on impulse bars. " +
               "Changing this changes the scoreboard, so reset counts when you adjust it.")
bool  oneWay   = input.bool(true, "Block opposite-direction entries", group = GT,
     tooltip = "While a long is open, ignore short signals and vice versa.")

var string GF = "21. GBB — Filtres"
int   atrLen   = input.int(14,   "ATR length",             minval = 2,  group = GF)
float volMult  = input.float(1.0,"Volume must exceed x SMA20", minval = 0, step = 0.1, group = GF)
// maxval BORNÉ volontairement : pvLen sert d'index d'historique
// (rsiV[pvLen]). Sans plafond, une valeur saisie au-delà de
// max_bars_back ferait planter le script et effacerait tout le dessin.
int   pvLen    = input.int(5,    "Swing pivot length",     minval = 2, maxval = 100, group = GF)

var string GD = "22. GBB — Affichage"
bool  showZones = input.bool(true,  "Draw trade zones",    group = GD)
int   zoneLen   = input.int(6,      "Project zone N bars ahead", minval = 1, group = GD,
     tooltip = "An open trade's zone extends from entry to the current bar, plus this much " +
               "projection. It stops growing when the trade resolves.")
int   keepTrades= input.int(8,      "Keep last N drawings",minval = 1, maxval = 40, group = GD)

var string GO = "23. GBB — Opening range"
string orSess   = input.session("0930-1600", "Session",     group = GO)
string orTz     = input.string("America/New_York", "Timezone", group = GO,
     tooltip = "Use UTC for 24h crypto and set the session to your chosen anchor.")
int    orMin    = input.int(15, "Range length (minutes)", minval = 1, group = GO)

var string GX = "24. GBB — Réglage fin des setups"
int   vwapAway  = input.int(6,    "VWAP: min bars below before reclaim", minval = 1, group = GX)
int   emaWindow = input.int(3,    "EMA: bars since touch",   minval = 1, group = GX)
float brtTol    = input.float(0.3,"Retest tolerance (ATR)",  minval = 0.05, step = 0.05, group = GX)
int   brtWindow = input.int(20,   "Retest window (bars)",    minval = 2, group = GX)
// maxval borné : sweepLen est la longueur de ta.lowest/ta.highest, donc
// un décalage d'historique. Sans plafond, une valeur au-delà de
// max_bars_back rejouerait le plantage qui efface tout le dessin.
int   sweepLen  = input.int(20,   "Sweep lookback",          minval = 5, maxval = 200, group = GX)
int   divGap    = input.int(60,   "Divergence max pivot gap",minval = 5, group = GX)

// colours — tuned for dark charts. Drop the brightness if you trade on white.
color cLong  = input.color(#00E39A, "Long",    group = GD, inline = "col")
color cShort = input.color(#FF3B6B, "Short",   group = GD, inline = "col")
// (le réglage de couleur "Forming" a été retiré : il ne pilotait plus que
// les bornes de l'Opening Range, elles-mêmes supprimées)
color cEntry = input.color(#9BA4B0, "Entry",   group = GD, inline = "col")

// Réglages du GBB d'origine, valeurs par défaut d'origine. L'étiquette de
// signal nomme le setup qui a tiré (VWAP, EMA, B&R, SWEEP, DIV, ORB) : c'est
// l'information la plus utile du module, elle reste active. Comme les signaux
// ne se déclenchent plus que dans une zone d'IDM (voir le filtre plus bas),
// il y en a beaucoup moins qu'avant et elles n'encombrent plus le graphique.
string gbbLabelMode = input.string("Short", "Signal labels",
     options = ["Full","Short","Arrow only","Off"], group = GD)
bool showOutcomes = input.bool(true, "Show outcome tags (stop / TP3 / expired)", group = GD)
bool showTpLabels = input.bool(false, "Also label TP1 / TP2 on the bar", group = GD,
     tooltip = "Off: a filled target promotes its ladder line to solid instead. " +
               "On: adds a text tag at the hit bar, which will overlap candles on a dense chart.")

var string GL = "25. GBB — Trade en cours"
string liveLbl   = input.string("Small", "Signal label size",
     options = ["Tiny","Small","Normal","Large"], group = GL)
int    liveWidth = input.int(2, "Zone border width", minval = 1, maxval = 4, group = GL)
int    liveFill  = input.int(16, "Risk zone fill strength", minval = 0, maxval = 60, group = GL,
     tooltip = "Higher fills the risk box more solidly. The reward box is kept lighter " +
               "so the two never compete.")

var string GK = "26. GBB — Trade clôturé"
bool   dimClosed  = input.bool(true, "Fade closed trades", group = GK)
int    closedFade = input.int(55, "Fade strength", minval = 0, maxval = 95, group = GK,
     tooltip = "0 leaves resolved trades as bright as the live one. 95 makes them nearly invisible. " +
               "Filled targets always fade less than unfilled ones so you can still read how far each trade got.")
string closedLbl  = input.string("Tiny", "Label size",
     options = ["Off","Tiny","Small","Normal"], group = GK)
bool   closedPill = input.bool(false, "Keep pill background", group = GK,
     tooltip = "Off: resolved labels drop to plain text, which is much quieter on a busy chart.")
// v1.1: outcome tags used to sit exactly on the resolving level, which put the
// "stop" pill straight on top of the candle that hit it (hivebit7's report).
float  outOff     = input.float(0.6, "Outcome tag offset (ATR)", minval = 0, step = 0.1, group = GK,
     tooltip = "Pushes the stop / TP3 / expired tag away from the candles. " +
               "0 restores the old anchored-at-level look.")

//---------------------------------------------------------------------
// RÈGLE 80/20 — la seule modification apportée au GBB.
//
// confirmedTrend vient du moteur de structure SMV plus haut. Il ne
// bascule QUE sur chochBull / chochBear, c'est-à-dire sur un vrai BOS
// (retournement) : un BMS de continuation n'y touche jamais. C'est donc
// bien le BOS qui donne l'autorisation de changer de sens, sur
// n'importe quel timeframe.
//
//   confirmedTrend ==  1 -> structure haussière -> ACHATS seulement
//   confirmedTrend == -1 -> structure baissière -> VENTES seulement
//   confirmedTrend ==  0 -> aucune structure encore confirmée, on
//                           laisse passer : il n'y a rien à contredire.
//
// Appliqué en 3 endroits seulement (L / S / F dans la boucle de tir, et
// anyLong / anyShort pour les marqueurs et les alertes). Le reste du
// GBB est strictement inchangé.
//---------------------------------------------------------------------
// (gbbBullOk / gbbBearOk ont été RETIRÉS : ils lisaient confirmedTrend,
// qui bascule dès qu'un creux des 10 dernières bougies est cassé, donc un
// simple retracement autorisait des ventes en structure haussière. Le
// module 15 les remplace par smvBuyOk / smvSellOk.)

//---------------------------------------------------------------------
// FILTRE ZONE IDM — le deuxième verrou, et le plus important.
//
// Un setup GBB ne vaut rien s'il se déclenche n'importe où. Ici il ne
// peut tirer QUE si le prix de la bougie touche la zone d'un IDM encore
// actif, et seulement dans le SENS de cet IDM :
//   IDM haussier (IDBL) touché -> les setups ACHAT sont autorisés
//   IDM baissier (IDBR) touché -> les setups VENTE sont autorisés
//
// La largeur de la zone n'est pas inventée : c'est atrSniper, exactement
// la même demi-épaisseur que ta Sniper Zone (réglage "Épaisseur avant
// liquidation" du module 3). La zone GBB est donc littéralement la zone
// que ton indicateur dessine déjà autour de chaque IDM.
//
// On LIT idmLevel / idmDir / idmDone, on n'écrit rien dedans : le moteur
// IDM et le module 13 ne sont pas touchés, les deux systèmes restent
// séparés. Le GBB se contente d'attendre le prix au bon endroit.
//---------------------------------------------------------------------
// Le calcul lui-même se trouve PLUS HAUT, juste avant la récupération de
// l'IDM : voir gbbIdmZoneBull / gbbIdmZoneBear. Il ne peut pas être ici,
// car à ce stade du script l'IDM que le prix vient de toucher est DÉJÀ
// marqué "récupéré" et serait donc exclu du test.

// Fade helpers. closedFade slides a live transparency toward invisible; the default
// of 55 reproduces the previous hardcoded look almost exactly.
fadeT(int liveT) =>
    math.min(99, liveT + math.round((99 - liveT) * closedFade / 100.0))

// filled rungs fade at half rate so a resolved trade still shows how far it ran
fadeKeep(int liveT) =>
    math.min(99, liveT + math.round((99 - liveT) * closedFade / 200.0))

lblSize(string s) =>
    switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        => size.tiny

setupTag(int sid) =>
    switch sid
        S_VWAP  => "VWAP"
        S_EMA   => "EMA"
        S_BRT   => "B&R"
        S_SWEEP => "SWEEP"
        S_DIV   => "DIV"
        S_ORB   => "ORB"
        => "?"

// ═════════════════════════════════════════════════════════════════════
//  CONTEXT
// ═════════════════════════════════════════════════════════════════════

float atr    = ta.atr(atrLen)
float ema9   = ta.ema(close, 9)
float ema21  = ta.ema(close, 21)
float ema50  = ta.ema(close, 50)
float rsiV   = ta.rsi(close, 14)
float volMa  = ta.sma(volume, 20)
bool  volOk  = volMult <= 0 or na(volume) or na(volMa) or volume >= volMa * volMult

// NOTE on the volume filter: volOk gates VWAP reclaim, EMA pullback, and the
// liquidity sweep — setups where participation is part of the thesis. Break &
// retest, divergence, and ORB deliberately run without it: a valid retest is
// often quiet, divergence pivots confirm late, and the OR break has the range
// itself as its filter. Keep that in mind when comparing hit rates across rows.

// ta.* must be evaluated on every bar, so this is unconditional.
// On symbols with no volume it returns na and the VWAP setup simply stays off.
float vwapV  = ta.vwap(hlc3)

bool bullBar = close > open
bool bearBar = close < open
bool ready   = barstate.isconfirmed and not na(atr) and atr > 0

// ═════════════════════════════════════════════════════════════════════
//  SETUP 1 — VWAP RECLAIM
//  Price spends time on one side of session VWAP, then closes back across it.
// ═════════════════════════════════════════════════════════════════════

var int belowRun = 0
var int aboveRun = 0

bool vwapValid = useVwap and not na(vwapV)

// ta.crossover/crossunder must evaluate on every bar, so they are hoisted out
// of the short-circuiting `and` chains below.
bool vwapCrossUp = ta.crossover(close, vwapV)
bool vwapCrossDn = ta.crossunder(close, vwapV)

if not na(vwapV)
    belowRun := close < vwapV ? belowRun + 1 : 0
    aboveRun := close > vwapV ? aboveRun + 1 : 0

bool sVwapL = vwapValid and ready and vwapCrossUp and nz(belowRun[1]) >= vwapAway and volOk
bool sVwapS = vwapValid and ready and vwapCrossDn and nz(aboveRun[1]) >= vwapAway and volOk

bool sVwapForm = vwapValid and not sVwapL and not sVwapS and
     ((nz(belowRun) >= vwapAway and close > close[1] and vwapV - close < atr * 0.4) or
      (nz(aboveRun) >= vwapAway and close < close[1] and close - vwapV < atr * 0.4))

// ═════════════════════════════════════════════════════════════════════
//  SETUP 2 — EMA PULLBACK
//  Trend by 21/50, price pulls back into the 9/21 band, then closes away again.
// ═════════════════════════════════════════════════════════════════════

bool trendUp = ema21 > ema50 and ema50 > ema50[3]
bool trendDn = ema21 < ema50 and ema50 < ema50[3]

bool touchedUp = ta.barssince(low  <= ema21) <= emaWindow
bool touchedDn = ta.barssince(high >= ema21) <= emaWindow

bool sEmaL = useEma and ready and trendUp and touchedUp and close > ema9 and bullBar and close > high[1] and volOk
bool sEmaS = useEma and ready and trendDn and touchedDn and close < ema9 and bearBar and close < low[1]  and volOk

bool sEmaForm = useEma and not sEmaL and not sEmaS and
     ((trendUp and low  <= ema21 and close < ema9) or
      (trendDn and high >= ema21 and close > ema9))

// ═════════════════════════════════════════════════════════════════════
//  SETUP 3 — BREAK AND RETEST
//  Break a confirmed swing, come back to it, hold, continue.
// ═════════════════════════════════════════════════════════════════════

float phV = ta.pivothigh(high, pvLen, pvLen)
float plV = ta.pivotlow(low,  pvLen, pvLen)

var float brtHiLvl  = na
var bool  brtHiBrk  = false
var int   brtHiBar  = na
var float brtHiPend = na
var float brtLoLvl  = na
var bool  brtLoBrk  = false
var int   brtLoBar  = na
var float brtLoPend = na

// True while a break is inside its retest window.
brtBusy(bool brk, int brkBar) =>
    brk and not na(brkBar) and bar_index - brkBar <= brtWindow


if not na(phV)
    if brtBusy(brtHiBrk, brtHiBar)
        brtHiPend := phV
    else
        brtHiLvl  := phV
        brtHiBrk  := false
        brtHiPend := na
if not na(plV)
    if brtBusy(brtLoBrk, brtLoBar)
        brtLoPend := plV
    else
        brtLoLvl  := plV
        brtLoBrk  := false
        brtLoPend := na

if not na(brtHiLvl) and not brtHiBrk and close > brtHiLvl
    brtHiBrk := true
    brtHiBar := bar_index
if not na(brtLoLvl) and not brtLoBrk and close < brtLoLvl
    brtLoBrk := true
    brtLoBar := bar_index

bool brtLiveL = useBrt and brtBusy(brtHiBrk, brtHiBar) and bar_index > brtHiBar
bool brtLiveS = useBrt and brtBusy(brtLoBrk, brtLoBar) and bar_index > brtLoBar

bool sBrtL = brtLiveL and ready and low  <= brtHiLvl + atr * brtTol and close > brtHiLvl and bullBar
bool sBrtS = brtLiveS and ready and high >= brtLoLvl - atr * brtTol and close < brtLoLvl and bearBar


if sBrtL
    brtHiBrk := false
if sBrtS
    brtLoBrk := false


if not brtBusy(brtHiBrk, brtHiBar) and not na(brtHiPend)
    brtHiLvl  := brtHiPend
    brtHiBrk  := false
    brtHiPend := na
if not brtBusy(brtLoBrk, brtLoBar) and not na(brtLoPend)
    brtLoLvl  := brtLoPend
    brtLoBrk  := false
    brtLoPend := na

bool sBrtForm = (brtLiveL or brtLiveS) and not sBrtL and not sBrtS

// ═════════════════════════════════════════════════════════════════════
//  SETUP 4 — LIQUIDITY SWEEP REVERSAL
//  Wick takes out a recent extreme, body closes back inside.
// ═════════════════════════════════════════════════════════════════════

float swLo = ta.lowest(low,  sweepLen)[1]
float swHi = ta.highest(high, sweepLen)[1]

bool sSweepL = useSweep and ready and not na(swLo) and low  < swLo and close > swLo and bullBar and
     (close - low)  > (high - close) and volOk
bool sSweepS = useSweep and ready and not na(swHi) and high > swHi and close < swHi and bearBar and
     (high - close) > (close - low)  and volOk

bool sSweepForm = useSweep and not sSweepL and not sSweepS and
     ((not na(swLo) and low < swLo) or (not na(swHi) and high > swHi))

// ═════════════════════════════════════════════════════════════════════
//  SETUP 5 — RSI DIVERGENCE
//  Confirms pvLen bars after the pivot. Late by construction, honest by design.
// ═════════════════════════════════════════════════════════════════════

var float lastPlP = na
var float lastPlR = na
var int   lastPlB = na
var float lastPhP = na
var float lastPhR = na
var int   lastPhB = na

bool divL = false
bool divS = false

if not na(plV)
    float curP = plV
    float curR = rsiV[pvLen]
    if not na(lastPlP) and bar_index - lastPlB <= divGap
        divL := curP < lastPlP and curR > lastPlR
    lastPlP := curP
    lastPlR := curR
    lastPlB := bar_index

if not na(phV)
    float curP = phV
    float curR = rsiV[pvLen]
    if not na(lastPhP) and bar_index - lastPhB <= divGap
        divS := curP > lastPhP and curR < lastPhR
    lastPhP := curP
    lastPhR := curR
    lastPhB := bar_index

bool sDivL = useDiv and ready and divL
bool sDivS = useDiv and ready and divS

// ═════════════════════════════════════════════════════════════════════
//  SETUP 6 — OPENING RANGE BREAK
// ═════════════════════════════════════════════════════════════════════

bool inSess  = not na(time(timeframe.period, orSess, orTz))
bool newSess = inSess and not inSess[1]

var float orH     = na
var float orL     = na
var bool  orDone  = false
var bool  orFired = false
var int   orStart = na


if newSess
    orH     := high
    orL     := low
    orDone  := false
    orFired := false
    orStart := time
else if inSess and not orDone
    if not na(orStart) and (time - orStart) >= orMin * 60000
        orDone := true
    else
        orH := math.max(nz(orH, high), high)
        orL := math.min(nz(orL, low),  low)

bool sOrbL = useOrb and ready and inSess and orDone and not orFired and not na(orH) and close > orH
bool sOrbS = useOrb and ready and inSess and orDone and not orFired and not na(orL) and close < orL

// orFired is shared by both directions on purpose: one OR break per session.
if sOrbL or sOrbS
    orFired := true

bool sOrbForm = useOrb and inSess and orDone and not orFired

// Les deux plot() qui traçaient les bornes de l'Opening Range (orH / orL)
// ont été RETIRÉS. Ils n'apparaissaient que pendant la session, et
// plot.style_linebr coupe le trait dès qu'on en sort : sur un marché qui
// tourne 24h/24, ça semait un petit segment jaune détaché par journée,
// sans rien apporter.
//
// Le setup Opening range lui-même n'est pas touché : orH et orL continuent
// d'être calculés et sOrbL / sOrbS tirent toujours normalement.

// ═════════════════════════════════════════════════════════════════════
//  SIGNAL COLLECTION
// ═════════════════════════════════════════════════════════════════════

longSig(int sid) =>
    switch sid
        S_VWAP  => sVwapL
        S_EMA   => sEmaL
        S_BRT   => sBrtL
        S_SWEEP => sSweepL
        S_DIV   => sDivL
        S_ORB   => sOrbL
        => false

shortSig(int sid) =>
    switch sid
        S_VWAP  => sVwapS
        S_EMA   => sEmaS
        S_BRT   => sBrtS
        S_SWEEP => sSweepS
        S_DIV   => sDivS
        S_ORB   => sOrbS
        => false

formSig(int sid) =>
    switch sid
        S_VWAP  => sVwapForm
        S_EMA   => sEmaForm
        S_BRT   => sBrtForm
        S_SWEEP => sSweepForm
        S_DIV   => false
        S_ORB   => sOrbForm
        => false

enabled(int sid) =>
    switch sid
        S_VWAP  => useVwap
        S_EMA   => useEma
        S_BRT   => useBrt
        S_SWEEP => useSweep
        S_DIV   => useDiv
        S_ORB   => useOrb
        => false

// ═════════════════════════════════════════════════════════════════════
//  TRADE ENGINE
// ═════════════════════════════════════════════════════════════════════

type Trade
    int   sid
    int   dir
    float entry
    float stop
    float t1
    float t2
    float t3
    int   openBar
    int   stage      // 0 open, 1 TP1 hit, 2 TP2 hit
    bool  done
    // Même règle que le module 13 : le prix a-t-il vraiment quitté le TP2
    // (une bougie qui CLÔTURE au-delà) avant de pouvoir y revenir ?
    bool  leftT2 = false
    box   bRisk
    box   bRwd
    line  lEnt
    line  lT1
    line  lT2
    line  lT3
    label lTag
    label lTp1
    label lTp2
    label lTp3
    label lOut

var array<Trade> trades = array.new<Trade>()

var array<int> cFired = array.new_int(N_SETUPS, 0)
var array<int> cT1    = array.new_int(N_SETUPS, 0)
var array<int> cT2    = array.new_int(N_SETUPS, 0)
var array<int> cT3    = array.new_int(N_SETUPS, 0)
var array<int> cStop  = array.new_int(N_SETUPS, 0)
var array<int> cExp   = array.new_int(N_SETUPS, 0)

bump(array<int> a, int i) =>
    array.set(a, i, array.get(a, i) + 1)

openCount() =>
    int n  = 0
    int sz = array.size(trades)
    if sz > 0
        for i = 0 to sz - 1
            Trade t = array.get(trades, i)
            if not t.done
                n += 1
    n


openDir() =>
    int d  = 0
    int sz = array.size(trades)
    if sz > 0
        for i = 0 to sz - 1
            Trade t = array.get(trades, i)
            if not t.done
                d := t.dir
    d

killDrawings(Trade t) =>
    box.delete(t.bRisk)
    box.delete(t.bRwd)
    line.delete(t.lEnt)
    line.delete(t.lT1)
    line.delete(t.lT2)
    line.delete(t.lT3)
    label.delete(t.lTag)
    // outcome and target tags were previously untracked, so culled trades left
    // orphan labels floating with no zone attached
    label.delete(t.lTp1)
    label.delete(t.lTp2)
    label.delete(t.lTp3)
    label.delete(t.lOut)

drawTrade(Trade t) =>
    int l = t.openBar
    int r = t.openBar + zoneLen
    if showZones
        t.bRisk := box.new(l, math.max(t.entry, t.stop), r, math.min(t.entry, t.stop),
             border_color = color.new(cShort, 5), bgcolor = color.new(cShort, 100 - liveFill),
             border_width = liveWidth)
        // The reward box is borderless on purpose: its edges sit exactly on the entry
        // line and the TP3 rung, and a drawn border masks the dashed TP3 line so an
        // unfilled target reads as a filled one.
        t.bRwd  := box.new(l, math.max(t.entry, t.t3),  r, math.min(t.entry, t.t3),
             border_color = color.new(cLong, 100), bgcolor = color.new(cLong, 100 - liveFill / 2),
             border_width = 1)
        t.lEnt  := line.new(l, t.entry, r, t.entry, color = cEntry, width = 2)
        t.lT1   := line.new(l, t.t1, r, t.t1, color = cLong,                style = line.style_dashed, width = 1)
        t.lT2   := line.new(l, t.t2, r, t.t2, color = color.new(cLong, 25), style = line.style_dashed, width = 1)
        t.lT3   := line.new(l, t.t3, r, t.t3, color = color.new(cLong, 45), style = line.style_dashed, width = 1)

    if gbbLabelMode != "Off"
        float off = atr * 0.9
        string txt = switch gbbLabelMode
            "Full"  => (t.dir == 1 ? "▲ " : "▼ ") + setupName(t.sid)
            "Short" => (t.dir == 1 ? "▲ " : "▼ ") + setupTag(t.sid)
            => t.dir == 1 ? "▲" : "▼"
        t.lTag := label.new(t.openBar, t.dir == 1 ? low - off : high + off, txt,
             style = t.dir == 1 ? label.style_label_up : label.style_label_down,
             color = t.dir == 1 ? cLong : cShort,
             textcolor = #0B0F14, size = lblSize(liveLbl))

// An open trade's zone follows price. Without this the box is stranded at the
// entry and a live position looks like a closed one.
extendTrade(Trade t) =>
    if showZones and not na(t.bRisk)
        int r = bar_index + zoneLen
        box.set_right(t.bRisk, r)
        box.set_right(t.bRwd,  r)
        line.set_x2(t.lEnt, r)
        line.set_x2(t.lT1,  r)
        line.set_x2(t.lT2,  r)
        line.set_x2(t.lT3,  r)

openTrade(int sid, int dir) =>
    float risk = atr * stopAtr
    Trade t = Trade.new(
         sid     = sid,
         dir     = dir,
         entry   = close,
         stop    = dir == 1 ? close - risk        : close + risk,
         t1      = dir == 1 ? close + risk * r1   : close - risk * r1,
         t2      = dir == 1 ? close + risk * r2   : close - risk * r2,
         t3      = dir == 1 ? close + risk * r3   : close - risk * r3,
         openBar = bar_index,
         stage   = 0,
         done    = false)
    drawTrade(t)
    array.push(trades, t)
    bump(cFired, sid)
    t

// A filled target promotes its ladder line to solid. The line already sits at the
// exact level and spans the zone, so it can never collide with a candle or with
// another drawing's z-order.
tpMark(line ln, float lvl, string txt) =>
    // GARDE INDISPENSABLE : les lignes lEnt / lT1 / lT2 / lT3 ne sont
    // créées que si "Draw trade zones" est coché. Décoché, elles valent na,
    // et line.set_style(na) lève une erreur d'exécution qui efface tout le
    // graphique. Sans ce test, décocher une simple case vidait l'écran.
    if not na(ln)
        line.set_style(ln, line.style_solid)
        line.set_color(ln, cLong)
        line.set_width(ln, 2)
    label lb = na
    if showTpLabels
        lb := label.new(bar_index, lvl, txt, style = label.style_label_left,
             color = color.new(cLong, 20), textcolor = #0B0F14, size = size.tiny)
    lb

// v0.3: TP pills drawn during the trade's life ("Also label TP1/TP2" on) used
// to survive the close at full brightness while everything else faded. They
// now follow the same closed-trade treatment as the signal tag.
fadeTpLbl(label lb) =>
    if not na(lb)
        if closedLbl == "Off"
            label.delete(lb)
        else if dimClosed and not closedPill
            label.set_style(lb, label.style_none)
            label.set_textcolor(lb, color.new(cLong, fadeT(0) / 2))
        else if dimClosed
            label.set_color(lb, color.new(cLong, fadeT(20)))

closeTrade(Trade t, string why) =>
    t.done := true
    if showZones and not na(t.bRisk)
        box.set_right(t.bRisk, bar_index)
        box.set_right(t.bRwd,  bar_index)
        line.set_x2(t.lEnt, bar_index)
        line.set_x2(t.lT1,  bar_index)
        line.set_x2(t.lT2,  bar_index)
        line.set_x2(t.lT3,  bar_index)
        if dimClosed
            box.set_bgcolor(t.bRisk, color.new(cShort, fadeT(100 - liveFill)))
            box.set_border_color(t.bRisk, color.new(cShort, fadeT(5)))
            box.set_border_width(t.bRisk, 1)
            box.set_bgcolor(t.bRwd, color.new(cLong, fadeT(100 - liveFill / 2)))
            box.set_border_width(t.bRwd, 1)
            line.set_color(t.lEnt, color.new(cEntry, fadeT(0)))
            line.set_width(t.lEnt, 1)
            // a filled rung stays legible after the fade; an unfilled one recedes
            line.set_color(t.lT1, color.new(cLong, t.stage >= 1 ? fadeKeep(0) : fadeT(20)))
            line.set_width(t.lT1, t.stage >= 1 ? 2 : 1)
            line.set_color(t.lT2, color.new(cLong, t.stage >= 2 ? fadeKeep(10) : fadeT(35)))
            line.set_width(t.lT2, t.stage >= 2 ? 2 : 1)
            line.set_color(t.lT3, color.new(cLong, why == "TP3" ? fadeKeep(20) : fadeT(50)))
            line.set_width(t.lT3, why == "TP3" ? 2 : 1)

    if not na(t.lTag)
        if closedLbl == "Off"
            label.delete(t.lTag)
        else
            label.set_size(t.lTag, lblSize(closedLbl))
            if dimClosed and not closedPill
                label.set_style(t.lTag, label.style_none)
                label.set_textcolor(t.lTag, color.new(t.dir == 1 ? cLong : cShort, fadeT(0) / 2))
            else if dimClosed
                label.set_color(t.lTag, color.new(t.dir == 1 ? cLong : cShort, fadeT(0) / 2))

    fadeTpLbl(t.lTp1)
    fadeTpLbl(t.lTp2)
    fadeTpLbl(t.lTp3)

    // When the TP3 hit already drew its own tag (showTpLabels on), the outcome
    // tag at the same level would double up — skip it in that one case.
    bool dupTp3 = why == "TP3" and not na(t.lTp3)
    if showOutcomes and closedLbl != "Off" and not dupTp3
        // v1.1: the tag is anchored to the resolving level but pushed away from
        // price by outOff ATR, and the pill points back AT the level, so it no
        // longer sits on top of the candle that resolved the trade (hivebit7).
        float lvl  = why == "stop" ? t.stop : why == "TP3" ? t.t3 : close
        // stop sits on the far side of price from the targets: long stop below
        // (push down), short stop above (push up). TP3 is the mirror image.
        // expired anchors at close, pushed to the trade's signal side.
        float sgn  = why == "stop" ? (t.dir == 1 ? -1.0 :  1.0) :
                     why == "TP3"  ? (t.dir == 1 ?  1.0 : -1.0) :
                     (t.dir == 1 ? -1.0 : 1.0)
        float yAdj = lvl + sgn * atr * outOff
        color col  = why == "TP3" ? cLong : why == "stop" ? cShort : cEntry
        bool  pill = closedPill or not dimClosed
        // label_up puts the tip at the bottom of the pill, so a tag pushed
        // upward (sgn > 0) uses label_down to point back at its level.
        t.lOut := label.new(bar_index, yAdj, why,
             style     = pill ? (sgn > 0 ? label.style_label_down : label.style_label_up) : label.style_none,
             color     = color.new(col, pill ? 20 : 100),
             textcolor = pill ? #0B0F14 : color.new(col, dimClosed ? fadeT(0) / 2 : 0),
             size      = lblSize(closedLbl))

// ── advance open trades ──────────────────────────────────────────────

var int  lastCloseBar = -99999
bool     closedNow    = false

if ready and array.size(trades) > 0
    for i = array.size(trades) - 1 to 0
        Trade t = array.get(trades, i)
        if not t.done
            bool hitStop = t.dir == 1 ? low  <= t.stop : high >= t.stop
            bool hit1    = t.dir == 1 ? high >= t.t1   : low  <= t.t1
            bool hit2    = t.dir == 1 ? high >= t.t2   : low  <= t.t2
            bool hit3    = t.dir == 1 ? high >= t.t3   : low  <= t.t3

            // conservative: same-bar stop wins
            if hitStop
                if t.stage == 0
                    bump(cStop, t.sid)
                closeTrade(t, "stop")
            else
                if hit1 and t.stage < 1
                    t.stage := 1
                    bump(cT1, t.sid)
                    t.lTp1 := tpMark(t.lT1, t.t1, "TP1")
                if hit2 and t.stage < 2
                    t.stage := 2
                    bump(cT2, t.sid)
                    t.lTp2 := tpMark(t.lT2, t.t2, "TP2")

                // RETOUR SUR LE TP2 — même règle que le module 13. Le trade
                // a déjà atteint le TP2 et l'a vraiment quitté : la première
                // bougie qui revient le toucher clôture, on ne rend pas un
                // gain acquis. leftT2 est lu dans son état de la bougie
                // précédente (mis à jour en fin de bloc).
                bool backT2 = t.stage >= 2 and t.leftT2 and
                     (t.dir == 1 ? low <= t.t2 : high >= t.t2)

                if hit3
                    bump(cT3, t.sid)
                    // v0.2 fix: the TP3 tag is now tracked so killDrawings can
                    // delete it — it can no longer become an orphan label.
                    t.lTp3 := tpMark(t.lT3, t.t3, "TP3")
                    closeTrade(t, "TP3")
                else if backT2
                    closeTrade(t, "retour TP2")
                else if bar_index - t.openBar >= maxBars
                    if t.stage == 0
                        bump(cExp, t.sid)
                    closeTrade(t, "expired")

                // "Parti" = une bougie a CLÔTURÉ au-delà du TP2. Mis à jour
                // en dernier et seulement si le trade est encore ouvert.
                if not t.done and t.stage >= 2 and not t.leftT2
                    if t.dir == 1 ? close > t.t2 : close < t.t2
                        t.leftT2 := true

            if t.done
                closedNow := true
            else
                extendTrade(t)

if closedNow
    lastCloseBar := bar_index

// ── fire new trades ──────────────────────────────────────────────────

var array<int> state = array.new_int(N_SETUPS, ST_OFF)

if ready
    int od = openDir()
    for sid = 0 to N_SETUPS - 1
        if not enabled(sid)
            array.set(state, sid, ST_OFF)
        else
            // RÈGLE 80/20 — point d'application n°1. Un signal contraire
            // à la structure confirmée n'existe tout simplement pas :
            // il n'ouvre pas de trade, ne marque pas le graphique et
            // n'entre pas dans le scoreboard. L'état "forming" est filtré
            // de la même façon, pour que le panneau n'annonce jamais un
            // setup qui ne pourra pas se déclencher.
            // gbbBullOk / gbbBearOk lisaient confirmedTrend, qui bascule
            // sur un creux de 10 bougies : un retracement suffisait à
            // autoriser des ventes en structure haussière. Remplacés par
            // smvBuyOk / smvSellOk (module 15) : cassure du point protégé
            // + confluence exigée.
            bool L = longSig(sid)  and smvBuyOk  and gbbIdmZoneBull
            bool S = shortSig(sid) and smvSellOk and gbbIdmZoneBear
            // F ("forming") n'est pas filtré : formSig() renvoie un seul
            // booléen qui couvre les deux sens à la fois, il n'y a donc
            // aucune direction à filtrer.
            bool F = formSig(sid)
            array.set(state, sid, L ? ST_LONG : S ? ST_SHORT : F ? ST_FORMING : ST_DORMANT)

            bool room  = openCount() < maxOpen
            bool cool  = bar_index - lastCloseBar >= reentry
            bool dirOk = not oneWay or od == 0 or (L and od == 1) or (S and od == -1)

            if L and room and cool and dirOk
                openTrade(sid, 1)
                alert(setupName(sid) + " LONG @ " + str.tostring(close, format.mintick),
                      alert.freq_once_per_bar_close)
            else if S and room and cool and dirOk
                openTrade(sid, -1)
                alert(setupName(sid) + " SHORT @ " + str.tostring(close, format.mintick),
                      alert.freq_once_per_bar_close)

// ── prune old drawings ───────────────────────────────────────────────

if barstate.isconfirmed
    while array.size(trades) > keepTrades
        Trade old = array.shift(trades)
        if old.done
            killDrawings(old)
        else
            array.unshift(trades, old)
            break

// Le panneau GBB (le tableau qui affichait l'état des 6 setups et se
// terminait par la ligne "flat") a été RETIRÉ. Il se posait au même
// endroit que ton dashboard SMV et le poussait vers le bas. Retirés avec
// lui, parce qu'ils ne servaient qu'à lui : les fonctions tablePos() et
// textSize(), et les réglages "Panel position", "Panel text size",
// "Show scoreboard columns" et "Grey out below N samples".
//
// Les compteurs (cFired, cT1, cT2, cT3, cStop, cExp) et le tableau state
// continuent d'être alimentés : la mécanique du GBB n'est pas touchée, et
// tout est prêt si tu veux réafficher un panneau plus tard.

// ═════════════════════════════════════════════════════════════════════
//  ALERTS
// ═════════════════════════════════════════════════════════════════════

// RÈGLE 80/20 — points d'application n°2 et n°3 : les marqueurs sur le
// graphique et les alertes suivent exactement la même règle que les
// entrées. Un signal contraire à la structure ne s'affiche pas et ne
// déclenche aucune alerte.
bool anyLong  = (sVwapL or sEmaL or sBrtL or sSweepL or sDivL or sOrbL) and smvBuyOk  and gbbIdmZoneBull
bool anyShort = (sVwapS or sEmaS or sBrtS or sSweepS or sDivS or sOrbS) and smvSellOk and gbbIdmZoneBear

// Les marqueurs triangulaires du GBB d'origine (plotshape sous / sur la
// bougie d'entrée) ont été RETIRÉS à ta demande. Le réglage "Mark blocked
// signals too" et les variables tookLong / tookShort qui ne servaient qu'à
// les piloter ont été retirés avec eux. Le reste du GBB est intact : les
// trades sont toujours ouverts, dessinés, suivis et comptés normalement.

alertcondition(anyLong,  "GBB — Any long setup",  "Setup Scanner: long signal")
alertcondition(anyShort, "GBB — Any short setup", "Setup Scanner: short signal")


