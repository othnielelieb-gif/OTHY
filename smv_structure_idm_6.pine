alertcondition(bearishPremium, "SMV — Bearish Premium", "SMV : le prix est en Premium dans un mouvement baissier.")
alertcondition(enteredSniperZone, "Prix dans la Sniper Zone", "SMV : le prix vient d'entrer dans la Sniper Zone active (IDM)")
alertcondition(enteredIdmZone, "Prix dans la Zone à retester", "SMV : le prix vient d'entrer dans la Zone à retester (IDM)")
alertcondition(enteredTargetZone, "Prix proche de la liquidité cible", "SMV : le prix vient d'approcher la cible de liquidité (Intact)")
