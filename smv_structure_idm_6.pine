//=====================================================================
// 6. Zones de Liquidité (Intact) — le High/Low le plus récent PAS
// ENCORE balayé par le prix. C'est la liquidité que le marché doit
// aller chercher — la base du module Liquidité Cible juste après.
//=====================================================================
gIL = "11. Liquidité Intact"
showIntact = input.bool(true, "Afficher les niveaux Intact (High/Low en attente)", group=gIL,
     tooltip="Jusqu'à 4 Intact Sellers (les 4 derniers sommets pas encore balayés) et 4 Intact Buyers (les 4 derniers creux pas encore balayés), simultanément. Chaque niveau disparaît dès qu'une bougie le traverse.")
intactBuyCol  = input.color(#4fc3f7, "Couleur Intact Buyers (Low)", group=gIL)
intactSellCol = input.color(#ff8a65, "Couleur Intact Sellers (High)", group=gIL)

//=====================================================================
// 7. Liquidité Cible — l'IDM n'est PAS la destination du prix, c'est
// l'étape où il se ravitaille avant de continuer sa route. La cible
// reste COHÉRENTE avec la case "Acheteur/Vendeur maintenant" (structure
// H1) : Acheteur -> vise un Intact Seller (High non balayé au-dessus).
// Vendeur -> vise un Intact Buyer (Low non balayé en dessous).
//=====================================================================
gLC = "12. Liquidité Cible"
showLiquidityTarget = input.bool(true, "Afficher la cible de liquidité + distance parcourue", group=gLC,
     tooltip="Acheteur (H1) -> cible = Intact Seller (High non balayé au-dessus). Vendeur (H1) -> cible = Intact Buyer (Low non balayé en dessous). Affiche aussi le % du chemin déjà parcouru depuis l'origine du mouvement.")
targetCol = input.color(#ba68c8, "Couleur cible de liquidité", group=gLC)

//=====================================================================
// 8. Order Blocks (OB) — la trace chirurgicale du Smart Money.
// Définition STRICTE : la dernière bougie de couleur OPPOSÉE juste
// avant le mouvement impulsif qui CASSE la structure (BOS ou BMS). Pas
// de cassure = pas d'Order Block. Très étroit (une seule bougie), à
// l'inverse de la zone Supply/Demand large (module 9).
// Un OB s'accompagne presque toujours d'un déséquilibre (FVG) : détecté
// et signalé par une pastille, sans être obligatoire.
// Calculé UNIQUEMENT sur le timeframe du graphique courant — bascule de
// TF pour voir les OB de cette TF-là.
//=====================================================================
gOB = "13. Order Blocks + Breaker Blocks"
showOB = input.bool(true, "Afficher les Order Blocks", group=gOB,
     tooltip="La bougie extrême (le dernier creux avant une impulsion haussière / le dernier sommet avant une impulsion baissière) qui a provoqué la cassure de structure BOS/BMS de TON moteur. Zone étroite et chirurgicale — le niveau précis laissé par les institutionnels. Timeframe courant uniquement.")
obShowBull = input.int(3, "Nombre d'OB haussiers affichés", minval=0, maxval=10, group=gOB)
obShowBear = input.int(3, "Nombre d'OB baissiers affichés", minval=0, maxval=10, group=gOB)
obUseBody = input.bool(false, "Utiliser le corps de bougie (au lieu des mèches)", group=gOB,
     tooltip="Décoché : la zone OB couvre toute la bougie, mèches comprises. Coché : uniquement le corps (open/close), zone plus serrée.")
obBullCol = input.color(color.new(#2962ff, 80), "Couleur OB haussier", group=gOB)
obBearCol = input.color(color.new(#ff5d00, 80), "Couleur OB baissier", group=gOB)
obShowBreaker = input.bool(true, "Activer les Breaker Blocks (OB cassés)", group=gOB,
     tooltip="Quand le prix casse VRAIMENT à travers un Order Block, celui-ci échoue et change de polarité : il devient un Breaker Block. Un ancien OB haussier cassé devient une résistance, et inversement. C'est une confirmation très forte pour la SMV.")
obBullBreakCol = input.color(color.new(#ff1100, 80), "Couleur Breaker issu d'un OB haussier", group=gOB)
obBearBreakCol = input.color(color.new(#0cb51a, 80), "Couleur Breaker issu d'un OB baissier", group=gOB)
obShowFvg = input.bool(true, "Signaler le déséquilibre (FVG) sur l'OB", group=gOB,
     tooltip="Ajoute ⚡ sur l'étiquette quand l'impulsion qui part de l'OB laisse un vrai Fair Value Gap — signe d'un OB de qualité institutionnelle.")
obShowIdmConfluence = input.bool(true, "Signaler la confluence OB + IDM", group=gOB,
     tooltip="Ajoute ★ quand un IDM encore actif tombe À L'INTÉRIEUR de l'Order Block. C'est la confluence la plus forte de la SMV : le niveau où tu attends déjà le prix est aussi celui où les institutionnels ont laissé leur trace.")
obFilter8020 = input.bool(false, "Filtre 80/20 : masquer les OB à contre-tendance", group=gOB,
     tooltip="Décoché par défaut pour que tu voies TOUT. Coché : en tendance confirmée haussière, seuls les OB haussiers restent affichés (et inversement). Les Breaker Blocks ne sont jamais masqués — ils ont changé de polarité.")

//=====================================================================
// 9. Zones Supply / Demand — la version LARGE : toute la base de
// consolidation avant le départ impulsif, pas seulement la bougie
// finale. Sert à voir la zone globale de réaction, là où l'OB (module
// 8) donne le niveau chirurgical à l'intérieur.
// Contrairement à l'OB, une zone S/D n'exige PAS de cassure de
// structure — elle se forme sur toute base suivie d'une impulsion.
//=====================================================================
gSD = "14. Zones Supply / Demand"
showSD = input.bool(true, "Afficher les zones Supply / Demand", group=gSD,
     tooltip="Zone LARGE : toute la base de consolidation (plusieurs bougies) avant le mouvement impulsif. L'Order Block du module 8 est le détail précis à l'intérieur de cette zone.")
sdCount = input.int(3, "Nombre de zones conservées par côté", minval=1, maxval=10, group=gSD)
sdImpulseMult = input.float(1.5, "Force minimale de l'impulsion (x ATR)", minval=0.5, maxval=5.0, step=0.1, group=gSD,
     tooltip="Une base ne devient une zone Supply/Demand que si le mouvement qui en part dépasse cette taille (en multiples d'ATR). Plus grand = moins de zones, mais plus significatives.")
sdMaxBase = input.int(6, "Largeur max de la base (bougies)", minval=2, maxval=20, group=gSD,
     tooltip="Nombre maximum de bougies de consolidation regroupées dans une même zone avant l'impulsion.")
sdDemandCol = input.color(#00897b, "Couleur zone Demand (achat)", group=gSD)
sdSupplyCol = input.color(#d81b60, "Couleur zone Supply (vente)", group=gSD)
sdMitigatedCol = input.color(#90a4ae, "Couleur zone mitigée", group=gSD)

//=====================================================================
// 10. Imbalances (Fair Value Gap) — le vide de prix laissé par une
// impulsion brutale : le marché est passé trop vite, il n'y a pas eu
// d'échange équitable sur cette plage. Le prix revient très souvent
// combler ce vide, ce qui en fait une zone de réaction de premier plan
// — et c'est exactement le déséquilibre qui accompagne un vrai Order
// Block.
//
// Comme toutes les autres zones : s'arrête au prix et le suit, jamais
// d'extension infinie. Se réduit au fur et à mesure qu'elle est
// comblée, et disparaît une fois entièrement remplie.
//=====================================================================
// Ce module ne dessine plus rien : ses boîtes ont été SUPPRIMÉES du
// code. Il alimente le filtre des Order Blocks, le repli de l'IDM 4 et
// le score de confluence.
gFv = "15. Imbalances (FVG) — calcul seul, aucune boîte"
showFvg = input.bool(true, "Calculer les imbalances (FVG)", group=gFv,
     tooltip="Vide de prix sur 3 bougies : le haut de la bougie 1 n'a jamais rencontré le bas de la bougie 3. Les boîtes ne sont plus tracées — elles se superposaient aux Order Blocks et aux Sniper Zones. Le calcul reste indispensable : c'est lui qui autorise ou refuse l'affichage d'un Order Block, qui alimente l'IDM 4 et qui compte dans le score de confluence.")
fvgCount = input.int(4, "Nombre d'imbalances suivies par côté", minval=1, maxval=15, group=gFv)
fvgShrink = input.bool(true, "Réduire l'imbalance au fur et à mesure qu'elle se comble", group=gFv,
     tooltip="Coché : la zone rétrécit à mesure que le prix la remplit, et disparaît une fois entièrement comblée. Décoché : elle garde sa taille d'origine jusqu'à comblement complet.")
fvgMinSize = input.float(0.15, "Taille minimale (x ATR)", minval=0.0, maxval=2.0, step=0.05, group=gFv,
     tooltip="Ignore les micro-gaps sans signification. Plus grand = seules les grosses imbalances sont retenues.")

// L'IDM 3 n'est PLUS tracé sur le graphique. Il reste entièrement
// calculé : il alimente la case « IDM 3 » du dashboard et compte pour
// 1 point dans le score de confluence (module 15). Seul son dessin a
// été supprimé — c'est lui, avec l'IDM 2 et l'IDM 4, qui saturait le
// graphique alors que l'institutionnel ne vise que la PREMIÈRE poche.
gP3 = "16. IDM 3 — H1 confirmé par le M15 et le M5 (calcul seul)"
projTolAtr = input.float(0.6, "Tolérance de confluence (x ATR)", minval=0.1, maxval=3.0, step=0.1, group=gP3,
     tooltip="Écart maximum autorisé entre le niveau H1 et celui vu en M15 / M5 pour dire qu'ils sont d'accord. Plus petit = confluence plus stricte, donc plus rare mais plus fiable.")
projMinTf = input.int(2, "Timeframes minimum d'accord", minval=1, maxval=3, group=gP3,
     tooltip="1 = le H1 seul suffit. 2 = il faut le H1 + (le M15 ou le M5). 3 = les trois doivent être d'accord.")


gTP = "17. Plan de trade — SL / TP1 / TP2 / TP3"
showTradePlan = input.bool(true, "Afficher le plan de trade", group=gTP,
     tooltip="Dès qu'un IDM est récupéré (ton signal d'entrée actuel), l'indicateur pose le stop et les trois objectifs, puis suit le trade jusqu'au bout. Il ne CRÉE aucun signal : il habille uniquement ceux que ton moteur produit déjà. Ta structure, tes IDM, tes Sniper Zones et ta Liquidité Cible ne sont pas touchés.")
stopModeStruct = input.bool(true, "Stop structurel (juste au-delà de l'IDM)", group=gTP,
     tooltip="COCHÉ (recommandé) : le stop se place juste derrière l'IDM récupéré. C'est le vrai point d'invalidation de ta stratégie — si le prix repasse derrière l'IDM, le setup est mort. DÉCOCHÉ : distance fixe en ATR, comme un indicateur générique.")
