//@version=6
indicator("SMV STRUCTURE — Moteur fractal (IDM/Reteste)", "SMV Engine", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

//=====================================================================
// MOTEUR DE CALCUL vs AFFICHAGE
//
// Indicateur volontairement resserré autour de la vraie stratégie :
// Structure -> IDM -> Sniper Zone (le reteste précis) -> Liquidité
// cible. Tout le reste (Premium/Discount, FVG, Supply/Demand, Sessions,
// VWAP, Biais Multi-TF, OTHY Radar) a été retiré volontairement — soit
// inutile, soit remplacé par plus simple.
//
// Structure BOS/BMS : moteur fusionné depuis "SMC Structures and FVG"
// (LudoGH68), groupe de réglages "1b". Terminologie volontairement
// inversée par rapport à l'original : ici BOS = RETOURNEMENT (pilote
// confirmedTrend, fast-track sans attendre 3 bougies) et BMS =
// CONTINUATION (attend la confirmation sur 3 bougies).
//
// Le calcul (structure, BOS, BMS, mouvement, 0.5, IDM, récupération,
// phases) tourne TOUJOURS en interne, même quand un module d'affichage
// est désactivé — désactiver un module n'affecte jamais le calcul d'un
// autre.
//
// "Acheteur/Vendeur maintenant" et la Liquidité Cible se fient
// UNIQUEMENT à la structure H1 (h1Bias, via request.security) — jamais
// au chart courant. Haussier H1 -> acheteur -> cible = Intact Seller.
// Baissier H1 -> vendeur -> cible = Intact Buyer. C'est la seule règle,
// on ne mélange rien d'autre.
//
// L'IDM reste l'élément CENTRAL : c'est là que le prix se ravitaille en
// liquidité avant de continuer sa route vers l'objectif (module
// Liquidité Cible). La Sniper Zone est LE reteste précis, rattachée
// uniquement à l'IDM — préparée dès sa formation, supprimée dès que le
// prix la liquide pour de bon.
//
// Logique fractale : zigzag auto-calibré sur l'ATR par défaut (aucun
// réglage), avec un mode Manuel classique par nombre de bougies
// (ta.pivothigh/pivotlow) si tu préfères garder la main dessus.
//
// Fenêtre d'analyse par timeframe (inLookback, voir plus bas) : chaque
// timeframe n'analyse que sa propre fenêtre récente (Monthly 4 ans,
// Weekly 2 ans, Daily 6 mois, 4H 25 jours, 1H 8 jours, M15/M5 12h) —
// jamais de contamination d'un timeframe par un autre.
//=====================================================================

//=====================================================================
// 0. Affichage des zones — règle GLOBALE valable pour TOUTES les zones
// (Order Blocks, Breakers, Supply/Demand, Imbalances, Sniper Zone,
// liquidité Intact, liquidité cible).
//
// Aucune zone ne part à l'infini vers la droite : chacune s'arrête au
// niveau du prix actuel et AVANCE avec lui, bougie après bougie. Le
// réglage ci-dessous n'est qu'une petite marge de respiration pour que
// les étiquettes restent lisibles, jamais une extension infinie.
//=====================================================================
gZ = "0. Affichage des zones"
zoneExt = input.int(3, "Marge au-delà du prix (bougies)", minval=0, maxval=30, group=gZ,
     tooltip="Toutes les zones s'arrêtent au prix actuel et le suivent. Cette valeur n'ajoute qu'une petite marge à droite pour la lisibilité des étiquettes. 0 = la zone colle exactement à la bougie en cours.")

//=====================================================================
// 1. Structure
//=====================================================================
gS = "1. Structure"
showStruct   = input.bool(true, "Afficher HH / HL / LH / LL", group=gS,
     tooltip="C'est le seul marquage qui apparaît dès qu'un swing structurel est confirmé, sans attendre l'IDM — la façon la plus rapide de voir un HL/LH se former.")
pivMode      = input.string("Auto", "Sensibilité des pivots", options=["Auto", "Manuel"], group=gS,
     tooltip="Auto (recommandé) : le seuil du zigzag s'auto-calibre sur l'ATR du moment (+ paliers 1/2/3 spécifiques M5/M15), pour que les VRAIS IDM sortent correctement sur chaque timeframe. Manuel : réglage classique par nombre de bougies (ta.pivothigh/pivotlow) — ce même réglage détermine aussi où se placent/se déplacent les pivots, donc les IDM.")
pivLenManual = input.int(1, "Sensibilité manuelle (bougies)", minval=1, maxval=50, group=gS,
     tooltip="Actif seulement si Sensibilité des pivots = Manuel. Compte 1 par 1 : plus petit = plus de pivots détectés (plus sensible, 1 = le plus sensible possible). Plus grand = moins de pivots (plus filtré).")
bullCol      = input.color(#26a69a, "Couleur haussière", group=gS)
bearCol      = input.color(#ef5350, "Couleur baissière", group=gS)
rangeCol     = input.color(#9e9e9e, "Couleur consolidation", group=gS)

//=====================================================================
// 1b. Cassures de structure — moteur fusionné depuis "SMC Structures and
// FVG" (LudoGH68) : mêmes réglages que l'indicateur d'origine (cassure
// par corps de bougie ou mèche, couleurs/style/épaisseur séparés,
// historique). Seule la terminologie change : ici BOS = RETOURNEMENT
// (pilote confirmedTrend), BMS = CONTINUATION — inversé par rapport à
// l'indicateur d'origine, à ta demande.
//=====================================================================
gB = "1b. Cassures de structure — BOS (retournement) / BMS (continuation)"
isStructBodyCandleBreak = input.bool(true, "Cassure validée par la clôture (corps de bougie)", group=gB,
     tooltip="Coché (recommandé) : une cassure n'est validée que si le CORPS de la bougie (close) dépasse le niveau. Décoché : la mèche (high/low) suffit. Pilote aussi confirmedTrend (IDM, Sniper Zone, Liquidité Cible, Acheteur/Vendeur maintenant).")
bosBullColor = input.color(color.yellow, "Couleur BOS haussier (retournement)", group=gB)
bosBearColor = input.color(color.yellow, "Couleur BOS baissier (retournement)", group=gB)
bosLineStyleOption = input.string("─", "Style BOS", options=["─", "┈", "╌"], group=gB)
bosLineWidth = input.int(1, "Épaisseur BOS", minval=1, maxval=5, group=gB)
bmsBullColor = input.color(color.silver, "Couleur BMS haussier (continuation)", group=gB)
bmsBearColor = input.color(color.silver, "Couleur BMS baissier (continuation)", group=gB)
bmsLineStyleOption = input.string("─", "Style BMS", options=["─", "┈", "╌"], group=gB)
bmsLineWidth = input.int(1, "Épaisseur BMS", minval=1, maxval=5, group=gB)
structHistoryNbr = input.int(10, "Nombre de cassures affichées (historique)", minval=1, maxval=50, group=gB)
showCurrentStruct = input.bool(true, "Afficher la structure actuelle (ligne en cours)", group=gB)
currentStructColor = input.color(color.blue, "Couleur structure actuelle", group=gB)
currentStructLineStyleOption = input.string("─", "Style structure actuelle", options=["─", "┈", "╌"], group=gB)
currentStructLineWidth = input.int(1, "Épaisseur structure actuelle", minval=1, maxval=5, group=gB)

f_getLineStyle(string lineOption) =>
    lineOption == "┈" ? line.style_dotted : lineOption == "╌" ? line.style_dashed : line.style_solid

bosLineStyle = f_getLineStyle(bosLineStyleOption)
bmsLineStyle = f_getLineStyle(bmsLineStyleOption)
currentStructLineStyle = f_getLineStyle(currentStructLineStyleOption)

// Bar du plus haut / plus bas significatif sur les 10 dernières bougies
// (sert à replacer bosHigh/bosLow après une cassure) — porté tel quel
// depuis get_structure_highest_bar/get_structure_lowest_bar.
f_structHighestBar(int lookback) =>
    int idx = 0
    int maxBar = bar_index > lookback ? ta.highestbars(high, lookback) : ta.highestbars(high, bar_index + 1)
    for i = 0 to lookback - 1
        if high[i+1] > high[i+2] and high[i] <= high[i+1] and ((i+1) * -1) >= maxBar
            idx := (i+1) * -1
    idx := idx == 0 ? maxBar : idx
    idx

f_structLowestBar(int lookback) =>
    int idx = 0
    int minBar = bar_index > lookback ? ta.lowestbars(low, lookback) : ta.lowestbars(low, bar_index + 1)
    for i = 0 to lookback - 1
        if low[i+1] < low[i+2] and low[i] >= low[i+1] and ((i+1) * -1) >= minBar
            idx := (i+1) * -1
    idx := idx == 0 ? minBar : idx
    idx

// Rejoue le MÊME moteur bosHigh/bosLow/bias (sans aucun dessin — ni
// line.new, ni box.new, ni array — donc utilisable tel quel dans
// request.security, contrairement à `bias` du chart courant qui, lui,
// est calculé dans le même bloc que les lignes BOS/BMS). C'est CETTE
// fonction, appelée sur H1, qui pilote "Acheteur/Vendeur maintenant".
f_h1Bias() =>
    var float sHigh = na
    var float sLow  = na
    var int   sHighBar = 0
    var int   sLowBar  = 0
    var int   sBias    = 0

    if bar_index == 0
        sHigh := high
        sLow  := low
        sHighBar := bar_index
        sLowBar  := bar_index

    int sMaxBar = bar_index + f_structHighestBar(10)
    int sMinBar = bar_index + f_structLowestBar(10)

    float lowPx  = isStructBodyCandleBreak ? close : low
    float highPx = isStructBodyCandleBreak ? close : high

    bool lowBroken =
         (lowPx < sLow and lowPx[1] >= sLow and lowPx[2] >= sLow and lowPx[3] >= sLow and
          bar_index[1] > sLowBar and bar_index[2] > sLowBar and bar_index[3] > sLowBar) or
         (sBias == 1 and lowPx < sLow)

    bool highBroken =
         (highPx > sHigh and highPx[1] <= sHigh and highPx[2] <= sHigh and highPx[3] <= sHigh and
          bar_index[1] > sHighBar and bar_index[2] > sHighBar and bar_index[3] > sHighBar) or
         (sBias == -1 and highPx > sHigh)

    if lowBroken
        sBias := -1
        sHighBar := sMaxBar
        sLowBar  := bar_index
        sHigh := high[bar_index - sHighBar]
        sLow  := low
    else if highBroken
        sBias := 1
        sHighBar := bar_index
        sLowBar  := sMinBar
        sHigh := high
        sLow  := low[bar_index - sLowBar]
    else
        if high > sHigh and (sBias == 0 or sBias == 1)
            if not isStructBodyCandleBreak or not (bar_index[1] > sHighBar and bar_index[2] > sHighBar and bar_index[3] > sHighBar)
                sHigh := high
                sHighBar := bar_index
        else if low < sLow and (sBias == 0 or sBias == -1)
            if not isStructBodyCandleBreak or not (bar_index[1] > sLowBar and bar_index[2] > sLowBar and bar_index[3] > sLowBar)
                sLow := low
                sLowBar := bar_index

    sBias

//=====================================================================
// 2. IDM (Inducement) — LE plus important : c'est là que tu attends le
// prix. Chaque nouveau candidat REMPLACE l'ancien (qui devient FS,
// historique figé ou supprimé selon le réglage) — l'IDM se déplace,
// c'est normal, le dashboard suit toujours le plus récent aligné avec
// la structure actuelle.
//=====================================================================
gI = "2. IDM (Inducement) — LE plus important"
showIdmLines  = input.bool(true, "Afficher les 2 IDM actifs (lignes + étiquettes)", group=gI,
     tooltip="Les deux IDM les plus récents — ceux qui comptent vraiment pour trader. Toujours prioritaires sur tout le reste de l'indicateur.")
showFsHistory = input.bool(false, "Afficher l'historique FS (anciens IDM figés)", group=gI,
     tooltip="Décoché par défaut pour garder le graphique lisible. Une fois décoché, les anciens IDM (devenus FS) sont simplement supprimés dès qu'ils sortent du top 2, au lieu de rester affichés en grisé.")
idmActiveCol = input.color(#ab47bc, "IDM #1 — le plus récent (vrai signal à venir)", group=gI)
idmWaitCol   = input.color(#ff9800, "IDM #2 — juste avant", group=gI)
fsCol        = input.color(#9e9e9e, "FS (historique, plus ancien)", group=gI)
idmDoneCol   = input.color(#26c6da, "Marqueur \"retesté\"", group=gI)
entryBuyCol  = input.color(#00e676, "Couleur achat", group=gI)
entrySellCol = input.color(#ff1744, "Couleur vente", group=gI)
maxHistory   = input.int(100, "Nombre max d'IDM historiques", minval=10, maxval=200, group=gI)

// L'IDM doit se DÉPLACER à chaque nouvelle cassure, même petite. La
// sensibilité de la structure est volontairement grossière (pour ne
// retenir que les vrais BOS/BMS) : elle raterait les petits swings
// intermédiaires où le prix vient pourtant se ravitailler. D'où un
// détecteur de pivots DÉDIÉ à l'IDM, plus fin et indépendant.
idmFineDetect = input.bool(true, "Détection fine de l'IDM (suit aussi les petites cassures)", group=gI,
     tooltip="Activé : l'IDM utilise son propre détecteur de pivots, plus sensible que celui de la structure. Il se déplace donc aussi sur les petits swings, pas seulement sur les grandes cassures. Sans effet en mode de pivots Manuel, où tu règles déjà la sensibilité toi-même.")
idmFineRatio = input.float(0.45, "Finesse de la détection IDM", minval=0.10, maxval=1.00, step=0.05, group=gI,
     tooltip="Fraction du seuil de la structure. 0.45 = l'IDM réagit à des swings environ deux fois plus petits que ceux qui déclenchent un BOS/BMS. Plus petit = IDM plus réactif.")
idmEmphasis = input.bool(true, "Mettre l'IDM bien en évidence", group=gI,
     tooltip="L'IDM est le cœur de la stratégie : il doit se repérer d'un coup d'œil. Trait plein et épais au lieu d'un pointillé fin, étiquette avec la direction et le niveau exact.")
idmWidthBoost = input.int(4, "Épaisseur du trait IDM", minval=1, maxval=6, group=gI)

//=====================================================================
// 3. Sniper Zone — LE reteste précis, rattachée UNIQUEMENT à l'IDM.
// Préparée dès la formation de l'IDM, affinée sur la bougie exacte de
// récupération ("chandelier qui prend l'argent"), supprimée dès que le
// prix part pour de bon.
//=====================================================================
gSn = "3. Sniper Zone (liée à l'IDM)"
showSniperZone = input.bool(true, "Afficher la Sniper Zone", group=gSn,
     tooltip="Bande fine préparée à l'IDM — visible seulement en attente, supprimée dès que le prix part pour le vrai mouvement.")
sniperSize = input.float(0.12, "Épaisseur avant liquidation (x ATR)", minval=0.02, maxval=0.5, step=0.02, group=gSn,
     tooltip="Bande fine autour de l'IDM, préparée dès sa formation.")
sniperCol  = input.color(#ffd54f, "Couleur Sniper Zone", group=gSn)
showSniperRefine = input.bool(true, "Affiner sur la bougie de récupération (intrabar)", group=gSn,
     tooltip="Dès que l'IDM est récupéré, resserre la zone sur le niveau exact touché par la mèche de LA bougie qui fait la prise de liquidité, au lieu de la bande ATR large. 100% intrabar, même timeframe.")
refineCol = input.color(#26c6da, "Couleur zone affinée", group=gSn)

//=====================================================================
// 4. Phases — repères Wyckoff SC/STB/SPRING/BC/UT/UTAD, purement
// informatifs (bons endroits pour préparer un trade). Pas de zone
// d'intervention ni d'étiquette d'entrée séparée — l'IDM et la Sniper
// Zone restent les seules zones d'action.
//=====================================================================
gPh = "4. Phases"
showPhaseBox     = input.bool(true, "Afficher le rectangle Accumulation/Distribution", group=gPh)
showPhaseMarkers = input.bool(true, "Afficher SC / STB / SPRING / BC / UT / UTAD", group=gPh)
phaseCol         = input.color(#ffa726, "Couleur manipulations (STB/SPRING/UT/UTAD)", group=gPh)

//=====================================================================
// 5. Dashboard
//=====================================================================
gD = "5. Dashboard"
showDash     = input.bool(true, "Afficher le tableau de bord", group=gD)
dashLabelCol = input.color(#b0bec5, "Couleur des libellés", group=gD)
dashValueCol = input.color(#ffffff, "Couleur des valeurs neutres", group=gD)
dashBgCol    = input.color(color.new(#101418, 15), "Fond des cellules", group=gD)
dashTitleBg  = input.color(#0d47a1, "Fond du titre", group=gD)

//=====================================================================
// 6. Zones de Liquidité (Intact) — le High/Low le plus récent PAS
// ENCORE balayé par le prix. C'est la liquidité que le marché doit
// aller chercher — la base du module Liquidité Cible juste après.
//=====================================================================
gIL = "6. Zones de Liquidité (Intact)"
showIntact = input.bool(true, "Afficher les niveaux Intact (High/Low en attente)", group=gIL,
     tooltip="Jusqu'à 4 Intact Sellers (les 4 derniers sommets pas encore balayés) et 4 Intact Buyers (les 4 derniers creux pas encore balayés), simultanément. Chaque niveau disparaît dès qu'une bougie le traverse.")
intactBuyCol  = input.color(#4fc3f7, "Couleur Intact Buyers (Low)", group=gIL)
intactSellCol = input.color(#ff8a65, "Couleur Intact Sellers (High)", group=gIL)

//=====================================================================
// 7. Liquidité Cible — l'IDM n'est PAS la destination du prix, c'est
// l'étape où il se ravitaille avant de continuer sa route. La cible
// reste COHÉRENTE avec la case "Acheteur/Vendeur maintenant" (structure
// H1) : Acheteur -> vise un Intact Seller (High non balayé au-dessus).
// Vendeur -> vise un Intact Buyer (Low non balayé en dessous).
//=====================================================================
gLC = "7. Liquidité Cible"
showLiquidityTarget = input.bool(true, "Afficher la cible de liquidité + distance parcourue", group=gLC,
     tooltip="Acheteur (H1) -> cible = Intact Seller (High non balayé au-dessus). Vendeur (H1) -> cible = Intact Buyer (Low non balayé en dessous). Affiche aussi le % du chemin déjà parcouru depuis l'origine du mouvement.")
targetCol = input.color(#ba68c8, "Couleur cible de liquidité", group=gLC)

//=====================================================================
// 8. Order Blocks (OB) — la trace chirurgicale du Smart Money.
// Définition STRICTE : la dernière bougie de couleur OPPOSÉE juste
// avant le mouvement impulsif qui CASSE la structure (BOS ou BMS). Pas
// de cassure = pas d'Order Block. Très étroit (une seule bougie), à
// l'inverse de la zone Supply/Demand large (module 9).
// Un OB s'accompagne presque toujours d'un déséquilibre (FVG) : détecté
// et signalé par une pastille, sans être obligatoire.
// Calculé UNIQUEMENT sur le timeframe du graphique courant — bascule de
// TF pour voir les OB de cette TF-là.
//=====================================================================
gOB = "8. Order Blocks (OB) + Breaker Blocks"
showOB = input.bool(true, "Afficher les Order Blocks", group=gOB,
     tooltip="La bougie extrême (le dernier creux avant une impulsion haussière / le dernier sommet avant une impulsion baissière) qui a provoqué la cassure de structure BOS/BMS de TON moteur. Zone étroite et chirurgicale — le niveau précis laissé par les institutionnels. Timeframe courant uniquement.")
obShowBull = input.int(3, "Nombre d'OB haussiers affichés", minval=0, maxval=10, group=gOB)
obShowBear = input.int(3, "Nombre d'OB baissiers affichés", minval=0, maxval=10, group=gOB)
obUseBody = input.bool(false, "Utiliser le corps de bougie (au lieu des mèches)", group=gOB,
     tooltip="Décoché : la zone OB couvre toute la bougie, mèches comprises. Coché : uniquement le corps (open/close), zone plus serrée.")
obBullCol = input.color(color.new(#2962ff, 80), "Couleur OB haussier", group=gOB)
obBearCol = input.color(color.new(#ff5d00, 80), "Couleur OB baissier", group=gOB)
obShowBreaker = input.bool(true, "Activer les Breaker Blocks (OB cassés)", group=gOB,
     tooltip="Quand le prix casse VRAIMENT à travers un Order Block, celui-ci échoue et change de polarité : il devient un Breaker Block. Un ancien OB haussier cassé devient une résistance, et inversement. C'est une confirmation très forte pour la SMV.")
obBullBreakCol = input.color(color.new(#ff1100, 80), "Couleur Breaker issu d'un OB haussier", group=gOB)
obBearBreakCol = input.color(color.new(#0cb51a, 80), "Couleur Breaker issu d'un OB baissier", group=gOB)
obShowFvg = input.bool(true, "Signaler le déséquilibre (FVG) sur l'OB", group=gOB,
     tooltip="Ajoute ⚡ sur l'étiquette quand l'impulsion qui part de l'OB laisse un vrai Fair Value Gap — signe d'un OB de qualité institutionnelle.")
obShowIdmConfluence = input.bool(true, "Signaler la confluence OB + IDM", group=gOB,
     tooltip="Ajoute ★ quand un IDM encore actif tombe À L'INTÉRIEUR de l'Order Block. C'est la confluence la plus forte de la SMV : le niveau où tu attends déjà le prix est aussi celui où les institutionnels ont laissé leur trace.")
obFilter8020 = input.bool(false, "Filtre 80/20 : masquer les OB à contre-tendance", group=gOB,
     tooltip="Décoché par défaut pour que tu voies TOUT. Coché : en tendance confirmée haussière, seuls les OB haussiers restent affichés (et inversement). Les Breaker Blocks ne sont jamais masqués — ils ont changé de polarité.")

//=====================================================================
// 9. Zones Supply / Demand — la version LARGE : toute la base de
// consolidation avant le départ impulsif, pas seulement la bougie
// finale. Sert à voir la zone globale de réaction, là où l'OB (module
// 8) donne le niveau chirurgical à l'intérieur.
// Contrairement à l'OB, une zone S/D n'exige PAS de cassure de
// structure — elle se forme sur toute base suivie d'une impulsion.
//=====================================================================
gSD = "9. Zones Supply / Demand"
showSD = input.bool(true, "Afficher les zones Supply / Demand", group=gSD,
     tooltip="Zone LARGE : toute la base de consolidation (plusieurs bougies) avant le mouvement impulsif. L'Order Block du module 8 est le détail précis à l'intérieur de cette zone.")
sdCount = input.int(3, "Nombre de zones conservées par côté", minval=1, maxval=10, group=gSD)
sdImpulseMult = input.float(1.5, "Force minimale de l'impulsion (x ATR)", minval=0.5, maxval=5.0, step=0.1, group=gSD,
     tooltip="Une base ne devient une zone Supply/Demand que si le mouvement qui en part dépasse cette taille (en multiples d'ATR). Plus grand = moins de zones, mais plus significatives.")
sdMaxBase = input.int(6, "Largeur max de la base (bougies)", minval=2, maxval=20, group=gSD,
     tooltip="Nombre maximum de bougies de consolidation regroupées dans une même zone avant l'impulsion.")
sdDemandCol = input.color(#00897b, "Couleur zone Demand (achat)", group=gSD)
sdSupplyCol = input.color(#d81b60, "Couleur zone Supply (vente)", group=gSD)
sdMitigatedCol = input.color(#90a4ae, "Couleur zone mitigée", group=gSD)

//=====================================================================
// 10. Imbalances (Fair Value Gap) — le vide de prix laissé par une
// impulsion brutale : le marché est passé trop vite, il n'y a pas eu
// d'échange équitable sur cette plage. Le prix revient très souvent
// combler ce vide, ce qui en fait une zone de réaction de premier plan
// — et c'est exactement le déséquilibre qui accompagne un vrai Order
// Block.
//
// Comme toutes les autres zones : s'arrête au prix et le suit, jamais
// d'extension infinie. Se réduit au fur et à mesure qu'elle est
// comblée, et disparaît une fois entièrement remplie.
//=====================================================================
gFv = "10. Imbalances (FVG)"
showFvg = input.bool(true, "Afficher les imbalances (FVG)", group=gFv,
     tooltip="Vide de prix sur 3 bougies : le haut de la bougie 1 n'a jamais rencontré le bas de la bougie 3. Le prix revient presque toujours le combler.")
fvgCount = input.int(4, "Nombre d'imbalances par côté", minval=1, maxval=15, group=gFv)
fvgBullCol = input.color(color.new(#26a69a, 82), "Couleur imbalance haussière", group=gFv)
fvgBearCol = input.color(color.new(#ef5350, 82), "Couleur imbalance baissière", group=gFv)
fvgShrink = input.bool(true, "Réduire l'imbalance au fur et à mesure qu'elle se comble", group=gFv,
     tooltip="Coché : la zone rétrécit à mesure que le prix la remplit, et disparaît une fois entièrement comblée. Décoché : elle garde sa taille d'origine jusqu'à comblement complet.")
fvgMinSize = input.float(0.15, "Taille minimale (x ATR)", minval=0.0, maxval=2.0, step=0.05, group=gFv,
     tooltip="Ignore les micro-gaps sans signification. Plus grand = seules les grosses imbalances sont retenues.")

gP3 = "11. IDM 3 — H1 confirmé par le M15 et le M5"
showProjIdm = input.bool(true, "Afficher l'IDM 3 (multi-timeframe)", group=gP3,
     tooltip="Niveau ANCRÉ sur le H1 (le timeframe de décision) et CONFIRMÉ par le M15 et le M5. Ce n'est pas un pivot du graphique courant : c'est l'endroit où les trois lectures se rejoignent. Il disparaît dès que le prix l'a touché, ou dès que la structure H1 s'inverse.")
projIdmCol = input.color(#00e5ff, "Couleur IDM 3", group=gP3)
projTolAtr = input.float(0.6, "Tolérance de confluence (x ATR)", minval=0.1, maxval=3.0, step=0.1, group=gP3,
     tooltip="Écart maximum autorisé entre le niveau H1 et celui vu en M15 / M5 pour dire qu'ils sont d'accord. Plus petit = confluence plus stricte, donc plus rare mais plus fiable.")
projMinTf = input.int(2, "Timeframes minimum d'accord pour l'afficher", minval=1, maxval=3, group=gP3,
     tooltip="1 = le H1 seul suffit. 2 = il faut le H1 + (le M15 ou le M5). 3 = les trois doivent être d'accord.")
projShowZone = input.bool(true, "Afficher la zone autour du niveau", group=gP3)

gP4 = "12. IDM 4 — toujours entre l'IDM 1 et l'IDM 2"
showIdm4 = input.bool(true, "Afficher l'IDM 4", group=gP4,
     tooltip="Par construction, l'IDM 4 est TOUJOURS situé entre l'IDM 1 et l'IDM 2. Dans ce couloir on retient, dans l'ordre : un Order Block non cassé, sinon une imbalance non comblée, sinon le milieu exact du couloir. Le repli garantit qu'il existe dès que les deux IDM existent.")
idm4Col = input.color(#ffab00, "Couleur IDM 4", group=gP4)
idm4ShowZone = input.bool(true, "Afficher la zone autour du niveau", group=gP4)


//=====================================================================
// FENÊTRE D'ANALYSE — dépend UNIQUEMENT du timeframe courant du
// graphique (jamais d'un autre timeframe) :
//   Monthly -> 4 dernières années        4H  -> 25 derniers jours
//   Weekly  -> 2 dernières années        1H  -> 8 derniers jours
//   Daily   -> 6 derniers mois           M15 -> 12 dernières heures
//                                        M5  -> 12 dernières heures
//=====================================================================
f_lookbackMs() =>
    string tf = timeframe.period
    float oneDay = 24.0 * 60 * 60 * 1000
    float result =
         tf == "M"   ? 4 * 365 * oneDay :
         tf == "W"   ? 2 * 365 * oneDay :
         tf == "D"   ? 182 * oneDay :
         tf == "240" ? 25 * oneDay :
         tf == "60"  ? 8 * oneDay :
         tf == "15"  ? 0.5 * oneDay :
         tf == "5"   ? 0.5 * oneDay :
         timeframe.ismonthly ? 4 * 365 * oneDay :
         timeframe.isweekly  ? 2 * 365 * oneDay :
         timeframe.isdaily   ? 182 * oneDay :
         timeframe.isminutes and timeframe.multiplier >= 180 ? 25 * oneDay :
         timeframe.isminutes and timeframe.multiplier >= 45  ? 8 * oneDay :
         0.5 * oneDay
    result

bool inLookback = time >= (timenow - f_lookbackMs())

// Les Order Blocks, zones Supply/Demand et imbalances n'ont PAS besoin
// d'une fenêtre de récupération : ils ne naissent que sur une vraie
// cassure de structure (isStructHighBroken / isStructLowBroken), qui
// elle-même se déclenche uniquement sur l'action du prix, sans aucune
// dépendance au temps réel ni à bar_index. Chaque module a déjà sa
// propre limite (40 OB, N zones Supply/Demand par côté, N imbalances
// par côté) : aucune fenêtre externe n'est nécessaire.
//
// Une version précédente gatait leur création par `inLookback` (basé
// sur `timenow`, l'heure réelle serveur) : en arrivant tard sur un
// graphique, ou le week-end, la fenêtre glissante ne couvrait plus les
// bougies récentes et rien ne pouvait naître. Un correctif suivant a
// tenté un filtre par `last_bar_index` (en bougies) — mais en mode
// Replay, `last_bar_index` reste bloqué sur la VRAIE dernière bougie du
// graphique (aujourd'hui), pas sur le curseur du replay : dès qu'on
// rejoue une période un peu ancienne, l'écart dépasse la fenêtre et plus
// aucune zone ne se dessine, alors que les IDM (gérés via
// `barstate.islast`, qui lui suit correctement le replay) continuent de
// s'afficher normalement. D'où l'incohérence observée. La suppression
// pure et simple de toute fenêtre externe règle les deux cas à la fois.


//=====================================================================
// PIVOTS — ZIGZAG STRUCTUREL AUTO-CALIBRÉ (Auto) ou ta.pivothigh/
// pivotlow classique (Manuel) — moteur, toujours actif.
//=====================================================================
atrSniper = ta.atr(14) * sniperSize

bool  isFastTF   = timeframe.period == "5" or timeframe.period == "15"
float atrFast    = ta.atr(14)
float atrSlow    = ta.sma(atrFast, 100)
float volRatio   = atrSlow > 0 ? atrFast / atrSlow : 1.0
int   sensLevel  = volRatio >= 1.25 ? 3 : volRatio <= 0.85 ? 1 : 2
float zigzagMult = isFastTF ? (sensLevel == 1 ? 0.7 : sensLevel == 2 ? 1.0 : 1.5) : 1.5
float zigzagThresh = ta.atr(14) * zigzagMult

//---------------------------------------------------------------------
// ZIGZAG FIN — dédié UNIQUEMENT à l'IDM. Même mécanique que le zigzag
// structurel mais avec un seuil réduit : il capte les petits swings que
// la structure ignore, ce qui permet à l'IDM de se déplacer à CHAQUE
// cassure sans polluer la détection des vrais BOS/BMS.
//---------------------------------------------------------------------
float zzFineThresh = zigzagThresh * idmFineRatio

var int   zzfDir        = 1
var float zzfExtreme    = na
var int   zzfExtremeBar = na

float phFine = na
float plFine = na
var int phFineBar = na
var int plFineBar = na

if na(zzfExtreme)
    zzfExtreme := high
    zzfExtremeBar := bar_index

if not na(zzFineThresh) and zzFineThresh > 0
    if zzfDir == 1
        if high > zzfExtreme
            zzfExtreme := high
            zzfExtremeBar := bar_index
        if low <= zzfExtreme - zzFineThresh
            phFine := zzfExtreme
            phFineBar := zzfExtremeBar
            zzfDir := -1
            zzfExtreme := low
            zzfExtremeBar := bar_index
    else
        if low < zzfExtreme
            zzfExtreme := low
            zzfExtremeBar := bar_index
        if high >= zzfExtreme + zzFineThresh
            plFine := zzfExtreme
            plFineBar := zzfExtremeBar
            zzfDir := 1
            zzfExtreme := high
            zzfExtremeBar := bar_index

var int   zzDir        = 1
var float zzExtreme    = na
var int   zzExtremeBar = na

float phZig = na
float plZig = na
var int phZigBar = na
var int plZigBar = na

if na(zzExtreme)
    zzExtreme := high
    zzExtremeBar := bar_index

if not na(zigzagThresh)
    if zzDir == 1
        if high > zzExtreme
            zzExtreme := high
            zzExtremeBar := bar_index
        if low <= zzExtreme - zigzagThresh
            phZig := zzExtreme
            phZigBar := zzExtremeBar
            zzDir := -1
            zzExtreme := low
            zzExtremeBar := bar_index
    else
        if low < zzExtreme
            zzExtreme := low
            zzExtremeBar := bar_index
        if high >= zzExtreme + zigzagThresh
            plZig := zzExtreme
            plZigBar := zzExtremeBar
            zzDir := 1
            zzExtreme := high
            zzExtremeBar := bar_index

// Sensibilité MANUELLE : réglage classique par nombre de bougies,
// directement branché sur ta.pivothigh/pivotlow — appelées
// INCONDITIONNELLEMENT chaque bougie (obligatoire pour ces fonctions),
// seul le CHOIX entre ce résultat et le zigzag auto se fait juste
// après, selon pivMode.
float phManualRaw = ta.pivothigh(pivLenManual, pivLenManual)
float plManualRaw = ta.pivotlow(pivLenManual, pivLenManual)

float ph  = pivMode == "Manuel" ? phManualRaw : phZig
float pl  = pivMode == "Manuel" ? plManualRaw : plZig
int phBar = pivMode == "Manuel" ? (na(phManualRaw) ? na : bar_index[pivLenManual]) : phZigBar
int plBar = pivMode == "Manuel" ? (na(plManualRaw) ? na : bar_index[pivLenManual]) : plZigBar

// Pivots vus par l'IDM : les mêmes que la structure, SAUF si la
// détection fine est active (et hors mode Manuel, où tu règles déjà la
// sensibilité toi-même).
bool  idmUsesFine = idmFineDetect and pivMode != "Manuel"
float idmPh    = idmUsesFine ? phFine    : ph
float idmPl    = idmUsesFine ? plFine    : pl
int   idmPhBar = idmUsesFine ? phFineBar : phBar
int   idmPlBar = idmUsesFine ? plFineBar : plBar

var float lastPH = na
var float prevPH = na
var int lastPHBar = na

var float lastPL = na
var float prevPL = na
var int lastPLBar = na

// Liquidité Intact — les 4 derniers pivots hauts/bas CONFIRMÉS pas
// encore balayés, chacun de son côté (module 6). Un pivot est retiré
// dès qu'une bougie balaye son niveau (voir la purge plus bas) ; sinon,
// uniquement les 4 plus récents sont conservés par côté.
var float[] intactHighLevels = array.new_float()
var int[]   intactHighBars   = array.new_int()
var float[] intactLowLevels  = array.new_float()
var int[]   intactLowBars    = array.new_int()

if not na(ph) and inLookback
    prevPH := lastPH
    lastPH := ph
    lastPHBar := phBar

    array.push(intactHighLevels, ph)
    array.push(intactHighBars, phBar)
    if array.size(intactHighLevels) > 4
        array.shift(intactHighLevels)
        array.shift(intactHighBars)

    if showStruct
        string txt = na(prevPH) ? "H" : ph > prevPH ? "HH" : "LH"
        color col = na(prevPH) ? rangeCol : ph > prevPH ? bullCol : bearCol
        label.new(phBar, ph, txt,
             style=label.style_label_down,
             color=color.new(col, 80),
             textcolor=col,
             size=size.small)

if not na(pl) and inLookback
    prevPL := lastPL
    lastPL := pl
    lastPLBar := plBar

    array.push(intactLowLevels, pl)
    array.push(intactLowBars, plBar)
    if array.size(intactLowLevels) > 4
        array.shift(intactLowLevels)
        array.shift(intactLowBars)

    if showStruct
        string txt = na(prevPL) ? "L" : pl > prevPL ? "HL" : "LL"
        color col = na(prevPL) ? rangeCol : pl > prevPL ? bullCol : bearCol
        label.new(plBar, pl, txt,
             style=label.style_label_up,
             color=color.new(col, 80),
             textcolor=col,
             size=size.small)


//=====================================================================
// STRUCTURE + CASSURES BOS/BMS (moteur — toujours actif). Moteur fusionné
// depuis "SMC Structures and FVG" (LudoGH68) : bosHigh/bosLow suivis avec
// confirmation sur 3 bougies (ou clôture du corps si
// isStructBodyCandleBreak), extension automatique tant qu'aucune cassure
// n'a eu lieu. Un retournement (ex-CHoCH) est fast-track (pas d'attente
// des 3 bougies), une continuation (ex-BOS) attend la confirmation —
// exactement le moteur d'origine.
//   bias : 1 = haussier, -1 = baissier, 0 = pas encore de structure
//=====================================================================
var float bosHigh = na
var int   bosHighBar = na
var float bosLow = na
var int   bosLowBar = na
var float brokenHigh    = na
var int   brokenHighBar = na
var float brokenLow     = na
var int   brokenLowBar  = na
var int   bias = 0

var line[]  structLines       = array.new_line()
var label[] structLabels      = array.new_label()
var line    curStructHighLine = na
var line    curStructLowLine  = na

if bar_index == 0
    bosHighBar := bar_index
    bosLowBar  := bar_index
    bosHigh := high
    bosLow  := low

int structMaxBar = bar_index + f_structHighestBar(10)
int structMinBar = bar_index + f_structLowestBar(10)

float lowBreakPx  = isStructBodyCandleBreak ? close : low
float highBreakPx = isStructBodyCandleBreak ? close : high

bool isStructLowBroken =
     (lowBreakPx < bosLow and lowBreakPx[1] >= bosLow and lowBreakPx[2] >= bosLow and lowBreakPx[3] >= bosLow and
      bar_index[1] > bosLowBar and bar_index[2] > bosLowBar and bar_index[3] > bosLowBar) or
     (bias == 1 and lowBreakPx < bosLow)

bool isStructHighBroken =
     (highBreakPx > bosHigh and highBreakPx[1] <= bosHigh and highBreakPx[2] <= bosHigh and highBreakPx[3] <= bosHigh and
      bar_index[1] > bosHighBar and bar_index[2] > bosHighBar and bar_index[3] > bosHighBar) or
     (bias == -1 and highBreakPx > bosHigh)

bool bosBull   = false
bool bosBear   = false
bool chochBull = false
bool chochBear = false

if isStructLowBroken
    if array.size(structLines) >= structHistoryNbr
        line.delete(array.get(structLines, 0))
        label.delete(array.get(structLabels, 0))
        array.remove(structLines, 0)
        array.remove(structLabels, 0)

    bool  isContinuation = bias == -1
    string evTxt = isContinuation ? "BMS" : "BOS"
    color  evCol = isContinuation ? bmsBearColor : bosBearColor

    array.push(structLines, line.new(bosLowBar, bosLow, bar_index, bosLow, xloc=xloc.bar_index, extend=extend.none,
         color=evCol, style=isContinuation ? bmsLineStyle : bosLineStyle, width=isContinuation ? bmsLineWidth : bosLineWidth))
    array.push(structLabels, label.new(int(math.avg(bar_index, bosLowBar)), bosLow, text=evTxt, style=label.style_none, textcolor=evCol))

    if isContinuation
        bosBear := true
    else
        chochBear := true

    brokenLow := bosLow
    brokenLowBar := bosLowBar

    bias := -1
    bosHighBar := structMaxBar
    bosLowBar  := bar_index
    bosHigh := high[bar_index - bosHighBar]
    bosLow  := low

else if isStructHighBroken
    if array.size(structLines) >= structHistoryNbr
        line.delete(array.get(structLines, 0))
        label.delete(array.get(structLabels, 0))
        array.remove(structLines, 0)
        array.remove(structLabels, 0)

    bool  isContinuation = bias == 1
    string evTxt = isContinuation ? "BMS" : "BOS"
    color  evCol = isContinuation ? bmsBullColor : bosBullColor

    array.push(structLines, line.new(bosHighBar, bosHigh, bar_index, bosHigh, xloc=xloc.bar_index, extend=extend.none,
         color=evCol, style=isContinuation ? bmsLineStyle : bosLineStyle, width=isContinuation ? bmsLineWidth : bosLineWidth))
    array.push(structLabels, label.new(int(math.avg(bar_index, bosHighBar)), bosHigh, text=evTxt, style=label.style_none, textcolor=evCol))

    if isContinuation
        bosBull := true
    else
        chochBull := true

    brokenHigh := bosHigh
    brokenHighBar := bosHighBar

    bias := 1
    bosHighBar := bar_index
    bosLowBar  := structMinBar
    bosHigh := high
    bosLow  := low[bar_index - bosLowBar]

else
    if high > bosHigh and (bias == 0 or bias == 1)
        if not isStructBodyCandleBreak or not (bar_index[1] > bosHighBar and bar_index[2] > bosHighBar and bar_index[3] > bosHighBar)
            bosHigh := high
            bosHighBar := bar_index
    else if low < bosLow and (bias == 0 or bias == -1)
        if not isStructBodyCandleBreak or not (bar_index[1] > bosLowBar and bar_index[2] > bosLowBar and bar_index[3] > bosLowBar)
            bosLow := low
            bosLowBar := bar_index

// TENDANCE CONFIRMÉE — ne change JAMAIS sur un BMS de continuation ni sur
// une lecture de consolidation, seul un vrai BOS (retournement) la fait
// basculer. Pilote l'ancrage de bosHigh/bosLow, la Sniper Zone, la
// Liquidité Cible et la case "Acheteur/Vendeur maintenant".
var int confirmedTrend = 0

if chochBull
    confirmedTrend := 1
if chochBear
    confirmedTrend := -1

// Structure actuelle en cours (optionnel) — matérialise bosHigh/bosLow,
// les niveaux qui pilotent la Liquidité Cible et le repli du SL.
if showCurrentStruct
    if not na(curStructHighLine)
        line.delete(curStructHighLine)
    if not na(curStructLowLine)
        line.delete(curStructLowLine)
    curStructHighLine := line.new(bosHighBar, bosHigh, bar_index, bosHigh, xloc=xloc.bar_index,
         color=currentStructColor, style=currentStructLineStyle, width=currentStructLineWidth)
    curStructLowLine := line.new(bosLowBar, bosLow, bar_index, bosLow, xloc=xloc.bar_index,
         color=currentStructColor, style=currentStructLineStyle, width=currentStructLineWidth)

// STRUCTURE H1 — seule référence pour "Acheteur/Vendeur maintenant" et la
// Liquidité Cible : haussière -> acheteur (vise un Intact Seller),
// baissière -> vendeur (vise un Intact Buyer). Rien d'autre n'entre en
// compte, jamais le mélange avec la structure du chart courant.
// f_h1Bias() (sans dessin) au lieu de `bias` : `bias` est calculé dans le
// même bloc que les lignes BOS/BMS (line.new), ce que request.security
// refuse ou exécute mal — d'où le dashboard qui ne s'affichait plus.
int h1Bias = request.security(syminfo.tickerid, "60", f_h1Bias(), lookahead=barmerge.lookahead_off)


//=====================================================================
// LECTURE MULTI-TIMEFRAME pour l'IDM 3 — M5, M15 et H1.
//
// f_tfSwings() est une fonction PURE : aucun dessin (line.new / box.new)
// à l'intérieur. C'est obligatoire — request.security() refuse ou
// exécute mal une expression qui dépend d'objets de dessin.
//
// Elle renvoie, pour le timeframe demandé, le dernier creux et le
// dernier sommet de swing (même principe de zigzag ATR que le moteur du
// graphique courant, en version autonome).
//=====================================================================
f_tfSwings() =>
    float atrTf = ta.atr(14)
    float thTf  = atrTf * 1.5
    var int   dTf    = 1
    var float extTf  = na
    var float lastLo = na
    var float lastHi = na
    if na(extTf)
        extTf := high
    if not na(thTf) and thTf > 0
        if dTf == 1
            if high > extTf
                extTf := high
            if low <= extTf - thTf
                lastHi := extTf
                dTf    := -1
                extTf  := low
        else
            if low < extTf
                extTf := low
            if high >= extTf + thTf
                lastLo := extTf
                dTf    := 1
                extTf  := high
    [lastLo, lastHi]

[m5Lo,  m5Hi]  = request.security(syminfo.tickerid, "5",  f_tfSwings(), lookahead=barmerge.lookahead_off)
[m15Lo, m15Hi] = request.security(syminfo.tickerid, "15", f_tfSwings(), lookahead=barmerge.lookahead_off)
[h1Lo,  h1Hi]  = request.security(syminfo.tickerid, "60", f_tfSwings(), lookahead=barmerge.lookahead_off)


//=====================================================================
// AFFICHAGE — Zones de Liquidité (Intact), indépendant. Jusqu'à 4
// niveaux par côté, alimentés dans la section PIVOTS plus haut —
// aucune influence sur bosHigh/bosLow ni sur le moteur.
//=====================================================================
if array.size(intactHighLevels) > 0
    for idx = array.size(intactHighLevels) - 1 to 0
        if high >= array.get(intactHighLevels, idx)
            array.remove(intactHighLevels, idx)
            array.remove(intactHighBars, idx)

if array.size(intactLowLevels) > 0
    for idx = array.size(intactLowLevels) - 1 to 0
        if low <= array.get(intactLowLevels, idx)
            array.remove(intactLowLevels, idx)
            array.remove(intactLowBars, idx)

var line[]  intactHighLines = array.new_line()
var label[] intactHighLbls  = array.new_label()
var line[]  intactLowLines  = array.new_line()
var label[] intactLowLbls   = array.new_label()

if array.size(intactHighLines) > 0
    for idx = array.size(intactHighLines) - 1 to 0
        line.delete(array.get(intactHighLines, idx))
        label.delete(array.get(intactHighLbls, idx))
    array.clear(intactHighLines)
    array.clear(intactHighLbls)

if array.size(intactLowLines) > 0
    for idx = array.size(intactLowLines) - 1 to 0
        line.delete(array.get(intactLowLines, idx))
        label.delete(array.get(intactLowLbls, idx))
    array.clear(intactLowLines)
    array.clear(intactLowLbls)

if showIntact
    if array.size(intactHighLevels) > 0
        for idx = 0 to array.size(intactHighLevels) - 1
            float lvlH = array.get(intactHighLevels, idx)
            int   barH = array.get(intactHighBars, idx)
            int   rankH = array.size(intactHighLevels) - idx
            string txtH = "Intact Sellers #" + str.tostring(rankH)
            array.push(intactHighLines, line.new(barH, lvlH, bar_index + zoneExt, lvlH,
                 color=intactSellCol, style=line.style_dashed, width=1))
            array.push(intactHighLbls, label.new(bar_index + zoneExt, lvlH, txtH,
                 style=label.style_label_left, color=color.new(intactSellCol, 80),
                 textcolor=intactSellCol, size=size.small))

    if array.size(intactLowLevels) > 0
        for idx = 0 to array.size(intactLowLevels) - 1
            float lvlL = array.get(intactLowLevels, idx)
            int   barL = array.get(intactLowBars, idx)
            int   rankL = array.size(intactLowLevels) - idx
            string txtL = "Intact Buyers #" + str.tostring(rankL)
            array.push(intactLowLines, line.new(barL, lvlL, bar_index + zoneExt, lvlL,
                 color=intactBuyCol, style=line.style_dashed, width=1))
            array.push(intactLowLbls, label.new(bar_index + zoneExt, lvlL, txtL,
                 style=label.style_label_left, color=color.new(intactBuyCol, 80),
                 textcolor=intactBuyCol, size=size.small))


//=====================================================================
// MOTEUR DE MOUVEMENT (moteur — toujours actif)
//
// Une cassure (BMS ou BOS) lance un mouvement. Le moteur suit son
// origine et son extrême pour calculer le niveau 0.5 — c'est ce 0.5 qui
// juge la validité du retracement, et c'est moveDir qui pilote l'IDM.
//=====================================================================
bool newMoveUp   = bosBull or chochBull
bool newMoveDown = bosBear or chochBear

var int moveDir = 0
var float moveOrigin = na
var int moveOriginBar = na
var float moveExtreme = na
var int moveExtremeBar = na
var float moveFib50 = na

bool extremeUpdated = false

if newMoveUp
    moveDir := 1
    moveOrigin := brokenHigh
    moveOriginBar := brokenHighBar
    moveExtreme := high
    moveExtremeBar := bar_index
    moveFib50 := (moveOrigin + moveExtreme) / 2.0
    extremeUpdated := true

if newMoveDown
    moveDir := -1
    moveOrigin := brokenLow
    moveOriginBar := brokenLowBar
    moveExtreme := low
    moveExtremeBar := bar_index
    moveFib50 := (moveOrigin + moveExtreme) / 2.0
    extremeUpdated := true

if moveDir == 1 and not newMoveUp and high > moveExtreme
    moveExtreme := high
    moveExtremeBar := bar_index
    moveFib50 := (moveOrigin + moveExtreme) / 2.0
    extremeUpdated := true

if moveDir == -1 and not newMoveDown and low < moveExtreme
    moveExtreme := low
    moveExtremeBar := bar_index
    moveFib50 := (moveOrigin + moveExtreme) / 2.0
    extremeUpdated := true


//=====================================================================
// LIQUIDITÉ CIBLE (lecture seule) — l'IDM n'est PAS la destination du
// prix, c'est l'étape où il se ravitaille avant de continuer sa route
// vers la vraie cible : la liquidité pas encore balayée. Réutilise
// bosHigh/bosLow (mêmes niveaux que les zones Intact) comme cible, mais
// la DIRECTION vient de h1Bias (structure H1) — TOUJOURS cohérente avec
// la case "Acheteur/Vendeur maintenant" : H1 haussier -> cible = Intact
// Seller (bosHigh), H1 baissier -> cible = Intact Buyer (bosLow).
// N'influence jamais idmLevel/idmDir/idmDone ni la Sniper Zone.
//=====================================================================
float targetLevel = na
bool  targetValid = false

if h1Bias == 1 and not na(bosHigh)
    targetLevel := bosHigh
    targetValid := true
if h1Bias == -1 and not na(bosLow)
    targetLevel := bosLow
    targetValid := true

float targetProgressPct = na
if targetValid and not na(moveOrigin) and targetLevel != moveOrigin
    targetProgressPct := (close - moveOrigin) / (targetLevel - moveOrigin) * 100
    targetProgressPct := math.max(0.0, math.min(100.0, targetProgressPct))

var line  targetLine = na
var label targetLbl  = na

if showLiquidityTarget and targetValid
    string targetTxt = "Cible liquidité " + str.tostring(targetLevel, format.mintick) +
         (na(targetProgressPct) ? "" : " (" + str.tostring(targetProgressPct, "#") + "% parcouru)")
    if na(targetLine)
        targetLine := line.new(bar_index, targetLevel, bar_index + zoneExt, targetLevel,
             color=targetCol, style=line.style_dashed, width=2)
        targetLbl := label.new(bar_index + zoneExt, targetLevel, targetTxt,
             style=label.style_label_left, color=color.new(targetCol, 80), textcolor=targetCol, size=size.small)
    else
        line.set_xy1(targetLine, bar_index, targetLevel)
        line.set_xy2(targetLine, bar_index + zoneExt, targetLevel)
        label.set_xy(targetLbl, bar_index + zoneExt, targetLevel)
        label.set_text(targetLbl, targetTxt)
else
    if not na(targetLine)
        line.delete(targetLine)
        targetLine := na
    if not na(targetLbl)
        label.delete(targetLbl)
        targetLbl := na

bool nearTargetNow  = targetValid and math.abs(close - targetLevel) <= ta.atr(14) * 0.15
bool enteredTargetZone = nearTargetNow and not nearTargetNow[1]


//=====================================================================
// LE 0.5 JUGE LE RETRACEMENT (moteur — toujours actif)
//
// validTest = le prix a déjà atteint le 0.5 dans le bon sens pendant ce
// mouvement — sert au dashboard et à candidateRetracementValid.
//=====================================================================
var bool validTest = false

if newMoveUp or newMoveDown
    validTest := false

if not extremeUpdated
    if moveDir == 1 and not na(moveFib50) and low <= moveFib50
        validTest := true
    if moveDir == -1 and not na(moveFib50) and high >= moveFib50
        validTest := true


//=====================================================================
// IDM — MOTEUR (toujours actif, indépendant de l'affichage)
//
//   Structure haussière -> IDM (IDBL) = dernier pivot BAS,
//                           obligatoirement SOUS moveExtreme
//   Structure baissière -> IDM (IDBR) = dernier pivot HAUT,
//                           obligatoirement AU-DESSUS de moveExtreme
//
// Chaque pivot opposé au mouvement CONFIRMÉ (moveDir) est un candidat
// IDM. Tant que l'IDM actif n'est pas récupéré, tout nouveau candidat
// le REMPLACE : l'ancien devient une FS historique. L'IDM se déplace,
// c'est normal — le dashboard suit toujours le plus récent aligné avec
// confirmedTrend (règle 80/20).
//=====================================================================
var float[]  idmLevel = array.new_float()
var int[]    idmDir   = array.new_int()
var bool[]   idmDone  = array.new_bool()
var string[] idmKind  = array.new_string()   // "IDM" ou "FS"
var line[]   idmLine  = array.new_line()     // peut contenir na si showIdmLines=false
var label[]  idmLbl   = array.new_label()    // peut contenir na si showIdmLines=false

// Sniper Zone — LE reteste précis, rattachée uniquement à l'IDM.
var box[] sniperZoneA = array.new_box()      // peut contenir na si showSniperZone=false

// Zones de raffinage intrabar ("chandelier qui prend l'argent") — pas
// strictement parallèle à idmLevel/sniperZoneA (une par récupération
// effective, pas une par IDM créé), donc gérée avec sa propre limite.
var box[] sniperRefineBx = array.new_box()

float idmCandidate    = na
int   idmCandidateBar = na

if moveDir == 1 and not na(idmPl) and idmPl < moveExtreme
    idmCandidate := idmPl
    idmCandidateBar := idmPlBar

if moveDir == -1 and not na(idmPh) and idmPh > moveExtreme
    idmCandidate := idmPh
    idmCandidateBar := idmPhBar

int nPrev = array.size(idmLevel)
float prevTopLevel = nPrev > 0 ? array.get(idmLevel, nPrev - 1) : na
int   prevTopDir   = nPrev > 0 ? array.get(idmDir, nPrev - 1) : 0
bool  prevTopDone  = nPrev > 0 ? array.get(idmDone, nPrev - 1) : true

bool newIDM =
     not na(idmCandidate) and
     (nPrev == 0 or idmCandidate != prevTopLevel or prevTopDir != moveDir)

bool isFS = newIDM and nPrev > 0 and not prevTopDone and prevTopDir == moveDir

bool candidateRetracementValid =
     moveDir == 1 ? idmCandidate <= moveFib50 :
     moveDir == -1 ? idmCandidate >= moveFib50 : false

if newIDM

    array.push(idmLevel, idmCandidate)
    array.push(idmDir, moveDir)
    array.push(idmDone, false)
    array.push(idmKind, "IDM")

    line ln = na
    label lb = na
    if showIdmLines
        // Étiquette : direction + niveau exact, pour localiser l'IDM
        // instantanément. "•0.5" = retracement déjà validé.
        string idmArrow = moveDir == 1 ? "▲" : "▼"
        string idmTxt0 = idmEmphasis ?
             idmArrow + " IDM 1 " + str.tostring(idmCandidate, format.mintick) + (candidateRetracementValid ? " •0.5" : "") :
             (candidateRetracementValid ? "IDM 1 •0.5" : "IDM 1")
        ln := line.new(idmCandidateBar, idmCandidate, bar_index + 1, idmCandidate,
             color=idmActiveCol,
             style=idmEmphasis ? line.style_solid : line.style_dotted,
             width=idmEmphasis ? idmWidthBoost : 3)
        lb := label.new(bar_index + 1, idmCandidate, idmTxt0,
             style=label.style_label_left,
             color=color.new(idmActiveCol, idmEmphasis ? 40 : 75),
             textcolor=idmEmphasis ? color.white : idmActiveCol,
             size=idmEmphasis ? size.normal : size.small)
    array.push(idmLine, ln)
    array.push(idmLbl, lb)

    // Règle 80/20 : tendance confirmée haussière -> uniquement des
    // achats, confirmée baissière -> uniquement des ventes. N'affecte
    // que le DESSIN de la Sniper Zone, jamais idmLevel/idmDir/idmDone
    // ni la détection de récupération.
    bool dirAllowed = confirmedTrend == 0 or confirmedTrend == moveDir

    box sn = na
    if showSniperZone and dirAllowed
        sn := box.new(idmCandidateBar, idmCandidate + atrSniper, bar_index + zoneExt, idmCandidate - atrSniper,
             border_color=sniperCol,
             border_width=2,
             bgcolor=color.new(sniperCol, 85),
             text="Sniper Zone",
             text_color=sniperCol,
             text_size=size.tiny,
             text_halign=text.align_left)
    array.push(sniperZoneA, sn)

    int n = array.size(idmLevel)

    // L'ancien "le plus récent" passe en 2e position : reste "IDM",
    // couleur secondaire, continue d'être surveillé et prolongé.
    if n >= 2 and not array.get(idmDone, n - 2)
        line ln2 = array.get(idmLine, n - 2)
        if not na(ln2)
            line.set_color(ln2, idmWaitCol)
            line.set_width(ln2, idmEmphasis ? math.max(idmWidthBoost - 1, 2) : 2)
        label lb2 = array.get(idmLbl, n - 2)
        if not na(lb2)
            label.set_color(lb2, color.new(idmWaitCol, idmEmphasis ? 50 : 75))
            label.set_textcolor(lb2, idmEmphasis ? color.white : idmWaitCol)
            // Renommé en "IDM 2" pour que les deux derniers IDM restent
            // identifiables d'un coup d'œil.
            float lv2 = array.get(idmLevel, n - 2)
            int   dr2 = array.get(idmDir, n - 2)
            label.set_text(lb2, idmEmphasis ?
                 (dr2 == 1 ? "▲" : "▼") + " IDM 2 " + str.tostring(lv2, format.mintick) : "IDM 2")
        box sz2 = array.get(sniperZoneA, n - 2)
        if not na(sz2)
            box.set_border_width(sz2, 1)

    // Celui qui sort du top 2 devient une FS. Si showFsHistory est
    // actif, on la fige en gris (jamais supprimée). Sinon (par défaut),
    // on la supprime directement pour garder le graphique lisible.
    if n >= 3 and not array.get(idmDone, n - 3)
        array.set(idmKind, n - 3, "FS")
        line ln3 = array.get(idmLine, n - 3)
        label lb3 = array.get(idmLbl, n - 3)
        box sz3 = array.get(sniperZoneA, n - 3)
        if showFsHistory
            if not na(ln3)
                line.set_x2(ln3, idmCandidateBar)
                line.set_color(ln3, color.new(fsCol, 55))
                line.set_width(ln3, 1)
            if not na(lb3)
                label.set_text(lb3, "FS")
                label.set_xy(lb3, idmCandidateBar, array.get(idmLevel, n - 3))
                label.set_color(lb3, color.new(fsCol, 80))
                label.set_textcolor(lb3, fsCol)
            if not na(sz3)
                box.set_right(sz3, idmCandidateBar)
                box.set_border_color(sz3, color.new(fsCol, 60))
                box.set_bgcolor(sz3, color.new(fsCol, 94))
                box.set_text(sz3, "")
        else
            if not na(ln3)
                line.delete(ln3)
            if not na(lb3)
                label.delete(lb3)
            if not na(sz3)
                box.delete(sz3)


// Prolongation des DEUX plus récents tant qu'ils ne sont pas recouverts.
int nNow = array.size(idmLevel)

if nNow > 0
    int topIdx = nNow - 1
    if not array.get(idmDone, topIdx)
        line lnTop = array.get(idmLine, topIdx)
        if not na(lnTop)
            line.set_x2(lnTop, bar_index + 1)
        label lbTop = array.get(idmLbl, topIdx)
        if not na(lbTop)
            label.set_xy(lbTop, bar_index + 1, array.get(idmLevel, topIdx))
        box szTop = array.get(sniperZoneA, topIdx)
        if not na(szTop)
            box.set_right(szTop, bar_index + zoneExt)

if nNow > 1
    int secIdx = nNow - 2
    if not array.get(idmDone, secIdx)
        line lnSec = array.get(idmLine, secIdx)
        if not na(lnSec)
            line.set_x2(lnSec, bar_index + 1)
        label lbSec = array.get(idmLbl, secIdx)
        if not na(lbSec)
            label.set_xy(lbSec, bar_index + 1, array.get(idmLevel, secIdx))
        box szSec = array.get(sniperZoneA, secIdx)
        if not na(szSec)
            box.set_right(szSec, bar_index + zoneExt)


//=====================================================================
// ALERTES — zones de prédilection (lecture seule de la Sniper Zone du
// plus récent IDM actif). Calculées à chaque bougie (pas seulement
// barstate.islast) pour qu'alertcondition() détecte l'ENTRÉE dans la
// zone, pas juste "être dedans" en continu.
//=====================================================================
bool inSniperNow = false

if nNow > 0
    box topSniperA = array.get(sniperZoneA, nNow - 1)
    if not na(topSniperA)
        float tsTop = box.get_top(topSniperA)
        float tsBot = box.get_bottom(topSniperA)
        if close <= tsTop and close >= tsBot
            inSniperNow := true

bool enteredSniperZone = inSniperNow and not inSniperNow[1]


//=====================================================================
// RÉCUPÉRATION DE L'IDM (moteur — toujours actif)
//
// Vérifiée pour TOUS les IDM encore actifs, même les anciens FS. Les
// DEUX plus récents déclenchent le vrai signal d'entrée dès que le prix
// revient les chercher. Un ancien FS (position 3+) retesté plus tard ne
// déclenche jamais de signal, juste un marquage "✓" informatif.
//
// Point critique : si l'IDM est repris MAIS que, sur la même bougie, le
// prix casse réellement la structure dans le sens opposé, ce n'est PAS
// une continuation — c'est un BOS (retournement). Aucun signal d'entrée émis.
//=====================================================================
bool entrySignalBuy   = false
bool entrySignalSell  = false
bool signalBlockedByChoch = false

if array.size(idmLevel) > 0
    for i = array.size(idmLevel) - 1 to 0
        if not array.get(idmDone, i)
            float lvl = array.get(idmLevel, i)
            int   dir = array.get(idmDir, i)
            bool recovered = (dir == 1 and low <= lvl) or (dir == -1 and high >= lvl)

            if recovered
                array.set(idmDone, i, true)

                bool isTopTwo       = i >= array.size(idmLevel) - 2
                bool blockedByChoch = (dir == 1 and chochBear) or (dir == -1 and chochBull)

                // Sniper Zone : dès que le prix part RÉELLEMENT pour le
                // mouvement, on la supprime immédiatement.
                box szr = array.get(sniperZoneA, i)
                if not na(szr)
                    box.delete(szr)

                // Raffinage intrabar (Module 4, "chandelier qui prend
                // l'argent") : uniquement si la Sniper Zone d'origine
                // existait vraiment (règle 80/20 respectée). Bande TRÈS
                // fine centrée exactement sur le niveau IDM que la mèche
                // de CETTE bougie vient de toucher.
                if showSniperRefine and isTopTwo and not blockedByChoch and not na(szr)
                    float refineThick = atrSniper / 4
                    float refTop = lvl + refineThick
                    float refBot = lvl - refineThick
                    array.push(sniperRefineBx, box.new(bar_index, refTop, bar_index + zoneExt, refBot,
                         border_color=refineCol, border_width=2,
                         bgcolor=color.new(refineCol, 70),
                         text="Sniper affinée", text_color=refineCol,
                         text_size=size.tiny, text_halign=text.align_left))
                    if array.size(sniperRefineBx) > 15
                        box.delete(array.shift(sniperRefineBx))

                line lnr = array.get(idmLine, i)
                label lbr = array.get(idmLbl, i)

                if isTopTwo and not blockedByChoch
                    if not na(lnr)
                        line.delete(lnr)
                    if not na(lbr)
                        label.delete(lbr)

                    if dir == 1
                        entrySignalBuy := true
                    else
                        entrySignalSell := true
                else
                    if isTopTwo and blockedByChoch
                        signalBlockedByChoch := true
                    string doneTxt = isTopTwo and blockedByChoch ?
                         array.get(idmKind, i) + " ✓ (BOS)" :
                         array.get(idmKind, i) + " ✓"

                    if not na(lnr)
                        line.set_x2(lnr, bar_index)
                        line.set_color(lnr, color.new(idmDoneCol, 40))
                    if not na(lbr)
                        label.set_text(lbr, doneTxt)
                        label.set_xy(lbr, bar_index, lvl)
                        label.set_color(lbr, color.new(idmDoneCol, 75))
                        label.set_textcolor(lbr, idmDoneCol)


// limitation historique — 8 tableaux liés, on garde tout synchronisé
if array.size(idmLevel) > maxHistory
    line oldLn = array.shift(idmLine)
    if not na(oldLn)
        line.delete(oldLn)
    label oldLb = array.shift(idmLbl)
    if not na(oldLb)
        label.delete(oldLb)
    box oldSz = array.shift(sniperZoneA)
    if not na(oldSz)
        box.delete(oldSz)
    array.shift(idmLevel)
    array.shift(idmDir)
    array.shift(idmDone)
    array.shift(idmKind)


//=====================================================================
// ORDER BLOCKS + BREAKER BLOCKS (module 8)
//
// Logique de détection adaptée de "Order Blocks & Breaker Blocks"
// (© LuxAlgo, CC BY-NC-SA 4.0) — usage personnel non commercial.
//
// ADAPTATIONS SMV (ce n'est PAS une simple copie) :
//
//  1. Le déclencheur n'est plus le swing interne de LuxAlgo, mais TON
//     moteur de structure : un OB naît uniquement quand isStructHighBroken
//     / isStructLowBroken déclenche un vrai BOS/BMS. "Un Order Block
//     valide doit obligatoirement provoquer une vraie cassure de
//     structure" — c'est exactement ta règle.
//
//  2. La recherche remonte jusqu'au niveau RÉELLEMENT cassé
//     (brokenHighBar / brokenLowBar), pas jusqu'à un swing indépendant.
//
//  3. Confluence IDM (★) : un OB qui contient un IDM encore actif est
//     signalé. C'est LA confluence SMV — le niveau où tu attends déjà le
//     prix est aussi celui où les institutionnels ont laissé leur trace.
//
//  4. Déséquilibre FVG (⚡) signalé, comme tu l'as décrit.
//
//  5. Filtre 80/20 optionnel sur confirmedTrend.
//
//  6. IMPORTANT — LuxAlgo fait "for bx in box.all : bx.delete()", ce qui
//     effacerait TES Sniper Zones, tes phases et tes zones Supply/Demand.
//     Ici on ne supprime QUE nos propres objets, stockés dans des
//     tableaux dédiés.
//
// Breaker Block : quand le prix casse vraiment à travers un OB, celui-ci
// a échoué et change de polarité (un OB haussier cassé devient une
// résistance). Confirmation forte pour la SMV.
//=====================================================================
float obMax = obUseBody ? math.max(close, open) : high
float obMin = obUseBody ? math.min(close, open) : low

var float[] obTopA    = array.new_float()
var float[] obBtmA    = array.new_float()
var int[]   obLocA    = array.new_int()
var int[]   obDirA    = array.new_int()      // 1 = OB haussier, -1 = OB baissier
var bool[]  obBrkA    = array.new_bool()     // devenu Breaker Block ?
var int[]   obBrkLocA = array.new_int()
var bool[]  obFvgA    = array.new_bool()
var bool[]  obIdmA    = array.new_bool()     // confluence avec un IDM actif

// Objets dessinés — on ne touche JAMAIS à box.all / line.all.
var box[]   obDrawBox = array.new_box()
var line[]  obDrawLn  = array.new_line()
var label[] obDrawLbl = array.new_label()

bool obStructBroke = isStructHighBroken or isStructLowBroken
// Même priorité que le moteur de structure plus haut (if / else if).
bool obBreakBull   = obStructBroke and not isStructLowBroken

// Distance à remonter : jusqu'au niveau réellement cassé, borné à 50
// bougies pour garder un buffer d'historique raisonnable.
int obOriginBar = obBreakBull ? brokenHighBar : brokenLowBar
int obScanLen   = obStructBroke and not na(obOriginBar) ? math.min(math.max(bar_index - obOriginBar, 1), 50) : 0

if showOB and obStructBroke and obScanLen > 0
    float minima = obMin[1]
    float maxima = obMax[1]
    int   locOff = 1

    if obBreakBull
        // Bougie du plus bas creux avant l'impulsion haussière.
        for i = 1 to obScanLen
            if obMin[i] < minima
                minima := obMin[i]
                maxima := obMax[i]
                locOff := i
    else
        // Bougie du plus haut sommet avant l'impulsion baissière.
        for i = 1 to obScanLen
            if obMax[i] > maxima
                maxima := obMax[i]
                minima := obMin[i]
                locOff := i

    if not na(minima) and not na(maxima) and maxima >= minima
        // Déséquilibre (FVG) laissé par l'impulsion qui part de l'OB.
        bool obHasFvg = false
        if obShowFvg and locOff >= 2
            obHasFvg := obBreakBull ? (low[locOff - 2] > high[locOff]) : (high[locOff - 2] < low[locOff])

        // Confluence SMV : un IDM encore actif tombe-t-il dans l'OB ?
        bool obHasIdm = false
        if obShowIdmConfluence and array.size(idmLevel) > 0
            for j = array.size(idmLevel) - 1 to 0
                if not obHasIdm and not array.get(idmDone, j)
                    float idmLv = array.get(idmLevel, j)
                    if idmLv <= maxima and idmLv >= minima
                        obHasIdm := true

        array.unshift(obTopA, maxima)
        array.unshift(obBtmA, minima)
        array.unshift(obLocA, bar_index - locOff)
        array.unshift(obDirA, obBreakBull ? 1 : -1)
        array.unshift(obBrkA, false)
        array.unshift(obBrkLocA, 0)
        array.unshift(obFvgA, obHasFvg)
        array.unshift(obIdmA, obHasIdm)

        // Limite d'historique (les plus anciens tombent).
        if array.size(obTopA) > 40
            array.pop(obTopA)
            array.pop(obBtmA)
            array.pop(obLocA)
            array.pop(obDirA)
            array.pop(obBrkA)
            array.pop(obBrkLocA)
            array.pop(obFvgA)
            array.pop(obIdmA)

// Passage en Breaker Block, puis suppression définitive quand le prix
// dépasse franchement le Breaker (logique LuxAlgo conservée).
bool obJustBroke   = false
bool obTouchedNow  = false

if array.size(obTopA) > 0
    for i = array.size(obTopA) - 1 to 0
        int   dOb = array.get(obDirA, i)
        float tOb = array.get(obTopA, i)
        float bOb = array.get(obBtmA, i)
        bool  kOb = array.get(obBrkA, i)
        bool  dropIt = false

        if dOb == 1
            if not kOb
                if math.min(close, open) < bOb
                    array.set(obBrkA, i, true)
                    array.set(obBrkLocA, i, bar_index)
                    obJustBroke := true
                else if low <= tOb and high >= bOb
                    obTouchedNow := true
            else
                if close > tOb
                    dropIt := true
        else
            if not kOb
                if math.max(close, open) > tOb
                    array.set(obBrkA, i, true)
                    array.set(obBrkLocA, i, bar_index)
                    obJustBroke := true
                else if high >= bOb and low <= tOb
                    obTouchedNow := true
            else
                if close < bOb
                    dropIt := true

        if dropIt
            array.remove(obTopA, i)
            array.remove(obBtmA, i)
            array.remove(obLocA, i)
            array.remove(obDirA, i)
            array.remove(obBrkA, i)
            array.remove(obBrkLocA, i)
            array.remove(obFvgA, i)
            array.remove(obIdmA, i)

// État courant pour le dashboard : le prix est-il dans un OB / Breaker ?
int    obZoneDir = 0
string obZoneTxt = "-"

if array.size(obTopA) > 0
    for i = 0 to array.size(obTopA) - 1
        if obZoneDir == 0
            float tOb = array.get(obTopA, i)
            float bOb = array.get(obBtmA, i)
            if close <= tOb and close >= bOb
                bool kOb = array.get(obBrkA, i)
                int  dOb = array.get(obDirA, i)
                // Un Breaker a changé de polarité : sens inversé.
                obZoneDir := kOb ? -dOb : dOb
                obZoneTxt := (kOb ? (dOb == 1 ? "Dans BREAKER (ex-OB haussier)" : "Dans BREAKER (ex-OB baissier)")
                     : (dOb == 1 ? "Dans OB haussier" : "Dans OB baissier")) +
                     (array.get(obIdmA, i) ? " ★IDM" : "") +
                     (array.get(obFvgA, i) ? " ⚡" : "")

// AFFICHAGE — uniquement sur la dernière bougie, et on ne supprime QUE
// nos propres objets (jamais box.all / line.all : ça détruirait les
// Sniper Zones, les phases et les zones Supply/Demand).
if barstate.islast
    while array.size(obDrawBox) > 0
        box.delete(array.pop(obDrawBox))
    while array.size(obDrawLn) > 0
        line.delete(array.pop(obDrawLn))
    while array.size(obDrawLbl) > 0
        label.delete(array.pop(obDrawLbl))

    if showOB and array.size(obTopA) > 0
        int drawnBull = 0
        int drawnBear = 0

        for i = 0 to array.size(obTopA) - 1
            int   dOb = array.get(obDirA, i)
            bool  kOb = array.get(obBrkA, i)
            float tOb = array.get(obTopA, i)
            float bOb = array.get(obBtmA, i)
            int   lOb = array.get(obLocA, i)

            bool quotaOk = dOb == 1 ? drawnBull < obShowBull : drawnBear < obShowBear
            // Filtre 80/20 : ne s'applique jamais aux Breakers, qui ont
            // justement changé de polarité.
            bool dirOk = not obFilter8020 or kOb or confirmedTrend == 0 or confirmedTrend == dOb
            bool brkOk = obShowBreaker or not kOb

            if quotaOk and dirOk and brkOk
                if dOb == 1
                    drawnBull += 1
                else
                    drawnBear += 1

                color baseCol = dOb == 1 ? obBullCol : obBearCol
                color brkCol  = dOb == 1 ? obBullBreakCol : obBearBreakCol
                color solid   = color.rgb(color.r(baseCol), color.g(baseCol), color.b(baseCol))
                color brkSol  = color.rgb(color.r(brkCol), color.g(brkCol), color.b(brkCol))

                string tag = (kOb ? "BRK " : "OB ") + (dOb == 1 ? "⬆" : "⬇") +
                     (array.get(obIdmA, i) ? " ★" : "") +
                     (array.get(obFvgA, i) ? " ⚡" : "")

                // Bord droit = le prix actuel (+ marge de lisibilité).
                // JAMAIS extend.right : la zone suit le prix, elle ne
                // part pas à l'infini vers la droite.
                int rightEdge = bar_index + zoneExt

                if kOb
                    int bLoc = array.get(obBrkLocA, i)
                    // Partie encore valide (avant la cassure)
                    array.push(obDrawBox, box.new(lOb, tOb, bLoc, bOb,
                         border_color=solid, bgcolor=baseCol))
                    // Partie Breaker (polarité inversée), suit le prix
                    array.push(obDrawBox, box.new(bLoc, tOb, rightEdge, bOb,
                         border_color=na, bgcolor=brkCol))
                    array.push(obDrawLn, line.new(bLoc, tOb, rightEdge, tOb,
                         xloc=xloc.bar_index, color=brkSol, style=line.style_dashed))
                    array.push(obDrawLn, line.new(bLoc, bOb, rightEdge, bOb,
                         xloc=xloc.bar_index, color=brkSol, style=line.style_dashed))
                    array.push(obDrawLbl, label.new(rightEdge, (tOb + bOb) / 2, tag,
                         style=label.style_label_left, color=brkCol, textcolor=brkSol, size=size.tiny))
                else
                    array.push(obDrawBox, box.new(lOb, tOb, rightEdge, bOb,
                         border_color=na, bgcolor=baseCol))
                    array.push(obDrawLn, line.new(lOb, tOb, rightEdge, tOb,
                         xloc=xloc.bar_index, color=solid))
                    array.push(obDrawLn, line.new(lOb, bOb, rightEdge, bOb,
                         xloc=xloc.bar_index, color=solid))
                    array.push(obDrawLbl, label.new(rightEdge, (tOb + bOb) / 2, tag,
                         style=label.style_label_left, color=baseCol, textcolor=solid, size=size.tiny))



//=====================================================================
// ZONES SUPPLY / DEMAND (module 9) — la version LARGE.
//
// Contrairement à l'OB (module 8), aucune cassure de structure n'est
// exigée : une base de consolidation suivie d'une impulsion forte
// suffit. La zone englobe TOUTE la base (plusieurs bougies), là où l'OB
// ne retient que la dernière bougie opposée.
//
// La base est construite au fil de l'eau (variables var) — comme pour
// l'OB, aucune relecture d'historique à index variable.
//=====================================================================
var box[]   sdBox = array.new_box()
var label[] sdLbl = array.new_label()
var float[] sdTop = array.new_float()
var float[] sdBot = array.new_float()
var int[]   sdDir = array.new_int()
var bool[]  sdMit = array.new_bool()

var float sdBaseTop   = na
var float sdBaseBot   = na
var int   sdBaseCount = 0
var int   sdBaseStart = na

float sdBody      = math.abs(close - open)
bool  atrReady    = not na(atrFast) and atrFast > 0
bool  sdIsImpulse = showSD and atrReady and sdBody > atrFast * sdImpulseMult
bool  sdIsSmall   = atrReady and sdBody < atrFast * 0.8
int   sdDirNow    = close > open ? 1 : -1

if sdIsImpulse
    // La base accumulée juste avant devient la zone Supply/Demand.
    if sdBaseCount > 0 and not na(sdBaseTop) and not na(sdBaseBot) and not na(sdBaseStart)
        color  sdCol = sdDirNow == 1 ? sdDemandCol : sdSupplyCol
        string sdTxt = sdDirNow == 1 ? "DEMAND" : "SUPPLY"

        box   sb = box.new(sdBaseStart, sdBaseTop, bar_index + zoneExt, sdBaseBot,
             border_color=sdCol, border_width=1,
             bgcolor=color.new(sdCol, 88))
        label sl = label.new(sdBaseStart, sdDirNow == 1 ? sdBaseBot : sdBaseTop, sdTxt,
             style=sdDirNow == 1 ? label.style_label_up : label.style_label_down,
             color=color.new(sdCol, 82), textcolor=sdCol, size=size.tiny)

        array.push(sdBox, sb)
        array.push(sdLbl, sl)
        array.push(sdTop, sdBaseTop)
        array.push(sdBot, sdBaseBot)
        array.push(sdDir, sdDirNow)
        array.push(sdMit, false)

    sdBaseTop := na
    sdBaseBot := na
    sdBaseCount := 0
    sdBaseStart := na
else if sdIsSmall
    if sdBaseCount >= sdMaxBase
        // Base trop longue : on repart d'une base neuve sur cette bougie.
        sdBaseTop := high
        sdBaseBot := low
        sdBaseCount := 1
        sdBaseStart := bar_index
    else
        sdBaseTop := na(sdBaseTop) ? high : math.max(sdBaseTop, high)
        sdBaseBot := na(sdBaseBot) ? low  : math.min(sdBaseBot, low)
        sdBaseCount := sdBaseCount + 1
        sdBaseStart := na(sdBaseStart) ? bar_index : sdBaseStart
else
    // Bougie moyenne : ni base ni impulsion, on repart de zéro.
    sdBaseTop := na
    sdBaseBot := na
    sdBaseCount := 0
    sdBaseStart := na

// Purge : garde au plus sdCount zones par côté (Demand et Supply
// comptées séparément), les plus récentes.
if array.size(sdBox) > 0
    int keepDemand = 0
    int keepSupply = 0
    for i = array.size(sdBox) - 1 to 0
        bool keepIt = true
        if array.get(sdDir, i) == 1
            keepDemand := keepDemand + 1
            keepIt := keepDemand <= sdCount
        else
            keepSupply := keepSupply + 1
            keepIt := keepSupply <= sdCount
        if not keepIt
            box.delete(array.get(sdBox, i))
            label.delete(array.get(sdLbl, i))
            array.remove(sdBox, i)
            array.remove(sdLbl, i)
            array.remove(sdTop, i)
            array.remove(sdBot, i)
            array.remove(sdDir, i)
            array.remove(sdMit, i)

// Prolongation + mitigation des zones Supply/Demand.
bool sdTouched = false

if array.size(sdBox) > 0
    for i = 0 to array.size(sdBox) - 1
        box bx = array.get(sdBox, i)
        box.set_right(bx, bar_index + zoneExt)
        if not array.get(sdMit, i)
            if low <= array.get(sdTop, i) and high >= array.get(sdBot, i)
                array.set(sdMit, i, true)
                sdTouched := true
                box.set_border_color(bx, sdMitigatedCol)
                box.set_bgcolor(bx, color.new(sdMitigatedCol, 92))
                label lbD = array.get(sdLbl, i)
                label.set_color(lbD, color.new(sdMitigatedCol, 85))
                label.set_textcolor(lbD, sdMitigatedCol)


//=====================================================================
// IMBALANCES / FAIR VALUE GAP (module 10)
//
// Vide de prix sur 3 bougies : le marché est monté (ou descendu) trop
// vite pour qu'un échange équitable ait lieu sur cette plage.
//   Haussière : le bas de la bougie actuelle est AU-DESSUS du haut de
//               la bougie d'il y a 2 périodes -> zone [high[2], low].
//   Baissière : le haut de la bougie actuelle est SOUS le bas de la
//               bougie d'il y a 2 périodes -> zone [high, low[2]].
//
// Indices d'historique CONSTANTS ([2]) uniquement — aucun risque de
// buffer. Comme toutes les zones : le bord droit suit le prix, jamais
// d'extension infinie. La zone se réduit à mesure qu'elle est comblée
// et disparaît une fois entièrement remplie.
//=====================================================================
var box[]   fvgBox = array.new_box()
var float[] fvgTop = array.new_float()
var float[] fvgBot = array.new_float()
var int[]   fvgDir = array.new_int()

bool fvgUpNew   = showFvg and bar_index >= 2 and low > high[2]
bool fvgDownNew = showFvg and bar_index >= 2 and high < low[2]
float fvgMinPx  = atrReady ? atrFast * fvgMinSize : 0.0

if fvgUpNew and (low - high[2]) >= fvgMinPx
    array.push(fvgBox, box.new(bar_index - 2, low, bar_index + zoneExt, high[2],
         border_color=na, bgcolor=fvgBullCol))
    array.push(fvgTop, low)
    array.push(fvgBot, high[2])
    array.push(fvgDir, 1)

if fvgDownNew and (low[2] - high) >= fvgMinPx
    array.push(fvgBox, box.new(bar_index - 2, low[2], bar_index + zoneExt, high,
         border_color=na, bgcolor=fvgBearCol))
    array.push(fvgTop, low[2])
    array.push(fvgBot, high)
    array.push(fvgDir, -1)

// Comblement : la zone rétrécit, puis disparaît quand elle est remplie.
bool fvgFilledNow = false

if array.size(fvgBox) > 0
    for i = array.size(fvgBox) - 1 to 0
        float fT = array.get(fvgTop, i)
        float fB = array.get(fvgBot, i)
        int   fD = array.get(fvgDir, i)
        bool  gone = false

        if fD == 1
            // Comblée par le bas : le prix remonte dans le vide.
            if low <= fB
                gone := true
            else if fvgShrink and low < fT
                fT := low
                array.set(fvgTop, i, fT)
                fvgFilledNow := true
        else
            if high >= fT
                gone := true
            else if fvgShrink and high > fB
                fB := high
                array.set(fvgBot, i, fB)
                fvgFilledNow := true

        if gone
            box.delete(array.get(fvgBox, i))
            array.remove(fvgBox, i)
            array.remove(fvgTop, i)
            array.remove(fvgBot, i)
            array.remove(fvgDir, i)
        else
            box bxF = array.get(fvgBox, i)
            box.set_top(bxF, fT)
            box.set_bottom(bxF, fB)
            box.set_right(bxF, bar_index + zoneExt)

// Purge : au plus fvgCount imbalances par côté, les plus récentes.
if array.size(fvgBox) > 0
    int keepUp = 0
    int keepDn = 0
    for i = array.size(fvgBox) - 1 to 0
        bool keepF = true
        if array.get(fvgDir, i) == 1
            keepUp := keepUp + 1
            keepF := keepUp <= fvgCount
        else
            keepDn := keepDn + 1
            keepF := keepDn <= fvgCount
        if not keepF
            box.delete(array.get(fvgBox, i))
            array.remove(fvgBox, i)
            array.remove(fvgTop, i)
            array.remove(fvgBot, i)
            array.remove(fvgDir, i)

// Le prix est-il dans une imbalance en ce moment ?
int fvgZoneDir = 0
if array.size(fvgBox) > 0
    for i = array.size(fvgBox) - 1 to 0
        if fvgZoneDir == 0 and close <= array.get(fvgTop, i) and close >= array.get(fvgBot, i)
            fvgZoneDir := array.get(fvgDir, i)


// État courant : le prix est-il DANS un OB / Breaker, une zone S/D ou
// une imbalance ? Sert au dashboard pour la confirmation d'entrée.
// Priorité : Order Block (niveau chirurgical) > Supply/Demand (zone
// large) > imbalance (vide de prix à combler).
int    zoneNowDir = obZoneDir
string zoneNowTxt = obZoneTxt

if zoneNowDir == 0 and array.size(sdBox) > 0
    for i = array.size(sdBox) - 1 to 0
        if zoneNowDir == 0 and close <= array.get(sdTop, i) and close >= array.get(sdBot, i)
            zoneNowDir := array.get(sdDir, i)
            zoneNowTxt := (array.get(sdDir, i) == 1 ? "Dans zone DEMAND" : "Dans zone SUPPLY") + (array.get(sdMit, i) ? " (mitigée)" : "")

if zoneNowDir == 0 and fvgZoneDir != 0
    zoneNowDir := fvgZoneDir
    zoneNowTxt := fvgZoneDir == 1 ? "Dans imbalance haussière" : "Dans imbalance baissière"

// Une imbalance QUI COÏNCIDE avec un OB est la meilleure configuration
// SMC : on le signale explicitement.
if obZoneDir != 0 and fvgZoneDir != 0
    zoneNowTxt := obZoneTxt + " + imbalance"


//=====================================================================
// IDM 3 — CONFLUENCE H1 + M15 + M5 (module 11)
//
// Le niveau est ANCRÉ sur le H1 (le timeframe de décision) : c'est lui
// qui donne le prix de référence. Le M15 et le M5 servent de
// CONFIRMATION — s'ils voient un point de ravitaillement au même
// endroit, le niveau est bien plus solide.
//
// Sens : dicté par h1Bias, exactement comme la case "Acheteur/Vendeur
// maintenant" du dashboard.
//   H1 haussier -> on attend le prix EN DESSOUS, sur un creux.
//   H1 baissier -> on attend le prix AU-DESSUS, sur un sommet.
//
// La confluence affichée (3/3, 2/3, 1/3) est un DÉCOMPTE VÉRIFIABLE du
// nombre de timeframes d'accord, pas une probabilité inventée.
//=====================================================================
var float projLvl   = na
var int   projDirV  = 0
var int   projAgree = 0
var line  projLine  = na
var label projLbl   = na
var box   projBox   = na

// Niveau vu par chaque timeframe, dans le sens du H1.
float lvH1  = h1Bias == 1 ? h1Lo  : h1Bias == -1 ? h1Hi  : na
float lvM15 = h1Bias == 1 ? m15Lo : h1Bias == -1 ? m15Hi : na
float lvM5  = h1Bias == 1 ? m5Lo  : h1Bias == -1 ? m5Hi  : na

float projTol = atrReady ? atrFast * projTolAtr : na

int   agreeCnt = 0
float agreeSum = 0.0

if not na(lvH1) and not na(projTol)
    // Le H1 est l'ancre : il compte toujours pour 1.
    agreeCnt := 1
    agreeSum := lvH1
    if not na(lvM15) and math.abs(lvM15 - lvH1) <= projTol
        agreeCnt := agreeCnt + 1
        agreeSum := agreeSum + lvM15
    if not na(lvM5) and math.abs(lvM5 - lvH1) <= projTol
        agreeCnt := agreeCnt + 1
        agreeSum := agreeSum + lvM5

// Le niveau retenu est la moyenne des timeframes d'accord : il se cale
// naturellement là où les lectures se rejoignent.
float projCand = agreeCnt > 0 ? agreeSum / agreeCnt : na

if showProjIdm and not na(projCand) and agreeCnt >= projMinTf and h1Bias != 0
    projLvl   := projCand
    projDirV  := h1Bias
    projAgree := agreeCnt

// Disparition : le prix l'a touché (il a fait son travail), ou la
// structure H1 s'est inversée (la thèse est morte), ou le H1 ne donne
// plus de niveau exploitable.
bool projHit = not na(projLvl) and
     (projDirV == 1 ? low <= projLvl : projDirV == -1 ? high >= projLvl : false)
bool projFlip = not na(projLvl) and projDirV != 0 and h1Bias != 0 and h1Bias != projDirV

if projHit or projFlip or na(lvH1)
    projLvl   := na
    projDirV  := 0
    projAgree := 0

// Affichage — tirets, pour bien marquer que c'est un niveau H1
// multi-timeframe et non un pivot du graphique courant. Comme toutes tes
// zones, il s'arrête au prix (bar_index + zoneExt), jamais extend.right.
if not na(projLine)
    line.delete(projLine)
    projLine := na
if not na(projLbl)
    label.delete(projLbl)
    projLbl := na
if not na(projBox)
    box.delete(projBox)
    projBox := na

if showProjIdm and not na(projLvl) and barstate.islast
    float projPad = atrReady ? atrFast * 0.12 : 0.0
    if projShowZone and projPad > 0
        projBox := box.new(bar_index - 3, projLvl + projPad, bar_index + zoneExt, projLvl - projPad,
             border_color=color.new(projIdmCol, 40), border_width=1,
             bgcolor=color.new(projIdmCol, 85))
    projLine := line.new(bar_index - 3, projLvl, bar_index + zoneExt, projLvl,
         color=projIdmCol, style=line.style_dashed, width=2)
    string projTxt = (projDirV == 1 ? "▲" : "▼") + " IDM 3 (H1) " +
         str.tostring(projLvl, format.mintick) + "  confluence " + str.tostring(projAgree) + "/3"
    projLbl := label.new(bar_index + zoneExt, projLvl, projTxt,
         style=label.style_label_left,
         color=color.new(projIdmCol, 40),
         textcolor=color.white,
         size=size.small)


//=====================================================================
// IDM 4 — TOUJOURS entre l'IDM 1 et l'IDM 2 (module 12)
//
// Par construction : on identifie d'abord les deux IDM actifs les plus
// récents (exactement ceux du dashboard), puis on cherche le meilleur
// niveau À L'INTÉRIEUR du couloir qu'ils délimitent.
//   1. Order Block non cassé situé dans le couloir
//   2. sinon imbalance non comblée dans le couloir
//   3. sinon le milieu exact du couloir
// Le repli garantit qu'il existe TOUJOURS dès que les deux IDM existent,
// et qu'il est toujours entre l'IDM 1 et l'IDM 2.
//=====================================================================
var float  idm4Lvl  = na
var int    idm4DirV = 0
var string idm4Base = ""
var line   idm4Line = na
var label  idm4Lbl  = na
var box    idm4Box  = na

// Les deux IDM actifs les plus récents, cohérents avec la structure.
int i4A = -1
int i4B = -1
if array.size(idmLevel) > 0
    for i = array.size(idmLevel) - 1 to 0
        if not array.get(idmDone, i) and (confirmedTrend == 0 or array.get(idmDir, i) == confirmedTrend)
            if i4A == -1
                i4A := i
            else if i4B == -1
                i4B := i

if showIdm4 and i4A != -1 and i4B != -1
    float lvA = array.get(idmLevel, i4A)
    float lvB = array.get(idmLevel, i4B)
    float corridorLo = math.min(lvA, lvB)
    float corridorHi = math.max(lvA, lvB)
    int   dir4 = array.get(idmDir, i4A)

    // 1) Order Block non cassé dans le couloir — le plus proche du prix,
    // c'est celui que le prix rencontrera en premier.
    float bestOb  = na
    float bestObD = na
    if array.size(obTopA) > 0
        for i = 0 to array.size(obTopA) - 1
            if not array.get(obBrkA, i) and array.get(obDirA, i) == dir4
                float midOb = (array.get(obTopA, i) + array.get(obBtmA, i)) / 2.0
                if midOb > corridorLo and midOb < corridorHi
                    float dOb4 = math.abs(close - midOb)
                    if na(bestObD) or dOb4 < bestObD
                        bestObD := dOb4
                        bestOb  := midOb

    // 2) Imbalance non comblée dans le couloir.
    float bestFv  = na
    float bestFvD = na
    if na(bestOb) and array.size(fvgTop) > 0
        for i = 0 to array.size(fvgTop) - 1
            if array.get(fvgDir, i) == dir4
                float midFv = (array.get(fvgTop, i) + array.get(fvgBot, i)) / 2.0
                if midFv > corridorLo and midFv < corridorHi
                    float dFv4 = math.abs(close - midFv)
                    if na(bestFvD) or dFv4 < bestFvD
                        bestFvD := dFv4
                        bestFv  := midFv

    // 3) Repli : le milieu exact du couloir.
    idm4Lvl  := not na(bestOb) ? bestOb : not na(bestFv) ? bestFv : (corridorLo + corridorHi) / 2.0
    idm4Base := not na(bestOb) ? "Order Block" : not na(bestFv) ? "imbalance" : "milieu IDM1-IDM2"
    idm4DirV := dir4

// Disparition : le prix l'a touché, la structure s'inverse, ou l'un des
// deux IDM du couloir n'existe plus.
bool idm4Hit = not na(idm4Lvl) and
     (idm4DirV == 1 ? low <= idm4Lvl : idm4DirV == -1 ? high >= idm4Lvl : false)
bool idm4Flip = not na(idm4Lvl) and idm4DirV != 0 and confirmedTrend != 0 and confirmedTrend != idm4DirV

if idm4Hit or idm4Flip or i4A == -1 or i4B == -1
    idm4Lvl  := na
    idm4DirV := 0
    idm4Base := ""

// Affichage — pointillés fins, couleur distincte des IDM 1 / 2 / 3.
if not na(idm4Line)
    line.delete(idm4Line)
    idm4Line := na
if not na(idm4Lbl)
    label.delete(idm4Lbl)
    idm4Lbl := na
if not na(idm4Box)
    box.delete(idm4Box)
    idm4Box := na

if showIdm4 and not na(idm4Lvl) and barstate.islast
    float pad4 = atrReady ? atrFast * 0.10 : 0.0
    if idm4ShowZone and pad4 > 0
        idm4Box := box.new(bar_index - 3, idm4Lvl + pad4, bar_index + zoneExt, idm4Lvl - pad4,
             border_color=color.new(idm4Col, 45), border_width=1,
             bgcolor=color.new(idm4Col, 86))
    idm4Line := line.new(bar_index - 3, idm4Lvl, bar_index + zoneExt, idm4Lvl,
         color=idm4Col, style=line.style_dotted, width=2)
    string txt4 = (idm4DirV == 1 ? "▲" : "▼") + " IDM 4 " +
         str.tostring(idm4Lvl, format.mintick) + "  (" + idm4Base + ")"
    idm4Lbl := label.new(bar_index + zoneExt, idm4Lvl, txt4,
         style=label.style_label_left,
         color=color.new(idm4Col, 40),
         textcolor=color.white,
         size=size.small)


//=====================================================================
// DASHBOARD — lit uniquement l'état du moteur, fonctionne même si tous
// les autres modules d'affichage sont désactivés
//=====================================================================
var table dash = table.new(position.top_right, 2, 10,
     border_width=1, frame_width=1, frame_color=color.gray)

if showDash and barstate.islast

    string structTxt =
         bias == 1 ? "BULLISH" :
         bias == -1 ? "BEARISH" :
         "CONSOLIDATION"

    color structColor =
         bias == 1 ? bullCol :
         bias == -1 ? bearCol :
         rangeCol

    // Acheteur/Vendeur maintenant — se fie UNIQUEMENT à la structure H1
    // (h1Bias), jamais au chart courant. H1 haussier -> acheteur, H1
    // baissier -> vendeur, rien d'autre à mélanger.
    string posTxt = h1Bias == 1 ? "ACHETEUR" : h1Bias == -1 ? "VENDEUR" : "NEUTRE"
    color  posCol = h1Bias == 1 ? entryBuyCol : h1Bias == -1 ? entrySellCol : rangeCol

    // IDM en attente — UN SEUL, le plus récent qui respecte la
    // structure actuelle (règle 80/20 : direction == confirmedTrend).
    // Se déplace automatiquement dès qu'un nouveau candidat remplace
    // l'ancien — c'est normal, c'est la logique même de l'IDM.
    int nIdm = array.size(idmLevel)
    int idmWaitIdx  = -1
    int idmWaitIdx2 = -1
    if nIdm > 0
        for i = nIdm - 1 to 0
            if not array.get(idmDone, i) and (confirmedTrend == 0 or array.get(idmDir, i) == confirmedTrend)
                if idmWaitIdx == -1
                    idmWaitIdx := i
                else if idmWaitIdx2 == -1
                    idmWaitIdx2 := i

    string idmWaitTxt = idmWaitIdx == -1 ? "-" :
         (array.get(idmDir, idmWaitIdx) == 1 ? "IDBL " : "IDBR ") + str.tostring(array.get(idmLevel, idmWaitIdx), format.mintick)
    color idmWaitColCell = idmWaitIdx == -1 ? dashValueCol : idmActiveCol

    string idmWaitTxt2 = idmWaitIdx2 == -1 ? "-" :
         (array.get(idmDir, idmWaitIdx2) == 1 ? "IDBL " : "IDBR ") + str.tostring(array.get(idmLevel, idmWaitIdx2), format.mintick)
    color idmWaitColCell2 = idmWaitIdx2 == -1 ? dashValueCol : idmWaitCol

    string targetDashTxt = targetValid ?
         str.tostring(targetLevel, format.mintick) + (na(targetProgressPct) ? "" : " (" + str.tostring(targetProgressPct, "#") + "% parcouru)") :
         "-"
    color targetDashCol = targetValid ? targetCol : rangeCol

    string actionTxt = "-"
    color actionCol = rangeCol

    if entrySignalBuy
        actionTxt := "ENTRER ACHAT MAINTENANT"
        actionCol := entryBuyCol
    else if entrySignalSell
        actionTxt := "ENTRER VENTE MAINTENANT"
        actionCol := entrySellCol
    else if idmWaitIdx != -1
        actionTxt := (array.get(idmDir, idmWaitIdx) == 1 ? "Préparer ACHAT — retest " : "Préparer VENTE — retest ") + str.tostring(array.get(idmLevel, idmWaitIdx), format.mintick)
        actionCol := idmActiveCol
    else if nIdm > 0
        actionTxt := "Attendre le prochain IDM"
        actionCol := rangeCol

    table.cell(dash, 0, 0, "SMV — MOTEUR", text_color=color.white, bgcolor=dashTitleBg, text_size=size.small)
    table.merge_cells(dash, 0, 0, 1, 0)

    table.cell(dash, 0, 1, "Structure", text_color=dashLabelCol, text_size=size.small, bgcolor=dashBgCol)
    table.cell(dash, 1, 1, structTxt, text_color=structColor, text_size=size.small, bgcolor=dashBgCol)

    table.cell(dash, 0, 2, "Acheteur / Vendeur maintenant (H1)", text_color=dashLabelCol, text_size=size.small, bgcolor=dashBgCol)
    table.cell(dash, 1, 2, posTxt, text_color=posCol, text_size=size.small, bgcolor=dashBgCol)

    table.cell(dash, 0, 3, "IDM 1 (le plus récent)", text_color=dashLabelCol, text_size=size.small, bgcolor=dashBgCol)
    table.cell(dash, 1, 3, idmWaitTxt, text_color=idmWaitColCell, text_size=size.small, bgcolor=dashBgCol)

    table.cell(dash, 0, 4, "IDM 2 (le précédent)", text_color=dashLabelCol, text_size=size.small, bgcolor=dashBgCol)
    table.cell(dash, 1, 4, idmWaitTxt2, text_color=idmWaitColCell2, text_size=size.small, bgcolor=dashBgCol)

    // IDM 3 — niveau H1 confirmé par le M15 et le M5.
    string idm3Txt = na(projLvl) ? "-" :
         (projDirV == 1 ? "IDBL " : "IDBR ") + str.tostring(projLvl, format.mintick) +
         "  (" + str.tostring(projAgree) + "/3)"
    color idm3Cell = na(projLvl) ? dashValueCol : projIdmCol
    table.cell(dash, 0, 5, "IDM 3 (H1 + M15 + M5)", text_color=dashLabelCol, text_size=size.small, bgcolor=dashBgCol)
    table.cell(dash, 1, 5, idm3Txt, text_color=idm3Cell, text_size=size.small, bgcolor=dashBgCol)

    // IDM 4 — toujours situé entre l'IDM 1 et l'IDM 2.
    string idm4Txt = na(idm4Lvl) ? "-" :
         (idm4DirV == 1 ? "IDBL " : "IDBR ") + str.tostring(idm4Lvl, format.mintick) +
         "  (" + idm4Base + ")"
    color idm4Cell = na(idm4Lvl) ? dashValueCol : idm4Col
    table.cell(dash, 0, 6, "IDM 4 (entre le 1 et le 2)", text_color=dashLabelCol, text_size=size.small, bgcolor=dashBgCol)
    table.cell(dash, 1, 6, idm4Txt, text_color=idm4Cell, text_size=size.small, bgcolor=dashBgCol)

    table.cell(dash, 0, 7, "Liquidité cible", text_color=dashLabelCol, text_size=size.small, bgcolor=dashBgCol)
    table.cell(dash, 1, 7, targetDashTxt, text_color=targetDashCol, text_size=size.small, bgcolor=dashBgCol)

    // Confirmation par la zone : le prix est-il actuellement DANS un
    // Order Block ou une zone Supply/Demand de ce timeframe ?
    color zoneNowCol = zoneNowDir == 1 ? entryBuyCol : zoneNowDir == -1 ? entrySellCol : dashValueCol
    table.cell(dash, 0, 8, "Zone OB / Supply-Demand", text_color=dashLabelCol, text_size=size.small, bgcolor=dashBgCol)
    table.cell(dash, 1, 8, zoneNowTxt, text_color=zoneNowCol, text_size=size.small, bgcolor=dashBgCol)

    table.cell(dash, 0, 9, "Action", text_color=dashLabelCol, text_size=size.small, bgcolor=dashBgCol)
    table.cell(dash, 1, 9, actionTxt, text_color=actionCol, text_size=size.small, bgcolor=dashBgCol)


//=====================================================================
// PHASES — Accumulation / Réaccumulation, Distribution / Redistribution
// (moteur toujours actif ; le dessin est gated par showPhaseBox /
// showPhaseMarkers, chacune indépendante). Purement informatif — bons
// endroits pour préparer un trade, mais l'IDM et la Sniper Zone restent
// les seules zones d'action de l'indicateur.
//=====================================================================
var string lastPhase = "-"

var bool  accActive = false
var float accSC = na
var int   accSCBar = na
var float accLow = na
var float accTop = na
var int   accSTBBar = na
var float accSTBVal = na
var int   accSpringBar = na
var float accSpringVal = na
var int   accAge = 0
var int   accStartBias = 0

var bool  disActive = false
var float disBC = na
var int   disBCBar = na
var float disHigh = na
var float disBottom = na
var int   disUTBar = na
var float disUTVal = na
var int   disUTADBar = na
var float disUTADVal = na
var int   disAge = 0
var int   disStartBias = 0

bool phaseAccConfirmed = false
bool phaseDisConfirmed = false

if accActive
    accAge += 1
    accTop := math.max(accTop, high)
    if low < accLow
        if na(accSTBBar)
            accSTBBar := bar_index
            accSTBVal := low
            if showPhaseMarkers
                label.new(accSTBBar, accSTBVal, "STB", style=label.style_label_up, color=color.new(phaseCol, 70), textcolor=phaseCol, size=size.small)
        else
            accSpringBar := bar_index
            accSpringVal := low
            if showPhaseMarkers
                label.new(accSpringBar, accSpringVal, "SPRING", style=label.style_label_up, color=color.new(phaseCol, 55), textcolor=phaseCol, size=size.small)
        accLow := low
    if newMoveDown
        accActive := false
    if accAge > 500
        accActive := false

if disActive
    disAge += 1
    disBottom := math.min(disBottom, low)
    if high > disHigh
        if na(disUTBar)
            disUTBar := bar_index
            disUTVal := high
            if showPhaseMarkers
                label.new(disUTBar, disUTVal, "UT", style=label.style_label_down, color=color.new(phaseCol, 70), textcolor=phaseCol, size=size.small)
        else
            disUTADBar := bar_index
            disUTADVal := high
            if showPhaseMarkers
                label.new(disUTADBar, disUTADVal, "UTAD", style=label.style_label_down, color=color.new(phaseCol, 55), textcolor=phaseCol, size=size.small)
        disHigh := high
    if newMoveUp
        disActive := false
    if disAge > 500
        disActive := false

if accActive and newMoveUp and not na(accSCBar)
    float topA = math.max(accTop, high)
    string phTxt = accStartBias == 1 ? "RÉACCUMULATION" : "ACCUMULATION"
    lastPhase := phTxt
    accActive := false
    phaseAccConfirmed := true
    if showPhaseBox
        box.new(accSCBar, topA, bar_index, accLow, border_color=color.new(bullCol, 30), bgcolor=color.new(bullCol, 92))
        label.new(accSCBar, topA, phTxt, style=label.style_label_down, color=color.new(bullCol, 55), textcolor=bullCol, size=size.small)

if disActive and newMoveDown and not na(disBCBar)
    float botD = math.min(disBottom, low)
    string phTxt = disStartBias == -1 ? "REDISTRIBUTION" : "DISTRIBUTION"
    lastPhase := phTxt
    disActive := false
    phaseDisConfirmed := true
    if showPhaseBox
        box.new(disBCBar, disHigh, bar_index, botD, border_color=color.new(bearCol, 30), bgcolor=color.new(bearCol, 92))
        label.new(disBCBar, botD, phTxt, style=label.style_label_up, color=color.new(bearCol, 55), textcolor=bearCol, size=size.small)

if not accActive and not na(pl)
    accActive := true
    accSC := pl
    accSCBar := plBar
    accLow := pl
    accTop := na(lastPH) ? high : math.max(lastPH, high)
    accSTBBar := na
    accSTBVal := na
    accSpringBar := na
    accSpringVal := na
    accAge := 0
    accStartBias := bias
    if showPhaseMarkers
        label.new(accSCBar, accSC, "SC", style=label.style_label_up, color=color.new(bullCol, 70), textcolor=bullCol, size=size.small)

if not disActive and not na(ph)
    disActive := true
    disBC := ph
    disBCBar := phBar
    disHigh := ph
    disBottom := na(lastPL) ? low : math.min(lastPL, low)
    disUTBar := na
    disUTVal := na
    disUTADBar := na
    disUTADVal := na
    disAge := 0
    disStartBias := bias
    if showPhaseMarkers
        label.new(disBCBar, disBC, "BC", style=label.style_label_down, color=color.new(bearCol, 70), textcolor=bearCol, size=size.small)

bool stbJustFormed    = accSTBBar == bar_index
bool springJustFormed = accSpringBar == bar_index
bool utJustFormed     = disUTBar == bar_index
bool utadJustFormed   = disUTADBar == bar_index

//=====================================================================
// ALERTES
//=====================================================================
alertcondition(bosBull, "BMS Bullish", "SMV : BMS haussier — continuation")
alertcondition(bosBear, "BMS Bearish", "SMV : BMS baissier — continuation")
alertcondition(chochBull, "BOS Bullish", "SMV : BOS haussier — changement de biais (retournement)")
alertcondition(chochBear, "BOS Bearish", "SMV : BOS baissier — changement de biais (retournement)")
alertcondition(isFS, "IDM déplacé (FS)", "SMV : retracement raté — l'IDM se déplace")
alertcondition(entrySignalBuy, "Entrée ACHAT", "SMV : IDM récupéré — entrée ACHAT")
alertcondition(entrySignalSell, "Entrée VENTE", "SMV : IDM récupéré — entrée VENTE")
alertcondition(signalBlockedByChoch, "IDM repris → BOS", "SMV : IDM repris mais structure cassée en sens opposé — BOS (retournement), pas d'entrée")
alertcondition(phaseAccConfirmed, "Fin d'accumulation", "SMV : accumulation/réaccumulation confirmée (SC/STB/SPRING)")
alertcondition(phaseDisConfirmed, "Fin de distribution", "SMV : distribution/redistribution confirmée (BC/UT/UTAD)")
alertcondition(enteredSniperZone, "Prix dans la Sniper Zone", "SMV : le prix vient d'entrer dans la Sniper Zone active (IDM)")
alertcondition(enteredTargetZone, "Prix proche de la liquidité cible", "SMV : le prix vient d'approcher la cible de liquidité (Intact)")
alertcondition(stbJustFormed, "Phase — STB détecté", "SMV : STB détecté en accumulation")
alertcondition(springJustFormed, "Phase — SPRING détecté", "SMV : SPRING détecté en accumulation")
alertcondition(utJustFormed, "Phase — UT détecté", "SMV : UT détecté en distribution")
alertcondition(utadJustFormed, "Phase — UTAD détecté", "SMV : UTAD détecté en distribution")
alertcondition(obTouchedNow, "OB touché", "SMV : le prix est dans un Order Block encore valide — observe la réaction")
alertcondition(obJustBroke, "OB cassé → Breaker Block", "SMV : un Order Block vient d'être cassé, il devient un Breaker Block (polarité inversée)")
alertcondition(fvgFilledNow, "Imbalance en cours de comblement", "SMV : le prix est en train de combler une imbalance (FVG)")
alertcondition(sdTouched, "Zone Supply/Demand touchée", "SMV : le prix vient d'entrer dans une zone Supply/Demand — observe la réaction")
alertcondition(projHit, "IDM 3 (H1) atteint", "SMV : le prix vient d'atteindre l'IDM 3 — niveau H1 confirmé par le M15 et le M5")
alertcondition(idm4Hit, "IDM 4 atteint", "SMV : le prix vient d'atteindre l'IDM 4, situé entre l'IDM 1 et l'IDM 2")
