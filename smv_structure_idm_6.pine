tpCol = input.color(#00e39a, "Couleur des objectifs", group=gTP)
slCol = input.color(#ff3b6b, "Couleur du stop", group=gTP)
fadeClosedTr = input.bool(true, "Estomper les trades terminés", group=gTP,
