showPd         = input.bool(false, "Afficher le niveau 0.5 (équilibre)", group=gPd)
showPdLabels   = input.bool(true, "Afficher les étiquettes PREMIUM / DISCOUNT + zone actuelle", group=gPd)
pdExtend       = input.int(20, "Extension des zones (bougies)", minval=1, maxval=200, group=gPd)
pdTransparency = input.int(88, "Transparence des zones", minval=0, maxval=100, group=gPd)
